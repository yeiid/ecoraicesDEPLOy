// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale your database?
// Try Prisma Pulse: https://pris.ly/pulse

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public"]
}

// Enums para roles y estados
enum UserRole {
  COLLECTOR
  COMMUNITY
  @@schema("public")
}

enum MemberRole {
  ADMIN
  MODERATOR
  MEMBER
  @@schema("public")
}

enum ObservationStatus {
  PENDING
  APPROVED
  REJECTED
  @@schema("public")
}

// Modelo de Usuario
model User {
  id               String            @id @default(cuid())
  username         String            @unique
  email            String            @unique
  passwordHash     String
  name             String?
  avatarUrl        String?
  bio              String?
  role             UserRole          @default(COLLECTOR)
  isAdmin          Boolean           @default(false)
  provider         String            @default("local") // local | google | facebook
  providerId       String?           @unique
  resetTokenHash   String?           // Token de reseteo de contraseña (hasheado)
  resetTokenExpiresAt DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  observations     Observation[]
  comments         Comment[]
  communityMembers CommunityMember[]
  ownedCommunities Community[]       @relation("CommunityOwner")
  verifiedObservations Observation[] @relation("VerifiedObservations")
  @@schema("public")
}

enum Role {
  ADMIN
  MODERATOR
  USER
  @@schema("public")
}

// Modelo de Especie Nativa
model Species {
  id                 String         @id @default(cuid())
  name               String
  scientificName     String         @unique
  description        String?
  habitat            String?
  imageUrl           String?
  status             String?        // Estado de conservación (ej: "En peligro", "Vulnerable")
  categoryId         String
  category           Category       @relation(fields: [categoryId], references: [id])
  // Datos enriquecidos desde APIs externas (GBIF/iNaturalist)
  gbifKey            Int?           // usageKey / nubKey de GBIF
  inaturalistTaxonId Int?           // id del taxón en iNaturalist
  family             String?        // Familia botánica (ej: "Malvaceae")
  synonyms           Json?          // Nombres científicos alternativos (array de strings)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  observations       Observation[]
  photos             SpeciesPhoto[]

  @@index([categoryId])
  @@schema("public")
}

// Foto de una especie con datos de licencia y atribución (requisito CC)
model SpeciesPhoto {
  id            String   @id @default(cuid())
  speciesId     String
  species       Species  @relation(fields: [speciesId], references: [id])
  url           String
  thumbnailUrl  String?
  license       String?  // cc0 | cc-by | cc-by-sa | cc-by-nc ...
  attribution   String?  // Autor + crédito
  source        String   @default("INATURALIST") // INATURALIST | GBIF | WIKIMEDIA
  rank          Int      @default(0) // Orden de visualización (0 = principal)
  createdAt     DateTime @default(now())

  @@index([speciesId])
  @@schema("public")
}

// Estado de conservación según UICN
enum ConservationStatus {
  EXTINCT              // Extinto (EX)
  EXTINCT_IN_WILD      // Extinto en estado silvestre (EW)
  CRITICALLY_ENDANGERED // En peligro crítico (CR)
  ENDANGERED           // En peligro (EN)
  VULNERABLE           // Vulnerable (VU)
  NEAR_THREATENED      // Casi amenazado (NT)
  LEAST_CONCERN        // Preocupación menor (LC)
  DATA_DEFICIENT       // Datos insuficientes (DD)
  NOT_EVALUATED        // No evaluado (NE)
  @@schema("public")
}

// Modelo de Categoría (tipo de planta)
model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  species     Species[]
  @@schema("public")
}

// Modelo de Comunidad
model Community {
  id          String            @id @default(cuid())
  name        String
  description String?
  location    String?
  latitude    Float?
  longitude   Float?
  imageUrl    String?
  ownerId     String
  owner       User              @relation("CommunityOwner", fields: [ownerId], references: [id])
  members     CommunityMember[]
  observations Observation[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  @@schema("public")
}

// Modelo de Miembro de Comunidad
model CommunityMember {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  communityId String
  community   Community @relation(fields: [communityId], references: [id])
  role        MemberRole @default(MEMBER)
  joinedAt    DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, communityId])
  @@schema("public")
}

// Modelo de Observación (avistamiento de especie)
model Observation {
  id              String          @id @default(cuid())
  speciesId       String
  species         Species         @relation(fields: [speciesId], references: [id])
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  communityId     String?
  community       Community?      @relation(fields: [communityId], references: [id])
  observationDate DateTime
  latitude        Float
  longitude       Float
  altitude        Float?
  municipio       String?
  estadoConservacion String?
  notes           String?
  imageUrl        String?
  status          ObservationStatus @default(PENDING)
  verifiedById    String?
  verifiedBy      User?           @relation("VerifiedObservations", fields: [verifiedById], references: [id])
  verifiedAt      DateTime?
  verificationNotes String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  comments        Comment[]

  @@index([speciesId])
  @@index([userId])
  @@index([communityId])
  @@schema("public")
}

model Comment {
  id            String      @id @default(cuid())
  observationId String
  observation   Observation @relation(fields: [observationId], references: [id])
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  content       String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([observationId])
  @@index([userId])
  @@schema("public")
}
