---
import Layout from '../../layouts/Layout.astro'; // Correcto: 2 niveles hacia arriba
---

<Layout title="Categorías - EcoRaices">
  <div class="container">
    <h1>Categorías de Plantas</h1>
    <p>Explora nuestras categorías de plantas y descubre nuevas especies.</p>
    
    <div class="categories-grid">
      <!-- Las categorías se cargarán dinámicamente desde la API -->
      <div class="loading">Cargando categorías...</div>
    </div>
  </div>

  <style>
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }
    
    h1 {
      color: var(--color-primary);
      margin-bottom: 1rem;
    }
    
    .categories-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 1.5rem;
      margin-top: 2rem;
    }
    
    .category-card {
      background: white;
      border-radius: 0.5rem;
      overflow: hidden;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      transition: transform 0.2s;
    }
    
    .category-card:hover {
      transform: translateY(-4px);
    }
    
    .category-image {
      width: 100%;
      height: 180px;
      object-fit: cover;
    }
    
    .category-info {
      padding: 1.25rem;
    }
    
    .category-name {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
      color: var(--color-text);
    }
    
    .category-description {
      color: var(--color-text-light);
      margin-bottom: 1rem;
      font-size: 0.9rem;
    }
    
    .category-link {
      display: inline-block;
      color: var(--color-primary);
      font-weight: 500;
      text-decoration: none;
    }
    
    .loading {
      text-align: center;
      padding: 2rem;
      color: var(--color-text-light);
    }
  </style>

  <script>
    // Cargar categorías desde la API
    document.addEventListener('DOMContentLoaded', async () => {
      try {
        const response = await fetch('/api/categories');
        const categories = await response.json();
        
        const grid = document.querySelector('.categories-grid');
        if (categories.length > 0) {
          grid.innerHTML = categories.map(category => `
            <div class="category-card">
              <img src="${category.imageUrl || '/placeholder-plant.jpg'}" alt="${category.name}" class="category-image">
              <div class="category-info">
                <h3 class="category-name">${category.name}</h3>
                <p class="category-description">${category.description || 'Descripción no disponible'}</p>
                <a href="/categorias/${category.id}" class="category-link">Ver plantas →</a>
              </div>
            </div>
          `).join('');
        } else {
          grid.innerHTML = '<p>No se encontraron categorías.</p>';
        }
      } catch (error) {
        console.error('Error al cargar categorías:', error);
        document.querySelector('.categories-grid').innerHTML = 
          '<p>Error al cargar las categorías. Por favor, inténtalo de nuevo más tarde.</p>';
      }
    });
  </script>
</Layout>
