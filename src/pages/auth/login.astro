---
import Layout from '../../layouts/Layout.astro';
import LoginForm from '../../components/auth/LoginForm.astro';

// Título de la página
const pageTitle = 'Iniciar Sesión - EcoRaices';
---

<Layout title={pageTitle}>
  <div class="auth-container">
    <div class="auth-wrapper">
      <div class="auth-content">
        <div class="auth-logo">
          <a href="/">
            <img src="/images/logo.svg" alt="EcoRaices" width="180" height="40">
          </a>
        </div>
        
        <LoginForm />
        
        <div class="auth-footer">
          <p>¿No tienes una cuenta? <a href="/auth/register">Regístrate</a></p>
        </div>
      </div>
      
      <div class="social-login">
        <p class="divider">O inicia sesión con</p>
        
        <div class="social-buttons">
          <button type="button" class="btn btn-social btn-google">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            Google
          </button>
          
          <button type="button" class="btn btn-social btn-facebook">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
            </svg>
            Facebook
          </button>
        </div>
      </div>
    </div>
  </div>

  <style>
    .auth-container {
      min-height: 100vh;
      display: flex;
      align-items: center;
      background-color: var(--color-gray-50);
      padding: 2rem 1rem;
    }
    
    .auth-wrapper {
      max-width: 1200px;
      margin: 0 auto;
      background: white;
      border-radius: 1rem;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
      overflow: hidden;
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: 80vh;
    }
    
    .auth-content {
      padding: 3rem 2.5rem;
      display: flex;
      flex-direction: column;
    }
    
    .auth-logo {
      margin-bottom: 2.5rem;
      text-align: center;
    }
    
    .social-login {
      padding: 3rem 2.5rem;
    }
    
    .divider {
      text-align: center;
      position: relative;
      margin: 1.5rem 0;
      color: var(--color-text-light);
      font-size: 0.875rem;
    }
    
    .divider::before,
    .divider::after {
      content: "";
      position: absolute;
      top: 50%;
      width: 45%;
      height: 1px;
      background-color: var(--color-gray-200);
    }
    
    .divider::before {
      left: 0;
    }
    
    .divider::after {
      right: 0;
    }
    
    .social-buttons {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
    
    .btn-social {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      background: white;
      border: 1px solid var(--color-gray-300);
      color: var(--color-text);
      font-weight: 500;
    }
    
    .btn-social:hover {
      background-color: var(--color-gray-50);
    }
    
    .btn-google:hover {
      background-color: #f8f9fa;
      border-color: #dadce0;
    }
    
    .btn-facebook {
      background-color: #1877f2;
      color: white;
      border-color: #1877f2;
    }
    
    .btn-facebook:hover {
      background-color: #166fe5;
      border-color: #166fe5;
    }
    
    .auth-footer {
      margin-top: auto;
      text-align: center;
      padding-top: 2rem;
      color: var(--color-gray-500);
      font-size: 0.875rem;
    }
    
    @media (max-width: 1024px) {
      .auth-wrapper {
        grid-template-columns: 1fr;
        max-width: 600px;
      }
      
      .social-login {
        display: none;
      }
    }
    
    @media (max-width: 640px) {
      .auth-content {
        padding: 2rem 1.5rem;
      }
      
      .auth-logo {
        margin-bottom: 2rem;
      }
    }
  </style>
</Layout>
