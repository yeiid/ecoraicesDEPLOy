---
import Layout from '../../layouts/Layout.astro';
const pageTitle = 'Recuperar Contraseña - EcoRaíces';
---

<Layout title={pageTitle}>
  <div class="auth-page">
    <div class="auth-brand">
      <a href="/">
        <img src="/eco.png" alt="EcoRaíces" width="120" height="120">
      </a>
    </div>

    <div class="auth-card">
      <div class="auth-header">
        <h1>Recuperar contraseña</h1>
        <p>Te enviaremos un enlace para restablecerla</p>
      </div>

      <div id="fp-alert" class="alert-box error" style="display: none; margin-bottom: 1rem;"></div>
      <div id="fp-success" class="alert-box success" style="display: none; margin-bottom: 1rem;"></div>

      <form id="forgotForm">
        <div class="form-group">
          <label for="email">Correo electrónico</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="tu@correo.com"
            autocomplete="email"
          >
        </div>

        <button type="submit" id="submit-btn" class="btn btn-primary btn-block">Enviar enlace</button>
      </form>

      <div class="auth-footer">
        <p><a href="/auth/login">← Volver a iniciar sesión</a></p>
      </div>
    </div>
  </div>

  <style>
    .auth-page {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background-color: var(--color-gray-50);
      padding: 3rem 1rem;
    }

    .auth-brand {
      margin-bottom: 1.5rem;
    }

    .auth-card {
      background: white;
      border-radius: 0.75rem;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
      width: 100%;
      max-width: 440px;
      padding: 2.5rem;
    }

    .auth-header {
      text-align: center;
      margin-bottom: 2rem;
    }

    .auth-header h1 {
      color: var(--color-primary);
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
    }

    .auth-header p {
      color: var(--color-gray-600);
      font-size: 0.95rem;
    }

    .form-group {
      margin-bottom: 1.25rem;
    }

    .form-group label {
      display: block;
      margin-bottom: 0.5rem;
      font-weight: 500;
      color: var(--color-gray-700);
    }

    .form-group input {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid var(--color-gray-300);
      border-radius: 0.375rem;
      font-size: 1rem;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .form-group input:focus {
      outline: none;
      border-color: var(--color-primary);
      box-shadow: 0 0 0 3px rgba(27, 94, 32, 0.1);
    }

    .auth-footer {
      margin-top: 1.5rem;
      text-align: center;
      font-size: 0.875rem;
    }

    .auth-footer a {
      color: var(--color-primary);
      text-decoration: none;
      font-weight: 500;
    }

    .auth-footer a:hover {
      text-decoration: underline;
    }
  </style>

  <script>
    document.addEventListener('astro:page-load', () => {
      const form = document.getElementById('forgotForm');
      const alert = document.getElementById('fp-alert');
      const success = document.getElementById('fp-success');
      const btn = document.getElementById('submit-btn');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        alert.style.display = 'none';
        alert.textContent = '';
        success.style.display = 'none';
        success.textContent = '';

        const email = form.elements.email.value.trim();

        btn.disabled = true;
        btn.textContent = 'Enviando...';

        try {
          const response = await fetch('/api/auth/forgot-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email }),
          });

          const data = await response.json();

          if (!response.ok) {
            throw new Error(data.message || 'Error al enviar el enlace.');
          }

          success.textContent = data.message;
          success.style.display = 'block';
          form.reset();
        } catch (err) {
          console.error('Forgot password submit error:', err);
          alert.textContent = err.message;
          alert.style.display = 'block';
        } finally {
          btn.disabled = false;
          btn.textContent = 'Enviar enlace';
        }
      });
    });
  </script>
</Layout>
