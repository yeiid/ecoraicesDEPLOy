---
import Layout from '../../layouts/Layout.astro';
import RegisterForm from '../../components/auth/RegisterForm.astro';

const url = new URL(Astro.request.url);
const oauthError = url.searchParams.get('error');
const pageTitle = 'Crear Cuenta - EcoRaíces';
---

<Layout title={pageTitle}>
  <div class="auth-page">
    <div class="auth-brand">
      <a href="/">
        <img src="/eco.png" alt="EcoRaíces" width="120" height="120">
      </a>
    </div>

    {oauthError && <div class="alert-box error" role="alert">{oauthError}</div>}

    <RegisterForm />

    <p class="legal-note">
      © {new Date().getFullYear()} EcoRaíces. Todos los derechos reservados.
      <a href="/privacidad">Política de Privacidad</a>
    </p>
  </div>

  <style>
    .auth-page {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background-color: var(--color-gray-50);
      padding: 3rem 1rem;
    }

    .auth-brand {
      margin-bottom: 1.5rem;
    }

    .legal-note {
      margin-top: 1.5rem;
      max-width: 500px;
      text-align: center;
      font-size: 0.8rem;
      color: var(--color-gray-500);
    }

    .legal-note a {
      color: var(--color-primary);
      text-decoration: none;
    }

    .legal-note a:hover {
      text-decoration: underline;
    }
  </style>
</Layout>
