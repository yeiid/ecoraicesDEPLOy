---
import Layout from '../../layouts/Layout.astro';
import { prisma } from '../../lib/prisma.js';
import { getSessionUser } from '../../lib/middleware/auth.js';

const user = await getSessionUser({ cookies: Astro.cookies });

const communities = await prisma.community.findMany({
  include: { _count: { select: { members: true } }, owner: { select: { name: true, username: true } } },
  orderBy: { name: 'asc' },
});

const title = 'Comunidades - EcoRaíces';
const fallbackBanner = 'https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=600&q=80';
---

<Layout title={title}>
  <div class="container">
    <div class="header flex-between wrap gap-1">
      <div>
        <h1 class="page-title">Comunidades</h1>
        <p class="text-muted">
          Únete a comunidades de amantes de las plantas y comparte tus conocimientos.
        </p>
      </div>
      {user && (
        <a href="/comunidades/nueva" class="btn btn-accent">
          Crear Comunidad
        </a>
      )}
    </div>

    <div class="communities-grid">
      {communities.length === 0 ? (
        <div class="empty-state card">
          <p class="text-muted">No hay comunidades disponibles todavía.</p>
          {user && <a href="/comunidades/nueva" class="btn btn-accent mt-2">Crear la primera</a>}
        </div>
      ) : (
        communities.map((community) => (
          <a href={`/comunidades/${community.id}`} class="card card-hover community-card" key={community.id}>
            <img
              src={community.imageUrl || fallbackBanner}
              alt={community.name}
              class="community-banner"
              loading="lazy"
            />
            <div class="community-info">
              <h2 class="community-name">{community.name}</h2>
              <div class="community-members">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                  <circle cx="9" cy="7" r="4" />
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                  <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
                <span>
                  {community._count.members} {community._count.members === 1 ? 'miembro' : 'miembros'}
                </span>
              </div>
              <p class="community-description">
                {community.description || 'Únete a esta comunidad para compartir tu pasión por las plantas.'}
              </p>
              <div class="community-footer">
                <span class="community-link">Ver comunidad →</span>
                <span class="community-owner">por {community.owner?.name || community.owner?.username}</span>
              </div>
            </div>
          </a>
        ))
      )}
    </div>
  </div>

  <style>
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 1.5rem 1rem;
    }

    .header { margin-bottom: 2rem; }

    .header .text-muted { margin-top: 0.5rem; }

    .communities-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1.5rem;
    }

    .community-card {
      display: flex;
      flex-direction: column;
      overflow: hidden;
      text-decoration: none;
      color: inherit;
    }

    .community-banner {
      width: 100%;
      height: 130px;
      object-fit: cover;
    }

    .community-info {
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .community-name {
      font-family: var(--font-heading);
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--color-text-main);
      margin-bottom: 0.5rem;
    }

    .community-members {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--color-text-muted);
      font-size: 0.875rem;
      margin-bottom: 0.75rem;
    }

    .community-description {
      color: var(--color-text-muted);
      font-size: 0.95rem;
      line-height: 1.5;
      margin-bottom: 1rem;
      flex-grow: 1;
    }

    .community-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      border-top: 1px solid var(--color-border);
      padding-top: 0.85rem;
    }

    .community-link {
      color: var(--color-primary);
      font-weight: 600;
      font-size: 0.95rem;
    }

    .community-owner {
      font-size: 0.8rem;
      color: var(--color-text-light);
    }

    .empty-state {
      grid-column: 1 / -1;
      text-align: center;
      padding: 3rem 1rem;
    }
  </style>
</Layout>
