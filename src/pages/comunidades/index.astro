---
import Layout from '../../layouts/Layout.astro'; // Correcto: 2 niveles hacia arriba
---

<Layout title="Comunidades - EcoRaices">
  <div class="container">
    <div class="header">
      <h1>Comunidades</h1>
      <p>Únete a comunidades de amantes de las plantas y comparte tus conocimientos.</p>
      <a href="/comunidades/nueva" class="btn btn-primary">Crear Comunidad</a>
    </div>
    
    <div class="communities-grid">
      <!-- Las comunidades se cargarán dinámicamente desde la API -->
      <div class="loading">Cargando comunidades...</div>
    </div>
  </div>

  <style>
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }
    
    .header {
      margin-bottom: 2rem;
    }
    
    h1 {
      color: var(--color-primary);
      margin-bottom: 0.5rem;
    }
    
    .btn {
      display: inline-block;
      padding: 0.5rem 1rem;
      border-radius: 0.375rem;
      font-weight: 500;
      text-align: center;
      text-decoration: none;
      margin-top: 1rem;
    }
    
    .btn-primary {
      background-color: var(--color-primary);
      color: white;
    }
    
    .communities-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1.5rem;
    }
    
    .community-card {
      background: white;
      border-radius: 0.5rem;
      overflow: hidden;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      transition: transform 0.2s;
    }
    
    .community-card:hover {
      transform: translateY(-4px);
    }
    
    .community-banner {
      width: 100%;
      height: 120px;
      object-fit: cover;
    }
    
    .community-info {
      padding: 1.25rem;
    }
    
    .community-name {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
      color: var(--color-text);
    }
    
    .community-members {
      display: flex;
      align-items: center;
      color: var(--color-text-light);
      font-size: 0.9rem;
      margin-bottom: 1rem;
    }
    
    .community-description {
      color: var(--color-text);
      margin-bottom: 1rem;
      font-size: 0.95rem;
    }
    
    .community-link {
      display: inline-block;
      color: var(--color-primary);
      font-weight: 500;
      text-decoration: none;
    }
    
    .loading {
      text-align: center;
      padding: 2rem;
      color: var(--color-text-light);
      grid-column: 1 / -1;
    }
  </style>

  <script>
    // Cargar comunidades desde la API
    document.addEventListener('DOMContentLoaded', async () => {
      try {
        const response = await fetch('/api/communities');
        const communities = await response.json();
        
        const grid = document.querySelector('.communities-grid');
        if (communities.length > 0) {
          grid.innerHTML = communities.map(community => `
            <div class="community-card">
              <img src="${community.bannerUrl || 'https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=600&q=80'}" 
                   onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1542273917363-3b1817f69a2d?auto=format&fit=crop&w=600&q=80';" 
                   alt="${community.name}" class="community-banner">
              <div class="community-info">
                <h3 class="community-name">${community.name}</h3>
                <div class="community-members">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.5rem;">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                  </svg>
                  ${community.memberCount || 0} miembros
                </div>
                <p class="community-description">${community.description || 'Únete a esta comunidad para compartir tu pasión por las plantas.'}</p>
                <a href="/comunidades/${community.id}" class="community-link">Ver comunidad →</a>
              </div>
            </div>
          `).join('');
        } else {
          grid.innerHTML = `
            <div class="no-communities" style="grid-column: 1 / -1; text-align: center; padding: 2rem;">
              <p>No hay comunidades disponibles. ¡Sé el primero en crear una!</p>
              <a href="/comunidades/nueva" class="btn btn-primary" style="margin-top: 1rem;">Crear Comunidad</a>
            </div>
          `;
        }
      } catch (error) {
        console.error('Error al cargar comunidades:', error);
        document.querySelector('.communities-grid').innerHTML = 
          '<p class="error">Error al cargar las comunidades. Por favor, inténtalo de nuevo más tarde.</p>';
      }
    });
  </script>
</Layout>
