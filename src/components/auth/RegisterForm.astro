---
import AuthForm from './AuthForm.astro';
---

<AuthForm 
  title="Crear Cuenta"
  subtitle="Únete a nuestra comunidad"
  footerText="¿Ya tienes una cuenta?"
  footerLink="/auth/login"
  footerLinkText="Inicia Sesión"
>
  <div id="register-alert" class="alert-box error" style="display: none; margin-bottom: 1rem;"></div>
  <div id="register-success" class="alert-box success" style="display: none; margin-bottom: 1rem;"></div>

  <form class="auth-form" id="registerForm">
    <div class="form-group">
      <label for="fullName">Nombre completo</label>
      <input 
        type="text" 
        id="fullName" 
        name="fullName" 
        required
        placeholder="Tu nombre completo"
        autocomplete="name"
      >
    </div>
    
    <div class="form-group">
      <label for="email">Correo electrónico</label>
      <input 
        type="email" 
        id="email" 
        name="email" 
        required
        placeholder="tu@correo.com"
        autocomplete="email"
      >
    </div>
    
    <div class="form-group">
      <label for="password">Contraseña</label>
      <input 
        type="password" 
        id="password" 
        name="password" 
        required
        minlength="8"
        placeholder="••••••••"
        autocomplete="new-password"
      >
      <small class="form-hint">Mínimo 8 caracteres</small>
    </div>
    
    <div class="form-group">
      <label for="confirmPassword">Confirmar contraseña</label>
      <input 
        type="password" 
        id="confirmPassword" 
        name="confirmPassword" 
        required
        minlength="8"
        placeholder="••••••••"
        autocomplete="new-password"
      >
    </div>
    
    <div class="form-group">
      <label for="userType">Tipo de cuenta</label>
      <select id="userType" name="userType" required>
        <option value="">Selecciona un tipo de cuenta</option>
        <option value="individual">Usuario Individual</option>
        <option value="community">Comunidad</option>
      </select>
    </div>
    
    <!-- Campos adicionales para comunidades -->
    <div id="communityFields" style="display: none;">
      <div class="form-group">
        <label for="communityName">Nombre de la comunidad</label>
        <input 
          type="text" 
          id="communityName" 
          name="communityName" 
          placeholder="Nombre de tu comunidad"
        >
      </div>
      
      <div class="form-group">
        <label for="communityDescription">Descripción de la comunidad</label>
        <textarea 
          id="communityDescription" 
          name="communityDescription" 
          rows="3"
          placeholder="Describe brevemente tu comunidad"
        ></textarea>
      </div>
    </div>
    
    <div class="form-group terms">
      <input type="checkbox" id="terms" name="terms" required>
      <label for="terms">Acepto los <a href="/terminos" target="_blank">Términos de Servicio</a> y la <a href="/privacidad" target="_blank">Política de Privacidad</a></label>
    </div>
    
    <button type="submit" id="submit-btn" class="btn btn-primary">Crear Cuenta</button>
  </form>

  <style>
    .auth-form {
      margin-top: 1.5rem;
    }
    
    .form-group {
      margin-bottom: 1.25rem;
    }
    
    .form-group label {
      display: block;
      margin-bottom: 0.5rem;
      font-weight: 500;
      color: var(--color-gray-700);
    }
    
    .form-group input[type="text"],
    .form-group input[type="email"],
    .form-group input[type="password"],
    .form-group select,
    .form-group textarea {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid var(--color-gray-300);
      border-radius: 0.375rem;
      font-size: 1rem;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    
    .form-group textarea {
      resize: vertical;
      min-height: 100px;
    }
    
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: var(--color-primary);
      box-shadow: 0 0 0 3px rgba(46, 125, 50, 0.1);
    }
    
    .form-hint {
      display: block;
      margin-top: 0.25rem;
      font-size: 0.75rem;
      color: var(--color-gray-500);
    }
    
    .terms {
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
      margin: 1.5rem 0;
    }
    
    .terms input[type="checkbox"] {
      margin-top: 0.25rem;
      width: 1rem;
      height: 1rem;
      border-radius: 0.25rem;
      border: 1px solid var(--color-gray-300);
    }
    
    .terms label {
      font-size: 0.875rem;
      color: var(--color-gray-600);
    }
    
    .terms a {
      color: var(--color-primary);
      text-decoration: none;
    }
    
    .terms a:hover {
      text-decoration: underline;
    }
    
    .btn-primary {
      width: 100%;
      padding: 0.75rem;
      background-color: var(--color-primary);
      color: white;
      border: none;
      border-radius: 0.375rem;
      font-size: 1rem;
      font-weight: 500;
      cursor: pointer;
      transition: background-color 0.2s;
    }
    
    .btn-primary:hover {
      background-color: var(--color-primary-dark);
    }

    /* Alert Boxes */
    .alert-box {
      padding: 0.75rem 1rem;
      border-radius: 0.375rem;
      font-size: 0.9rem;
      font-weight: 500;
    }

    .alert-box.error {
      background-color: #ffebee;
      color: #c62828;
      border: 1px solid #ffcdd2;
    }

    .alert-box.success {
      background-color: #e8f5e9;
      color: #1b5e20;
      border: 1px solid #c8e6c9;
    }
  </style>

  <script>
    document.addEventListener('astro:page-load', () => {
      const userTypeSelect = document.getElementById('userType');
      const communityFields = document.getElementById('communityFields');
      const registerForm = document.getElementById('registerForm');
      const registerAlert = document.getElementById('register-alert');
      const registerSuccess = document.getElementById('register-success');
      const submitBtn = document.getElementById('submit-btn');
      
      if (userTypeSelect && communityFields) {
        userTypeSelect.addEventListener('change', (e) => {
          if (e.target.value === 'community') {
            communityFields.style.display = 'block';
            document.getElementById('communityName').required = true;
          } else {
            communityFields.style.display = 'none';
            document.getElementById('communityName').required = false;
          }
        });
      }

      if (registerForm && registerAlert && registerSuccess && submitBtn) {
        registerForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          
          registerAlert.style.display = 'none';
          registerAlert.textContent = '';
          registerSuccess.style.display = 'none';
          registerSuccess.textContent = '';

          const formData = new FormData(registerForm);
          const fullName = formData.get('fullName');
          const email = formData.get('email');
          const password = formData.get('password');
          const confirmPassword = formData.get('confirmPassword');
          const userType = formData.get('userType');
          const communityName = formData.get('communityName');
          const communityDescription = formData.get('communityDescription');

          // Validar contraseñas coincidentes
          if (password !== confirmPassword) {
            registerAlert.textContent = 'Las contraseñas no coinciden.';
            registerAlert.style.display = 'block';
            return;
          }

          submitBtn.disabled = true;
          submitBtn.textContent = 'Creando cuenta...';

          try {
            const response = await fetch('/api/auth/register', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                fullName,
                email,
                password,
                userType,
                communityName,
                communityDescription
              })
            });

            const data = await response.json();

            if (!response.ok) {
              throw new Error(data.message || 'Error al registrar el usuario.');
            }

            registerSuccess.textContent = '¡Cuenta creada con éxito! Redirigiendo a inicio de sesión...';
            registerSuccess.style.display = 'block';
            registerForm.reset();

            setTimeout(() => {
              window.location.href = '/auth/login';
            }, 2500);
          } catch (err) {
            console.error('Registration submit error:', err);
            registerAlert.textContent = err.message;
            registerAlert.style.display = 'block';
            submitBtn.disabled = false;
            submitBtn.textContent = 'Crear Cuenta';
          }
        });
      }
    });
  </script>
</AuthForm>
