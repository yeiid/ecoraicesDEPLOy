{
  "expo": {
    "name": "EcoRaíces",
    "slug": "ecoraices",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tech.neuraljira.ecoraices",
      "infoPlist": {
        "NSCameraUsageDescription": "EcoRaíces necesita la cámara para fotografiar los árboles y especies en campo.",
        "NSLocationWhenInUseUsageDescription": "EcoRaíces necesita tu ubicación GNSS para georreferenciar los árboles registrados."
      }
    },
    "android": {
      "package": "tech.neuraljira.ecoraices",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0f172a",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0f172a"
        }
      ]
    ]
  }
}
