{
  "expo": {
    "name": "EcoRaíces Campo",
    "slug": "ecoraices-campo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "EcoRaíces necesita la cámara para fotografiar los árboles y especies en campo.",
        "NSLocationWhenInUseUsageDescription": "EcoRaíces necesita tu ubicación GNSS para georreferenciar los árboles registrados."
      }
    },
    "android": {
      "package": "tech.neuraljira.ecoraices.campo",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1a472a",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
