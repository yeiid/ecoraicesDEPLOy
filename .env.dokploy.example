# Variables de entorno para Dokploy (cópialas a la pestaña "Environment" de tu proyecto).
# ⚠️ NUNCA subas este archivo con valores reales a git.

# Dominio público de la app
APP_URL=https://ecoraices.neuraljira.tech

# Firma de tokens (obligatoria, usa un secreto largo aleatorio)
JWT_SECRET=REEMPLAZA_POR_UN_SECRETO_LARGO_ALEATORIO

# API del mapa NeuralJIRA (default: map.neuraljira.tech)
PUBLIC_MAP_API_URL=https://map.neuraljira.tech

# Credenciales de PostgreSQL (usa contraseñas fuertes en producción)
POSTGRES_USER=ecoraices
POSTGRES_PASSWORD=REEMPLAZA_POR_PASSWORD_FUERTE
POSTGRES_DB=ecoraices

# Pl@ntNet (identificación por foto)
PLANTNET_API_KEY=REEMPLAZA_SI_TIENES

# Destinatario del formulario de contacto
CONTACT_EMAIL=yeifran67@gmail.com

# SMTP opcional (para reset de contraseña / correos reales)
# MAIL_HOST=smtp.tuproveedor.com
# MAIL_PORT=587
# MAIL_USER=usuario
# MAIL_PASS=contraseña
# MAIL_FROM=EcoRaíces <no-reply@ecoraices.neuraljira.tech>
# MAIL_SECURE=false

