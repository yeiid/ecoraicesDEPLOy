# Env ejemplo Dokploy — EcoRaíces (NO subas valores reales a git)
# Recurso: ver docs/RENDIMIENTO-RECURSOS.md y services/sync-service/README.md

APP_URL=https://ecoraices.neuraljira.tech
JWT_SECRET=REEMPLAZA_POR_UN_SECRETO_LARGO_ALEATORIO
PUBLIC_MAP_API_URL=https://map.neuraljira.tech

POSTGRES_USER=ecoraices
POSTGRES_PASSWORD=REEMPLAZA_POR_PASSWORD_FUERTE
POSTGRES_DB=ecoraices

PLANTNET_API_KEY=REEMPLAZA_SI_TIENES
CONTACT_EMAIL=yeifran67@gmail.com

# --- Nuevas vars (servicios + anti-caídas) ---
# Dominio del sync-service (CORS)
APP_DOMAIN=ecoraices.neuraljira.tech
# Puertos locales (ignorados en Dokploy, útiles para compose local)
APP_PORT=48080
BACKEND_PORT=48000
SYNC_PORT=48085
# Orígenes CORS del backend (coma, separados)
CORS_ORIGINS=https://ecoraices.neuraljira.tech
# Pool SQLAlchemy (presupuesto: 5+10 por worker ×2 = 30 conn vs max_connections=100)
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
# Timeout del proxy Astro → FastAPI (ms)
PROXY_TIMEOUT_MS=5000
# Concurrencia de subidas del sync-service
MAX_CONCURRENT_UPLOADS=8
# Admin bootstrap (backend)
ADMIN_EMAIL=yeifran67@gmail.com
# ADMIN_PASSWORD=

# SMTP opcional
# MAIL_HOST=smtp.tuproveedor.com
# MAIL_PORT=587
# MAIL_USER=usuario
# MAIL_PASS=contraseña
# MAIL_FROM=EcoRaíces <no-reply@ecoraices.neuraljira.tech>
# MAIL_SECURE=false

# OAuth opcional
