---
/**
 * @file ConfirmDialog.astro
 * @description Diálogo modal accesible para confirmar acciones.
 */

interface Props {
  id: string;
  title: string;
  message: string;
  confirmText?: string;
  cancelText?: string;
  variant?: 'danger' | 'primary';
  showInput?: boolean;
  inputLabel?: string;
  inputPlaceholder?: string;
}

const {
  id,
  title,
  message,
  confirmText = 'Confirmar',
  cancelText = 'Cancelar',
  variant = 'primary',
  showInput = false,
  inputLabel = 'Valor',
  inputPlaceholder = ''
} = Astro.props;

const confirmBtnClass = variant === 'danger' ? 'btn-danger' : 'btn-primary';
const dialogLabelId = `${id}-title`;
const dialogDescId = `${id}-desc`;
const inputId = `${id}-input`;
---

<dialog
  id={id}
  class="confirm-dialog card"
  aria-labelledby={dialogLabelId}
  aria-describedby={dialogDescId}
  aria-modal="true"
>
  <div class="dialog-content flex-col gap-2">
    <h2 id={dialogLabelId} class="section-title">{title}</h2>
    <p id={dialogDescId} class="text-muted">{message}</p>
    
    <form method="dialog" class="dialog-form flex-col gap-2" id={`${id}-form`}>
      {showInput && (
        <div class="form-group">
          <label for={inputId}>{inputLabel}</label>
          <input
            type="text"
            id={inputId}
            name="dialogInput"
            class="input"
            placeholder={inputPlaceholder}
          />
        </div>
      )}
      
      <div class="dialog-actions flex gap-2 mt-2">
        <button type="button" class="btn btn-secondary cancel-btn">{cancelText}</button>
        <button type="submit" class={`btn ${confirmBtnClass} confirm-btn`}>{confirmText}</button>
      </div>
    </form>
  </div>
</dialog>

<script define:vars={{ id }}>
  const dialog = document.getElementById(id);
  const form = document.getElementById(`${id}-form`);
  const cancelBtn = dialog?.querySelector('.cancel-btn');
  const input = dialog?.querySelector('input[name="dialogInput"]');

  if (dialog && form) {
    // Override showModal to automatically trap focus
    const originalShowModal = dialog.showModal;
    dialog.showModal = function() {
      originalShowModal.apply(dialog);
      cancelBtn?.focus(); // Focus trap: auto-focus cancel button
    };

    // Close on Escape key is handled natively, but we need to dispatch the event
    dialog.addEventListener('cancel', () => {
      dialog.dispatchEvent(new CustomEvent('confirm', {
        detail: { confirmed: false }
      }));
    });

    // Cancel button click
    cancelBtn?.addEventListener('click', () => {
      dialog.close('cancel');
      dialog.dispatchEvent(new CustomEvent('confirm', {
        detail: { confirmed: false }
      }));
    });

    // Form submission
    form.addEventListener('submit', (e) => {
      dialog.dispatchEvent(new CustomEvent('confirm', {
        detail: {
          confirmed: true,
          value: input ? input.value : undefined
        }
      }));
    });
  }
</script>

<style>
  .confirm-dialog {
    padding: 1.5rem;
    border: none;
    width: 100%;
    max-width: 450px;
    background-color: var(--color-card);
  }
  
  .confirm-dialog::backdrop {
    background: rgba(15, 23, 42, 0.5);
    backdrop-filter: blur(2px);
  }

  .dialog-content {
    margin: 0;
  }
  
  .dialog-content h2,
  .dialog-content p {
    margin: 0;
  }

  .dialog-actions {
    justify-content: flex-end;
  }
</style>
