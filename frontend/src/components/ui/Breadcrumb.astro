---
/**
 * @file Breadcrumb.astro
 * @description Navegación de migas de pan para accesibilidad y orientación del usuario.
 */

interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="Navegación de migas de pan">
  <ol class="breadcrumb-list">
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="breadcrumb-item">
          {item.href && !isLast ? (
            <a href={item.href} class="breadcrumb-link">{item.label}</a>
          ) : (
            <span class="breadcrumb-current" aria-current="page">{item.label}</span>
          )}
          {!isLast && <span class="crumb-sep" aria-hidden="true">›</span>}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 0;
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .breadcrumb-item {
    display: flex;
    align-items: center;
  }
  .breadcrumb-link {
    color: var(--color-primary);
    text-decoration: none;
  }
  .breadcrumb-link:hover {
    text-decoration: underline;
  }
  .breadcrumb-current {
    font-weight: 600;
    color: var(--color-text-main);
  }
</style>
