---
// frontend/src/components/observations/ObservationsMap.astro
import MapComponent from "./MapComponent.astro";
import { apiGet } from "../../lib/api/client.js";

const { initialFilterCategory = null, showFilters = true } = Astro.props;

let trees = [];
let categories = [];
try {
  const [treesRes, catsRes] = await Promise.all([
    apiGet('/observations').catch((error) => {
      console.error("Error fetching observations:", error);
      return [];
    }),
    apiGet('/categories').catch((error) => {
      console.error("Error fetching categories:", error);
      return [];
    }),
  ]);
  trees = treesRes || [];
  categories = catsRes || [];
} catch (error) {
  console.error("Error fetching map data:", error);
}
---

<div class="observations-map-root" data-initial-category={initialFilterCategory}>
  {showFilters && (
    <div class="minimal-toolbar-card">
      <div class="toolbar-primary-row">
        <!-- Quick Filter Segmented Pills -->
        <div class="segmented-filters" role="group" aria-label="Filtros rápidos de especies">
          <button type="button" class="segment-btn active" data-filter="all">
            <span class="seg-icon">🌐</span>
            <span class="seg-text">Todos</span>
            <span class="seg-badge" id="badge-all-count">{trees.length}</span>
          </button>
          
          <button type="button" class="segment-btn btn-danger-pill" data-filter="invasive" title="Monitoreo de Neem y zonas alelopáticas">
            <span class="seg-icon">🚨</span>
            <span class="seg-text">Invasores (Neem)</span>
          </button>
          
          <button type="button" class="segment-btn btn-success-pill" data-filter="native" title="Flora nativa protectora de La Guajira">
            <span class="seg-icon">🌿</span>
            <span class="seg-text">Nativas</span>
          </button>

          <button type="button" class="segment-btn btn-verified-pill" data-filter="verified" title="Registros confirmados por especialistas">
            <span class="seg-icon">✓</span>
            <span class="seg-text">Verificados</span>
          </button>
        </div>

        <!-- Search & Info Minimal -->
        <div class="toolbar-tools">
          <div class="search-input-wrapper">
            <span class="search-icon">🔍</span>
            <input 
              type="text" 
              id="tree-search-input" 
              class="minimal-search-input" 
              placeholder="Buscar especie o municipio..." 
              aria-label="Buscar árbol"
            />
          </div>

          <div class="visible-counter-badge" id="trees-count-display">
            <span class="pulse-status-dot"></span>
            <span id="counter-text">{trees.length} visibles</span>
          </div>

          <button id="clear-filters-btn" class="btn-reset-filters" style="display: none;" title="Restablecer filtros">
            ✕ Limpiar
          </button>
        </div>
      </div>

      <!-- Category Micro-Chips (Optional) -->
      {categories.length > 0 && (
        <div class="category-micro-scroll" id="category-micro-filters">
          <span class="micro-label">Categorías:</span>
          {categories.map((cat) => (
            <button 
              type="button" 
              class="micro-category-chip" 
              data-category-id={cat.id}
            >
              {cat.name}
            </button>
          ))}
        </div>
      )}
    </div>
  )}

  <!-- Map Frame with Floating Empty Toast -->
  <div class="map-frame-wrapper">
    <!-- Sleek Floating Empty State Toast (Never obstructs the map) -->
    <div id="no-trees-message" class="minimal-empty-toast" style="display: none;">
      <span class="empty-icon">🍃</span>
      <span class="empty-text">No se encontraron árboles con los filtros activos.</span>
      <button type="button" id="toast-reset-btn" class="toast-reset-link">Mostrar todos</button>
    </div>

    <MapComponent
      id="main-observations-map"
      center={[-72.9068, 11.5448]} // La Guajira
      zoom={7}
      markers={trees}
      readOnly={true}
      height="620px"
    />
  </div>
</div>

<style>
  .observations-map-root {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    width: 100%;
  }

  /* Minimalist Toolbar Card in Light Theme */
  .minimal-toolbar-card {
    background: #ffffff;
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 14px;
    padding: 0.75rem 1rem;
    box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    transition: all 0.2s ease;
  }

  .toolbar-primary-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  /* Segmented Filter Pills */
  .segmented-filters {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    background: #f1f5f9;
    padding: 4px;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
  }

  .segment-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 5px 11px;
    font-size: 0.82rem;
    font-weight: 600;
    color: #475569;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    user-select: none;
  }

  .segment-btn:hover {
    color: #0f172a;
    background: rgba(255, 255, 255, 0.6);
  }

  .segment-btn.active {
    background: #ffffff;
    color: #0f172a;
    border-color: #cbd5e1;
    box-shadow: 0 1px 4px rgba(15, 23, 42, 0.06);
  }

  .seg-badge {
    background: #e2e8f0;
    color: #334155;
    font-size: 10px;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 999px;
  }

  .segment-btn.active .seg-badge {
    background: #064e3b;
    color: #ffffff;
  }

  /* Specific Pill Variants */
  .btn-danger-pill.active {
    background: #fee2e2 !important;
    color: #b91c1c !important;
    border-color: #fca5a5 !important;
  }

  .btn-success-pill.active {
    background: #ecfdf5 !important;
    color: #047857 !important;
    border-color: #a7f3d0 !important;
  }

  .btn-verified-pill.active {
    background: #eff6ff !important;
    color: #1d4ed8 !important;
    border-color: #bfdbfe !important;
  }

  /* Tools: Search + Counter */
  .toolbar-tools {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 10px;
    font-size: 12px;
    color: #94a3b8;
    pointer-events: none;
  }

  .minimal-search-input {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 6px 12px 6px 30px;
    font-size: 0.82rem;
    color: #0f172a;
    outline: none;
    transition: all 0.2s ease;
    width: 200px;
  }

  .minimal-search-input:focus {
    background: #ffffff;
    border-color: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.12);
    width: 230px;
  }

  .visible-counter-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #475569;
    background: #f1f5f9;
    padding: 5px 10px;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
  }

  .pulse-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #10b981;
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.6);
  }

  .btn-reset-filters {
    background: #fee2e2;
    color: #dc2626;
    border: 1px solid #fecdd3;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 5px 9px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-reset-filters:hover {
    background: #fca5a5;
    color: #991b1b;
  }

  /* Micro-Category Chips */
  .category-micro-scroll {
    display: flex;
    align-items: center;
    gap: 6px;
    overflow-x: auto;
    padding-top: 4px;
    border-top: 1px solid #f1f5f9;
  }

  .micro-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: #64748b;
    margin-right: 4px;
    white-space: nowrap;
  }

  .micro-category-chip {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    padding: 3px 9px;
    font-size: 0.75rem;
    font-weight: 500;
    color: #475569;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .micro-category-chip:hover {
    background: #e2e8f0;
    color: #0f172a;
  }

  .micro-category-chip.active {
    background: #047857;
    color: #ffffff;
    border-color: #047857;
    font-weight: 600;
  }

  /* Map Frame Wrapper */
  .map-frame-wrapper {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
  }

  /* Minimal Empty Toast (Centered near the bottom, never obscuring the map) */
  .minimal-empty-toast {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(15, 23, 42, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #f8fafc;
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    z-index: 20;
    animation: fadeInToast 0.3s ease;
  }

  .empty-icon {
    font-size: 14px;
  }

  .toast-reset-link {
    background: #10b981;
    color: #ffffff;
    border: none;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s ease;
    margin-left: 4px;
  }

  .toast-reset-link:hover {
    background: #059669;
  }

  @keyframes fadeInToast {
    from {
      opacity: 0;
      transform: translate(-50%, 10px);
    }
    to {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }

  @media (max-width: 768px) {
    .toolbar-primary-row {
      flex-direction: column;
      align-items: stretch;
    }
    .segmented-filters {
      width: 100%;
      justify-content: flex-start;
      overflow-x: auto;
    }
    .toolbar-tools {
      width: 100%;
      justify-content: space-between;
    }
    .minimal-search-input {
      width: 150px;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const mapElement = document.getElementById('main-observations-map');
    if (!mapElement) return;

    let allTrees = [];
    try {
      allTrees = JSON.parse(mapElement.dataset.markers || '[]');
    } catch {
      allTrees = [];
    }

    // UI Controls
    const segmentButtons = document.querySelectorAll('.segment-btn');
    const microCategoryChips = document.querySelectorAll('.micro-category-chip');
    const searchInput = document.getElementById('tree-search-input') as HTMLInputElement | null;
    const counterText = document.getElementById('counter-text');
    const clearBtn = document.getElementById('clear-filters-btn');
    const noTreesMsg = document.getElementById('no-trees-message');
    const toastResetBtn = document.getElementById('toast-reset-btn');

    let currentFilterType = 'all'; // 'all' | 'invasive' | 'native' | 'verified'
    let selectedCategoryId: string | null = null;
    let searchQuery = '';

    function calculateCenter(treesList) {
      if (!treesList || treesList.length === 0) return [-72.9068, 11.5448]; // La Guajira
      
      const lats = treesList.map(t => parseFloat(t.latitude)).filter(n => !isNaN(n));
      const lngs = treesList.map(t => parseFloat(t.longitude)).filter(n => !isNaN(n));
      
      if (lats.length === 0 || lngs.length === 0) return [-72.9068, 11.5448];
      
      const avgLat = lats.reduce((a, b) => a + b, 0) / lats.length;
      const avgLng = lngs.reduce((a, b) => a + b, 0) / lngs.length;
      
      return [avgLng, avgLat];
    }

    function applyFilters() {
      const filteredTrees = allTrees.filter(tree => {
        let pass = true;

        // Categoría botánica
        if (selectedCategoryId) {
          if (!tree.species?.categoryId || tree.species.categoryId !== selectedCategoryId) {
            pass = false;
          }
        }

        // Tipo de filtro
        const rawName = (
          (tree.species?.name || "") + " " +
          (tree.species?.scientificName || "") + " " +
          (tree.species?.commonName || "") + " " +
          (tree.name || "")
        ).toLowerCase();
        const isNeem = rawName.includes("neem") || rawName.includes("nim") || rawName.includes("azadirachta");

        if (currentFilterType === 'invasive' && !isNeem) pass = false;
        if (currentFilterType === 'native' && isNeem) pass = false;
        if (currentFilterType === 'verified' && !tree.isVerified) pass = false;

        // Búsqueda de texto
        if (searchQuery.trim().length > 0) {
          const q = searchQuery.toLowerCase().trim();
          const matches = rawName.includes(q) || (tree.municipio && tree.municipio.toLowerCase().includes(q));
          if (!matches) pass = false;
        }

        return pass;
      });

      // Update UI Counter
      if (counterText) {
        counterText.textContent = `${filteredTrees.length} visibles`;
      }

      const hasActiveFilters = currentFilterType !== 'all' || selectedCategoryId !== null || searchQuery.trim().length > 0;
      if (clearBtn) {
        clearBtn.style.display = hasActiveFilters ? 'inline-block' : 'none';
      }

      // Empty State Toast
      if (filteredTrees.length === 0) {
        if (noTreesMsg) noTreesMsg.style.display = 'flex';
      } else {
        if (noTreesMsg) noTreesMsg.style.display = 'none';
      }

      // Dispatch to MapComponent
      const newCenter = calculateCenter(filteredTrees);
      mapElement.dispatchEvent(new CustomEvent('update-markers', {
        detail: {
          newMarkers: filteredTrees,
          newCenter: newCenter
        }
      }));
    }

    // Segment Filter Buttons
    segmentButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        segmentButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentFilterType = btn.getAttribute('data-filter') || 'all';
        applyFilters();
      });
    });

    // Micro Category Chips
    microCategoryChips.forEach(chip => {
      chip.addEventListener('click', () => {
        const catId = chip.getAttribute('data-category-id');
        if (selectedCategoryId === catId) {
          selectedCategoryId = null;
          chip.classList.remove('active');
        } else {
          microCategoryChips.forEach(c => c.classList.remove('active'));
          chip.classList.add('active');
          selectedCategoryId = catId;
        }
        applyFilters();
      });
    });

    // Search Input Listener
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value;
        applyFilters();
      });
    }

    // Reset Function
    function resetAllFilters() {
      currentFilterType = 'all';
      selectedCategoryId = null;
      searchQuery = '';
      
      segmentButtons.forEach(b => {
        if (b.getAttribute('data-filter') === 'all') {
          b.classList.add('active');
        } else {
          b.classList.remove('active');
        }
      });

      microCategoryChips.forEach(c => c.classList.remove('active'));
      if (searchInput) searchInput.value = '';

      applyFilters();
    }

    if (clearBtn) clearBtn.addEventListener('click', resetAllFilters);
    if (toastResetBtn) toastResetBtn.addEventListener('click', resetAllFilters);
  });
</script>
