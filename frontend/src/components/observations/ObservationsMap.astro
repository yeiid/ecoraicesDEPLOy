  @media (max-width: 768px) {
    .minimal-toolbar-card {
      padding: 0.7rem 0.75rem;
    }
    .toolbar-primary-row {
      flex-direction: column;
      align-items: stretch;
    }
    .segmented-filters {
      display: flex;
      width: 100%;
    }
    .segment-btn {
      flex: 1 1 auto;
      padding: 6px 8px;
      font-size: 0.78rem;
    }
    .toolbar-tools {
      width: 100%;
    }
    .search-input-wrapper {
      flex: 1 1 140px;
    }
