---
// frontend/src/components/observations/ObservationsMap.astro
import MapComponent from "./MapComponent.astro";
import { apiGet } from "../../lib/api/client.js";
import { getSessionUser } from "../../lib/middleware/auth.js";

const { initialFilterCategory = null, showFilters = true } = Astro.props;

let trees = [];
let categories = [];
let speciesList = [];
let sessionUser = null;

try {
  const [treesRes, catsRes, speciesRes, userRes] = await Promise.all([
    apiGet('/observations').catch((error) => {
      console.error("Error fetching observations:", error);
      return [];
    }),
    apiGet('/categories').catch((error) => {
      console.error("Error fetching categories:", error);
      return [];
    }),
    apiGet('/species?limit=200').catch((error) => {
      console.error("Error fetching species:", error);
      return [];
    }),
    getSessionUser({ cookies: Astro.cookies, request: Astro.request }).catch(() => null),
  ]);
  trees = Array.isArray(treesRes) ? treesRes : [];
  categories = Array.isArray(catsRes) ? catsRes : [];
  speciesList = Array.isArray(speciesRes) ? speciesRes : [];
  sessionUser = userRes;
} catch (error) {
  console.error("Error fetching map data:", error);
}

const isInvasiveCheck = (t) => {
  const txt = `${t?.species?.name || ""} ${t?.species?.scientificName || ""} ${t?.name || ""}`.toLowerCase();
  return txt.includes("neem") || txt.includes("nim") || txt.includes("azadirachta");
};

const invasiveCount = trees.filter(isInvasiveCheck).length;
const nativeCount = trees.length - invasiveCount;
const verifiedCount = trees.filter((t) => Boolean(t?.isVerified || t?.verified || t?.status === "APPROVED")).length;

const compactSpecies = speciesList.map((s) => ({
  id: s.id,
  name: s.name,
  scientificName: s.scientificName || ""
}));
const quickSpeciesChips = compactSpecies.slice(0, 6);
---

<div
  class="observations-map-root"
  data-initial-category={initialFilterCategory}
  data-authenticated={sessionUser ? "true" : "false"}
  data-species-catalog={JSON.stringify(compactSpecies)}
>
  {showFilters && (
    <search class="minimal-toolbar-card" aria-label="Filtros del Catastro Arbóreo 3D">
      <div class="toolbar-primary-row">
        <!-- Quick Filter Segmented Pills -->
        <div class="segmented-filters" role="group" aria-label="Filtros rápidos de especies">
          <button type="button" class="segment-btn active" data-filter="all">
            <span class="seg-icon" aria-hidden="true">🌐</span>
            <span class="seg-text">Todos</span>
            <span class="seg-badge" id="badge-all-count">{trees.length}</span>
          </button>

          <button type="button" class="segment-btn btn-danger-pill" data-filter="invasive" title="Monitoreo de Neem y zonas alelopáticas">
            <span class="seg-icon" aria-hidden="true">🚨</span>
            <span class="seg-text">Invasores</span>
            <span class="seg-badge" id="badge-invasive-count">{invasiveCount}</span>
          </button>

          <button type="button" class="segment-btn btn-success-pill" data-filter="native" title="Flora nativa protectora">
            <span class="seg-icon" aria-hidden="true">🌿</span>
            <span class="seg-text">Nativas</span>
            <span class="seg-badge" id="badge-native-count">{nativeCount}</span>
          </button>

          <button type="button" class="segment-btn btn-verified-pill" data-filter="verified" title="Registros confirmados por especialistas">
            <span class="seg-icon" aria-hidden="true">✓</span>
            <span class="seg-text">Verificados</span>
            <span class="seg-badge" id="badge-verified-count">{verifiedCount}</span>
          </button>
        </div>

        <!-- GPS Pill + Search + Visible Counter -->
        <div class="toolbar-tools">
          <button type="button" id="toolbar-gps-pill" class="gps-location-pill" title="Detectar ubicación GPS y centrar el mapa">
            <span aria-hidden="true">📍</span>
            <span id="toolbar-gps-text">Detectar GPS</span>
          </button>

          <div class="search-input-wrapper">
            <span class="search-icon" aria-hidden="true">🔍</span>
            <input
              type="search"
              id="tree-search-input"
              class="minimal-search-input"
              placeholder="Buscar especie o municipio..."
              aria-label="Buscar árbol por especie o municipio"
              autocorrect="off"
              autocapitalize="none"
              spellcheck="false"
            />
          </div>

          <button type="button" class="visible-counter-badge" id="trees-count-display" title="Enfocar todos los árboles visibles en el mapa">
            <span class="pulse-status-dot" aria-hidden="true"></span>
            <span id="counter-text">{trees.length} visibles</span>
          </button>

          <button type="button" id="clear-filters-btn" class="btn-reset-filters" style="display: none;" title="Restablecer filtros">
            ✕ Limpiar
          </button>
        </div>
      </div>

      <!-- Category Micro-Chips -->
      {categories.length > 0 && (
        <div class="category-micro-row">
          <span class="micro-label">Categorías:</span>
          <div class="category-micro-scroll" id="category-micro-filters">
            {categories.map((cat) => (
              <button
                type="button"
                class="micro-category-chip"
                data-category-id={cat.id}
              >
                {cat.name}
              </button>
            ))}
          </div>
        </div>
      )}
    </search>
  )}

  <!-- Map Frame with Catastro 3D Pick Banner, Quick-Add Sheet & Empty Toast -->
  <div class="map-frame-wrapper">
    <!-- Floating Banner when Pick Mode (+ Árbol 3D) is active -->
    <div id="cadastre-pick-banner" class="cadastre-pick-banner" hidden>
      <span id="cadastre-pick-banner-text" class="pick-banner-text">
        🌱 Toca cualquier punto del mapa para ubicar el árbol 3D
      </span>
      <button type="button" id="pick-use-gps-btn" class="pick-gps-btn">
        📍 Usar mi GPS
      </button>
      <button type="button" id="pick-cancel-btn" class="pick-cancel-btn" aria-label="Salir del modo colocación">
        ✕
      </button>
    </div>

    <!-- Direct Catastro 3D Quick-Add Form Drawer -->
    <div id="quick-cadastre-sheet" class="quick-cadastre-sheet" hidden>
      <div class="quick-sheet-header">
        <div>
          <h3 id="quick-cadastre-title" class="quick-sheet-title">🌳 Registrar en Catastro Arbóreo 3D</h3>
          <p id="quick-cadastre-coords" class="quick-sheet-coords">📍 Selecciona un punto en el mapa</p>
        </div>
        <button type="button" id="quick-sheet-close" class="quick-sheet-close" aria-label="Cerrar panel de registro">
          ✕
        </button>
      </div>

      {!sessionUser ? (
        <div class="quick-auth-gate">
          <p>Inicia sesión con tu cuenta de guardabosques para guardar este árbol directamente en el Catastro 3D oficial.</p>
          <div class="quick-auth-actions">
            <a href="/auth/login" class="btn-quick-save">Iniciar sesión</a>
            <a href="/auth/register" class="btn-quick-cancel">Crear cuenta</a>
          </div>
        </div>
      ) : (
        <form
          id="quick-cadastre-form"
          method="POST"
          action="/api/observations"
          aria-labelledby="quick-cadastre-title"
          class="quick-cadastre-form"
        >
          <input type="hidden" id="quick-lat" name="latitude" />
          <input type="hidden" id="quick-lng" name="longitude" />

          <div class="quick-grid-2">
            <div class="quick-field">
              <label for="quick-species-input">Especie / Nombre común <span aria-hidden="true">*</span></label>
              <input
                type="text"
                id="quick-species-input"
                name="nombreComunitario"
                list="cadastre-species-datalist"
                placeholder="Ej. Trupillo, Guayacán, Dividivi, Neem..."
                autocomplete="off"
                required
              />
              <datalist id="cadastre-species-datalist">
                {compactSpecies.map((sp) => (
                  <option value={sp.name}>{sp.scientificName ? `(${sp.scientificName})` : ""}</option>
                ))}
              </datalist>
            </div>

            <div class="quick-field">
              <label for="quick-municipio-input">Municipio / Sector</label>
              <input
                type="text"
                id="quick-municipio-input"
                name="municipio"
                placeholder="Detectado automáticamente por GPS..."
                autocomplete="address-level2"
              />
            </div>
          </div>

          {quickSpeciesChips.length > 0 && (
            <div class="quick-species-chips" aria-label="Sugerencias rápidas de especies">
              {quickSpeciesChips.map((sp) => (
                <button type="button" class="quick-sp-chip" data-species-name={sp.name} data-species-id={sp.id}>
                  {sp.name}
                </button>
              ))}
            </div>
          )}

          <div class="quick-grid-2">
            <fieldset class="quick-fieldset">
              <legend>Altura 3D estimada</legend>
              <div class="quick-radio-row">
                {[5, 8, 12, 16].map((h) => (
                  <label class="quick-radio-pill">
                    <input
                      type="radio"
                      name="alturaArbol"
                      value={String(h)}
                      checked={h === 8}
                    />
                    <span>{h}m</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <fieldset class="quick-fieldset">
              <legend>Estado fitosanitario</legend>
              <div class="quick-radio-row">
                {[
                  { val: "Sano y vigoroso", label: "🌳 Sano" },
                  { val: "Con floración o frutos", label: "🌸 Flores" },
                  { val: "Dañado o talado", label: "🪓 Dañado" },
                  { val: "Seco o con plaga", label: "🍂 Seco" }
                ].map((opt, idx) => (
                  <label class="quick-radio-pill">
                    <input
                      type="radio"
                      name="estadoFitosanitario"
                      value={opt.val}
                      checked={idx === 0}
                    />
                    <span>{opt.label}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          </div>

          <div id="quick-form-status" class="quick-form-status" role="status" aria-live="polite" hidden></div>

          <div class="quick-form-actions">
            <button type="button" id="quick-form-cancel" class="btn-quick-cancel">Cancelar</button>
            <button type="submit" id="quick-form-submit" class="btn-quick-save">
              ✓ Guardar en Catastro 3D
            </button>
          </div>
        </form>
      )}
    </div>

    <!-- Sleek Floating Empty State Toast -->
    <div id="no-trees-message" class="minimal-empty-toast" style="display: none;">
      <span class="empty-icon" aria-hidden="true">🍃</span>
      <span class="empty-text">No se encontraron árboles con los filtros activos.</span>
      <button type="button" id="toast-reset-btn" class="toast-reset-link">Mostrar todos</button>
    </div>

    <MapComponent
      id="main-observations-map"
      center={[-72.9068, 11.5448]}
      zoom={7}
      markers={trees}
      readOnly={true}
      enableCadastreTools={true}
      initial3D={true}
      height="650px"
    />
  </div>
</div>

<style>
  .observations-map-root {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    width: 100%;
    min-width: 0;
  }

  .minimal-toolbar-card {
    background: #ffffff;
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 14px;
    padding: 0.75rem 1rem;
    box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    width: 100%;
    min-width: 0;
  }

  .toolbar-primary-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    min-width: 0;
  }

  .segmented-filters {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    background: #f1f5f9;
    padding: 4px;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
    max-width: 100%;
    min-width: 0;
  }

  .segment-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 5px 10px;
    font-size: 0.82rem;
    font-weight: 600;
    color: #475569;
    cursor: pointer;
    transition: all 0.2s ease;
    user-select: none;
    white-space: nowrap;
  }

  .segment-btn:hover {
    color: #0f172a;
    background: rgba(255, 255, 255, 0.65);
  }

  .segment-btn.active {
    background: #ffffff;
    color: #0f172a;
    border-color: #cbd5e1;
    box-shadow: 0 1px 4px rgba(15, 23, 42, 0.06);
  }

  .seg-badge {
    background: #e2e8f0;
    color: #334155;
    font-size: 10px;
    font-weight: 800;
    padding: 1px 6px;
    border-radius: 999px;
  }

  .segment-btn.active .seg-badge {
    background: #064e3b;
    color: #ffffff;
  }

  .btn-danger-pill.active {
    background: #fee2e2 !important;
    color: #b91c1c !important;
    border-color: #fca5a5 !important;
  }

  .btn-danger-pill.active .seg-badge {
    background: #dc2626;
  }

  .btn-success-pill.active {
    background: #ecfdf5 !important;
    color: #047857 !important;
    border-color: #a7f3d0 !important;
  }

  .btn-verified-pill.active {
    background: #eff6ff !important;
    color: #1d4ed8 !important;
    border-color: #bfdbfe !important;
  }

  .btn-verified-pill.active .seg-badge {
    background: #1d4ed8;
  }

  .toolbar-tools {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    min-width: 0;
  }

  .gps-location-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 0.78rem;
    font-weight: 700;
    color: #065f46;
    cursor: pointer;
    max-width: 210px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: all 0.2s ease;
  }

  .gps-location-pill:hover,
  .gps-location-pill.is-detected {
    background: #ecfdf5;
    border-color: #86efac;
  }

  .search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .search-icon {
    position: absolute;
    left: 10px;
    font-size: 12px;
    color: #94a3b8;
    pointer-events: none;
  }

  .minimal-search-input {
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 6px 12px 6px 30px;
    font: inherit;
    font-size: 0.85rem;
    color: #0f172a;
    transition: all 0.2s ease;
    width: 210px;
    max-width: 100%;
    min-width: 0;
  }

  .minimal-search-input:focus-visible {
    background: #ffffff;
    border-color: #10b981;
    outline: 2px solid rgba(16, 185, 129, 0.28);
    outline-offset: 1px;
  }

  .visible-counter-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    font-weight: 700;
    color: #065f46;
    background: #ecfdf5;
    padding: 6px 10px;
    border-radius: 8px;
    border: 1px solid #a7f3d0;
    white-space: nowrap;
    flex-shrink: 0;
    cursor: pointer;
  }

  .visible-counter-badge:hover {
    background: #d1fae5;
  }

  .pulse-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #10b981;
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.6);
    flex-shrink: 0;
  }

  .btn-reset-filters {
    background: #fee2e2;
    color: #dc2626;
    border: 1px solid #fecdd3;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 6px 9px;
    border-radius: 6px;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .btn-reset-filters:hover {
    background: #fca5a5;
    color: #991b1b;
  }

  /* Micro-Category Chips */
  .category-micro-row {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    min-width: 0;
    padding-top: 6px;
    border-top: 1px solid #f1f5f9;
  }

  .category-micro-scroll {
    display: flex;
    align-items: center;
    gap: 6px;
    flex: 1 1 auto;
    min-width: 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .category-micro-scroll::-webkit-scrollbar {
    display: none;
  }

  .micro-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: #64748b;
    white-space: nowrap;
    flex: none;
  }

  .micro-category-chip {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    padding: 3px 10px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #475569;
    cursor: pointer;
    white-space: nowrap;
    flex: none;
    transition: all 0.2s ease;
  }

  .micro-category-chip:hover {
    background: #e2e8f0;
    color: #0f172a;
  }

  .micro-category-chip.active {
    background: #047857;
    color: #ffffff;
    border-color: #047857;
  }

  /* Map Frame Wrapper */
  .map-frame-wrapper {
    position: relative;
    width: 100%;
    min-width: 0;
    border-radius: 16px;
    overflow: hidden;
  }

  /* Pick Banner */
  .cadastre-pick-banner[hidden],
  .quick-cadastre-sheet[hidden],
  .quick-form-status[hidden] {
    display: none !important;
  }

  .cadastre-pick-banner {
    position: absolute;
    top: 14px;
    left: 14px;
    max-width: min(500px, calc(100% - 28px));
    background: rgba(2, 132, 199, 0.96);
    color: #ffffff;
    border-radius: 11px;
    padding: 8px 11px;
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 26;
    box-shadow: 0 8px 22px rgba(2, 132, 199, 0.35);
    backdrop-filter: blur(8px);
  }

  .pick-banner-text {
    font-size: 12px;
    font-weight: 800;
    flex: 1;
  }

  .pick-gps-btn {
    background: #0369a1;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 7px;
    padding: 4px 9px;
    font-size: 11px;
    font-weight: 800;
    cursor: pointer;
    white-space: nowrap;
  }

  .pick-gps-btn:hover {
    background: #075985;
  }

  .pick-cancel-btn {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.22);
    color: #ffffff;
    font-weight: 800;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* Quick Add Sheet Drawer */
  .quick-cadastre-sheet {
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    width: min(620px, calc(100% - 24px));
    max-height: calc(100% - 84px);
    overflow-y: auto;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(12px);
    border: 1.5px solid #0284c7;
    border-radius: 16px;
    padding: 14px 16px;
    box-shadow: 0 18px 42px rgba(15, 23, 42, 0.28);
    z-index: 28;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .quick-sheet-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
  }

  .quick-sheet-title {
    margin: 0;
    font-size: 14.5px;
    font-weight: 900;
    color: #0f172a;
  }

  .quick-sheet-coords {
    margin: 2px 0 0 0;
    font-size: 11.5px;
    font-weight: 700;
    color: #0369a1;
  }

  .quick-sheet-close {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: none;
    background: #f1f5f9;
    color: #475569;
    font-weight: 800;
    cursor: pointer;
    flex-shrink: 0;
  }

  .quick-sheet-close:hover {
    background: #e2e8f0;
    color: #0f172a;
  }

  .quick-auth-gate {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 13px;
    color: #334155;
  }

  .quick-auth-gate p {
    margin: 0;
  }

  .quick-auth-actions {
    display: flex;
    gap: 8px;
  }

  .quick-cadastre-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .quick-grid-2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .quick-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .quick-field label {
    font-size: 11.5px;
    font-weight: 800;
    color: #334155;
  }

  .quick-field input {
    font: inherit;
    font-size: 0.9rem;
    padding: 8px 10px;
    border-radius: 8px;
    border: 1px solid #94a3b8;
    background: #f8fafc;
    color: #0f172a;
    min-height: 38px;
    box-sizing: border-box;
  }

  .quick-field input:focus-visible {
    background: #ffffff;
    border-color: #0284c7;
    outline: 2px solid rgba(2, 132, 199, 0.25);
    outline-offset: 1px;
  }

  .quick-field input:user-invalid {
    border-color: #dc2626;
  }

  .quick-species-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .quick-sp-chip {
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    border-radius: 999px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 700;
    color: #334155;
    cursor: pointer;
  }

  .quick-sp-chip:hover {
    background: #e2e8f0;
  }

  .quick-sp-chip.is-selected {
    background: #065f46;
    border-color: #065f46;
    color: #ffffff;
  }

  .quick-fieldset {
    border: none;
    padding: 0;
    margin: 0;
    min-width: 0;
  }

  .quick-fieldset legend {
    font-size: 11.5px;
    font-weight: 800;
    color: #334155;
    margin-bottom: 5px;
    padding: 0;
  }

  .quick-radio-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .quick-radio-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 5px 9px;
    font-size: 11.5px;
    font-weight: 700;
    color: #334155;
    cursor: pointer;
  }

  .quick-radio-pill input {
    accent-color: #0284c7;
    margin: 0;
  }

  .quick-radio-pill:has(input:checked) {
    background: #e0f2fe;
    border-color: #0284c7;
    color: #0369a1;
  }

  .quick-form-status {
    font-size: 12px;
    font-weight: 700;
    padding: 7px 10px;
    border-radius: 8px;
    background: #f0f9ff;
    color: #0369a1;
    border: 1px solid #bae6fd;
  }

  .quick-form-status.is-error {
    background: #fef2f2;
    color: #b91c1c;
    border-color: #fecaca;
  }

  .quick-form-status.is-success {
    background: #ecfdf5;
    color: #065f46;
    border-color: #a7f3d0;
  }

  .quick-form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 2px;
  }

  .btn-quick-cancel,
  .btn-quick-save {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 9px;
    padding: 9px 14px;
    font-size: 12.5px;
    font-weight: 800;
    cursor: pointer;
    text-decoration: none;
    border: none;
  }

  .btn-quick-cancel {
    background: #f1f5f9;
    color: #475569;
  }

  .btn-quick-cancel:hover {
    background: #e2e8f0;
  }

  .btn-quick-save {
    background: #059669;
    color: #ffffff;
  }

  .btn-quick-save:hover {
    background: #047857;
  }

  .btn-quick-save:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* Minimal Empty Toast */
  .minimal-empty-toast {
    position: absolute;
    bottom: 34px;
    left: 50%;
    transform: translateX(-50%);
    max-width: calc(100% - 24px);
    background: rgba(15, 23, 42, 0.92);
    backdrop-filter: blur(12px);
    color: #f8fafc;
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 500;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    z-index: 20;
  }

  .toast-reset-link {
    background: #10b981;
    color: #ffffff;
    border: none;
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .minimal-toolbar-card {
      padding: 0.7rem 0.75rem;
    }
    .toolbar-primary-row {
      flex-direction: column;
      align-items: stretch;
    }
    .segmented-filters {
      display: flex;
      width: 100%;
    }
    .segment-btn {
      flex: 1 1 auto;
      padding: 6px 8px;
      font-size: 0.78rem;
    }
    .toolbar-tools {
      width: 100%;
    }
    .search-input-wrapper {
      flex: 1 1 140px;
    }
    .minimal-search-input {
      width: 100%;
      font-size: max(1rem, 1em);
    }
    .quick-grid-2 {
      grid-template-columns: 1fr;
    }
    .quick-field input {
      font-size: max(1rem, 1em);
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const rootEl = document.querySelector('.observations-map-root') as HTMLElement | null;
    const mapElement = document.getElementById('main-observations-map');
    if (!rootEl || !mapElement) return;

    let allTrees: any[] = [];
    try {
      allTrees = JSON.parse(mapElement.dataset.markers || '[]');
    } catch {
      allTrees = [];
    }

    let speciesCatalog: Array<{ id: string; name: string; scientificName?: string }> = [];
    try {
      speciesCatalog = JSON.parse(rootEl.dataset.speciesCatalog || '[]');
    } catch {
      speciesCatalog = [];
    }

    // Filter controls
    const segmentButtons = document.querySelectorAll('.segment-btn');
    const microCategoryChips = document.querySelectorAll('.micro-category-chip');
    const searchInput = document.getElementById('tree-search-input') as HTMLInputElement | null;
    const counterText = document.getElementById('counter-text');
    const counterBtn = document.getElementById('trees-count-display');
    const clearBtn = document.getElementById('clear-filters-btn');
    const noTreesMsg = document.getElementById('no-trees-message');
    const toastResetBtn = document.getElementById('toast-reset-btn');
    const toolbarGpsPill = document.getElementById('toolbar-gps-pill');
    const toolbarGpsText = document.getElementById('toolbar-gps-text');

    const badgeAll = document.getElementById('badge-all-count');
    const badgeInv = document.getElementById('badge-invasive-count');
    const badgeNat = document.getElementById('badge-native-count');
    const badgeVer = document.getElementById('badge-verified-count');

    // Quick-Add Catastro 3D controls
    const pickBanner = document.getElementById('cadastre-pick-banner');
    const pickBannerText = document.getElementById('cadastre-pick-banner-text');
    const pickUseGpsBtn = document.getElementById('pick-use-gps-btn');
    const pickCancelBtn = document.getElementById('pick-cancel-btn');
    const quickSheet = document.getElementById('quick-cadastre-sheet');
    const quickSheetClose = document.getElementById('quick-sheet-close');
    const quickCoordsLabel = document.getElementById('quick-cadastre-coords');
    const quickForm = document.getElementById('quick-cadastre-form') as HTMLFormElement | null;
    const quickLatInput = document.getElementById('quick-lat') as HTMLInputElement | null;
    const quickLngInput = document.getElementById('quick-lng') as HTMLInputElement | null;
    const quickSpeciesInput = document.getElementById('quick-species-input') as HTMLInputElement | null;
    const quickMuniInput = document.getElementById('quick-municipio-input') as HTMLInputElement | null;
    const quickStatus = document.getElementById('quick-form-status');
    const quickSubmitBtn = document.getElementById('quick-form-submit') as HTMLButtonElement | null;
    const quickCancelBtn = document.getElementById('quick-form-cancel');
    const quickSpChips = document.querySelectorAll('.quick-sp-chip');

    let currentFilterType = 'all';
    let selectedCategoryId: string | null = rootEl.dataset.initialCategory || null;
    let searchQuery = '';
    let detectedGpsMunicipio = '';
    let draftCoords: { lat: number; lng: number } | null = null;
    let selectedSpeciesId: string | null = null;

    function isNeemTree(tree: any) {
      const rawName = (
        (tree.species?.name || '') + ' ' +
        (tree.species?.scientificName || '') + ' ' +
        (tree.species?.commonName || '') + ' ' +
        (tree.name || '')
      ).toLowerCase();
      return rawName.includes('neem') || rawName.includes('nim') || rawName.includes('azadirachta');
    }

    function updateFilterBadges() {
      let inv = 0;
      let nat = 0;
      let ver = 0;
      allTrees.forEach((t) => {
        if (isNeemTree(t)) inv++;
        else nat++;
        if (t.isVerified || t.verified || t.status === 'APPROVED') ver++;
      });
      if (badgeAll) badgeAll.textContent = String(allTrees.length);
      if (badgeInv) badgeInv.textContent = String(inv);
      if (badgeNat) badgeNat.textContent = String(nat);
      if (badgeVer) badgeVer.textContent = String(ver);
    }

    function applyFilters(shouldFit = true) {
      const filteredTrees = allTrees.filter((tree) => {
        if (selectedCategoryId) {
          const catId = tree.species?.categoryId || tree.species?.category?.id;
          if (!catId || catId !== selectedCategoryId) return false;
        }

        const isNeem = isNeemTree(tree);
        if (currentFilterType === 'invasive' && !isNeem) return false;
        if (currentFilterType === 'native' && isNeem) return false;
        if (currentFilterType === 'verified' && !(tree.isVerified || tree.verified || tree.status === 'APPROVED')) {
          return false;
        }

        if (searchQuery.trim().length > 0) {
          const q = searchQuery.toLowerCase().trim();
          const haystack = (
            (tree.species?.name || '') + ' ' +
            (tree.species?.scientificName || '') + ' ' +
            (tree.name || '') + ' ' +
            (tree.municipio || '')
          ).toLowerCase();
          if (!haystack.includes(q)) return false;
        }

        return true;
      });

      if (counterText) counterText.textContent = `${filteredTrees.length} visibles`;

      const hasActiveFilters = currentFilterType !== 'all' || selectedCategoryId !== null || searchQuery.trim().length > 0;
      if (clearBtn) clearBtn.style.display = hasActiveFilters ? 'inline-block' : 'none';
      if (noTreesMsg) noTreesMsg.style.display = filteredTrees.length === 0 ? 'flex' : 'none';

      mapElement.dispatchEvent(new CustomEvent('update-markers', {
        detail: { newMarkers: filteredTrees, shouldFit }
      }));
    }

    function getSelectedHeight(): number {
      const checked = quickForm?.querySelector('input[name="alturaArbol"]:checked') as HTMLInputElement | null;
      return checked ? parseFloat(checked.value) || 8 : 8;
    }

    function getSelectedHealth(): string {
      const checked = quickForm?.querySelector('input[name="estadoFitosanitario"]:checked') as HTMLInputElement | null;
      return checked ? checked.value : 'Sano y vigoroso';
    }

    function syncDraftPreview(center = false) {
      if (!draftCoords) return;
      mapElement.dispatchEvent(new CustomEvent('set-draft-tree', {
        detail: {
          lat: draftCoords.lat,
          lng: draftCoords.lng,
          heightMeters: getSelectedHeight(),
          speciesName: quickSpeciesInput?.value.trim() || 'Árbol Nuevo',
          center
        }
      }));
    }

    function showQuickStatus(msg: string, tone: 'info' | 'error' | 'success' = 'info') {
      if (!quickStatus) return;
      quickStatus.textContent = msg;
      quickStatus.className = `quick-form-status${tone === 'error' ? ' is-error' : tone === 'success' ? ' is-success' : ''}`;
      quickStatus.hidden = false;
    }

    function closePickFlow() {
      draftCoords = null;
      if (pickBanner) pickBanner.hidden = true;
      if (quickSheet) quickSheet.hidden = true;
      if (quickStatus) quickStatus.hidden = true;
      mapElement.dispatchEvent(new CustomEvent('set-pick-mode', { detail: { active: false } }));
    }

    async function resolvePointMunicipio(lat: number, lng: number) {
      try {
        const ctrl = new AbortController();
        const timer = setTimeout(() => ctrl.abort(), 4500);
        const res = await fetch(
          `https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${encodeURIComponent(lat)}&lon=${encodeURIComponent(lng)}&zoom=12&accept-language=es`,
          { signal: ctrl.signal }
        );
        clearTimeout(timer);
        if (!res.ok) return null;
        const data = await res.json();
        const addr = data.address || {};
        const muni = addr.city || addr.town || addr.municipality || addr.village || addr.county || '';
        const state = addr.state || '';
        if (!muni) return null;
        return { muni, label: state && state !== muni ? `${muni}, ${state}` : muni };
      } catch {
        return null;
      }
    }

    // Listen to MapComponent events
    mapElement.addEventListener('cadastre-pick-mode-change', ((e: CustomEvent) => {
      const active = Boolean(e.detail?.active);
      if (pickBanner) pickBanner.hidden = !active;
      if (pickBannerText) {
        pickBannerText.textContent = '🌱 Toca cualquier punto del mapa para ubicar el árbol 3D';
      }
      if (!active) {
        draftCoords = null;
        if (quickSheet) quickSheet.hidden = true;
        if (quickStatus) quickStatus.hidden = true;
      }
    }) as EventListener);

    mapElement.addEventListener('cadastre-pick-location', ((e: CustomEvent) => {
      const lat = parseFloat(e.detail?.lat);
      const lng = parseFloat(e.detail?.lng);
      if (isNaN(lat) || isNaN(lng)) return;

      draftCoords = { lat, lng };
      if (quickLatInput) quickLatInput.value = String(lat);
      if (quickLngInput) quickLngInput.value = String(lng);
      if (quickCoordsLabel) {
        quickCoordsLabel.textContent = `📍 ${e.detail?.label || 'Punto en mapa'} • ${lat.toFixed(5)}, ${lng.toFixed(5)}`;
      }
      if (pickBannerText) {
        pickBannerText.textContent = '🌳 Ajusta la altura 3D o toca otro punto del mapa';
      }
      if (quickMuniInput && !quickMuniInput.value.trim()) {
        quickMuniInput.value = e.detail?.municipio || detectedGpsMunicipio || '';
      }
      if (quickSheet) quickSheet.hidden = false;
      if (quickStatus) quickStatus.hidden = true;
      syncDraftPreview(false);
      quickSpeciesInput?.focus();

      if (!e.detail?.municipio) {
        resolvePointMunicipio(lat, lng).then((loc) => {
          if (!loc || !draftCoords) return;
          if (quickCoordsLabel) {
            quickCoordsLabel.textContent = `📍 ${loc.label} • ${lat.toFixed(5)}, ${lng.toFixed(5)}`;
          }
          if (quickMuniInput && !quickMuniInput.value.trim()) {
            quickMuniInput.value = loc.muni;
          }
        });
      }
    }) as EventListener);

    mapElement.addEventListener('gps-location-updated', ((e: CustomEvent) => {
      const label = e.detail?.label || '';
      const muni = e.detail?.municipio || '';
      if (muni) detectedGpsMunicipio = muni;
      if (toolbarGpsText && label) toolbarGpsText.textContent = label;
      if (toolbarGpsPill && label) toolbarGpsPill.classList.add('is-detected');
    }) as EventListener);

    if (toolbarGpsPill) {
      toolbarGpsPill.addEventListener('click', () => {
        mapElement.dispatchEvent(new CustomEvent('trigger-gps', { detail: { placeDraft: false } }));
      });
    }

    if (counterBtn) {
      counterBtn.addEventListener('click', () => {
        mapElement.dispatchEvent(new CustomEvent('fit-trees'));
      });
    }

    if (pickUseGpsBtn) {
      pickUseGpsBtn.addEventListener('click', () => {
        mapElement.dispatchEvent(new CustomEvent('trigger-gps', { detail: { placeDraft: true } }));
      });
    }

    if (pickCancelBtn) pickCancelBtn.addEventListener('click', closePickFlow);
    if (quickSheetClose) quickSheetClose.addEventListener('click', closePickFlow);
    if (quickCancelBtn) quickCancelBtn.addEventListener('click', closePickFlow);

    // Quick species chips
    quickSpChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const spName = chip.getAttribute('data-species-name') || '';
        const spId = chip.getAttribute('data-species-id');
        selectedSpeciesId = spId;
        if (quickSpeciesInput) quickSpeciesInput.value = spName;
        quickSpChips.forEach((c) => c.classList.toggle('is-selected', c === chip));
        syncDraftPreview(false);
      });
    });

    if (quickSpeciesInput) {
      quickSpeciesInput.addEventListener('input', () => {
        const val = quickSpeciesInput.value.trim().toLowerCase();
        const match = speciesCatalog.find((s) => s.name.toLowerCase() === val);
        selectedSpeciesId = match ? match.id : null;
        quickSpChips.forEach((c) => {
          const isMatch = (c.getAttribute('data-species-name') || '').toLowerCase() === val;
          c.classList.toggle('is-selected', isMatch);
        });
        syncDraftPreview(false);
      });
    }

    // Live 3D tree height preview when changing height radio buttons
    quickForm?.querySelectorAll('input[name="alturaArbol"]').forEach((radio) => {
      radio.addEventListener('change', () => syncDraftPreview(false));
    });

    // Submit quick-add Catastro 3D tree to POST /api/observations
    if (quickForm) {
      quickForm.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        if (!draftCoords) {
          showQuickStatus('Toca un punto en el mapa para ubicar el árbol.', 'error');
          return;
        }
        const spName = quickSpeciesInput?.value.trim() || '';
        if (!spName) {
          showQuickStatus('Ingresa o selecciona una especie para el árbol.', 'error');
          quickSpeciesInput?.focus();
          return;
        }

        const heightM = getSelectedHeight();
        const health = getSelectedHealth();
        const muni = quickMuniInput?.value.trim() || detectedGpsMunicipio || 'Sin municipio';

        const exactCatalog = speciesCatalog.find((s) => s.name.toLowerCase() === spName.toLowerCase());
        const resolvedSpId = selectedSpeciesId || exactCatalog?.id || null;
        const resolvedSci = exactCatalog?.scientificName || `Pendiente (${spName.slice(0, 18)} - ${Date.now().toString().slice(-4)})`;

        const formData = new FormData();
        formData.append('clientId', `web3d_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`);
        if (resolvedSpId) formData.append('speciesId', resolvedSpId);
        formData.append('nombreComunitario', spName);
        formData.append('nombreCientificoPropuesto', resolvedSci);
        formData.append('municipio', muni);
        formData.append('latitude', String(draftCoords.lat));
        formData.append('longitude', String(draftCoords.lng));
        formData.append('alturaArbol', String(heightM));
        formData.append('estadoFitosanitario', health);
        formData.append('notes', `Altura: ${heightM}m. Registrado en Catastro 3D Web.`);
        formData.append('observationDate', new Date().toISOString().split('T')[0]);

        if (quickSubmitBtn) {
          quickSubmitBtn.disabled = true;
          quickSubmitBtn.textContent = 'Guardando...';
        }

        try {
          const res = await fetch('/api/observations', {
            method: 'POST',
            body: formData
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) {
            throw new Error(data.detail || data.message || `Error HTTP ${res.status}`);
          }

          const createdObs = data.observation || data;
          const newTreeRecord = {
            id: createdObs.id || `tmp-${Date.now()}`,
            latitude: draftCoords.lat,
            longitude: draftCoords.lng,
            heightMeters: createdObs.heightMeters || heightM,
            municipio: createdObs.municipio || muni,
            notes: createdObs.notes || `Altura: ${heightM}m.`,
            status: createdObs.status || 'PENDING',
            isVerified: createdObs.status === 'APPROVED',
            verified: createdObs.status === 'APPROVED',
            species: {
              id: resolvedSpId,
              name: spName,
              scientificName: exactCatalog?.scientificName || ''
            }
          };

          allTrees = [newTreeRecord, ...allTrees];
          updateFilterBadges();
          applyFilters(false);

          if (quickSpeciesInput) quickSpeciesInput.value = '';
          selectedSpeciesId = null;
          quickSpChips.forEach((c) => c.classList.remove('is-selected'));
          closePickFlow();
        } catch (err: any) {
          showQuickStatus(err?.message || 'No se pudo guardar el árbol en el servidor.', 'error');
        } finally {
          if (quickSubmitBtn) {
            quickSubmitBtn.disabled = false;
            quickSubmitBtn.textContent = '✓ Guardar en Catastro 3D';
          }
        }
      });
    }

    // Filter interactions
    segmentButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        segmentButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentFilterType = btn.getAttribute('data-filter') || 'all';
        applyFilters(true);
      });
    });

    microCategoryChips.forEach((chip) => {
      const catId = chip.getAttribute('data-category-id');
      if (selectedCategoryId && catId === selectedCategoryId) {
        chip.classList.add('active');
      }
      chip.addEventListener('click', () => {
        if (selectedCategoryId === catId) {
          selectedCategoryId = null;
          chip.classList.remove('active');
        } else {
          microCategoryChips.forEach((c) => c.classList.remove('active'));
          chip.classList.add('active');
          selectedCategoryId = catId;
        }
        chip.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        applyFilters(true);
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value;
        applyFilters(true);
      });
    }

    function resetAllFilters() {
      currentFilterType = 'all';
      selectedCategoryId = null;
      searchQuery = '';
      segmentButtons.forEach((b) => {
        b.classList.toggle('active', b.getAttribute('data-filter') === 'all');
      });
      microCategoryChips.forEach((c) => c.classList.remove('active'));
      if (searchInput) searchInput.value = '';
      applyFilters(true);
    }

    if (clearBtn) clearBtn.addEventListener('click', resetAllFilters);
    if (toastResetBtn) toastResetBtn.addEventListener('click', resetAllFilters);

    if (selectedCategoryId) {
      applyFilters(true);
    }
  });
</script>
