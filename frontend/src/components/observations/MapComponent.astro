<script define:vars={{ mapApiUrl: MAP_API_URL, maplibreJs: MAPLIBRE_JS }}>
  const MAP_API_URL = mapApiUrl;
  const MAPLIBRE_JS_URL = maplibreJs;
  let cachedStyle = null;

  const INTERACTIVE_TREE_LAYERS = [
    'ecoraices-trees-3d-layer',
    'ecoraices-trees-overview-dot',
    'ecoraices-trees-footprint-fill',
    'ecoraices-trees-labels'
  ];

  // Servidor Cartográfico Propio 3D: map.neuraljira.tech
  async function buildStyle() {
    if (cachedStyle) return cachedStyle;

    try {
      sessionStorage.removeItem('ecoraices-light-map-style');
      sessionStorage.removeItem('ecoraices-clean-osm-v3');
      const ss = sessionStorage.getItem('ecoraices-neuraljira-3d-v1');
      if (ss) {
        cachedStyle = JSON.parse(ss);
        return cachedStyle;
      }
    } catch { /* noop */ }

    try {
      const res = await fetch(`${MAP_API_URL}/api/v1/style.json`);
      if (!res.ok) throw new Error(`Style HTTP ${res.status}`);
      const style = await res.json();

      if (style.layers && Array.isArray(style.layers)) {
        style.layers.forEach((l) => {
          if (l.id === 'osm-layer' && l.paint) {
            l.paint['raster-opacity'] = 0.90;
          }
        });
      }

      cachedStyle = style;
      try { sessionStorage.setItem('ecoraices-neuraljira-3d-v1', JSON.stringify(style)); } catch { /* noop */ }
      return style;
    } catch (error) {
      console.warn("[Mapa] Error al cargar estilo de map.neuraljira.tech, usando respaldo:", error);
      return {
        version: 8,
        sources: {
          "osm-clean": {
            type: "raster",
            tiles: [
              "https://a.tile.openstreetmap.fr/osmfr/{z}/{x}/{y}.png",
              "https://b.tile.openstreetmap.fr/osmfr/{z}/{x}/{y}.png",
              "https://c.tile.openstreetmap.fr/osmfr/{z}/{x}/{y}.png"
            ],
            tileSize: 256,
            attribution: '&copy; OpenStreetMap contributors'
          }
        },
        layers: [
          {
            id: "osm-clean-layer",
            type: "raster",
            source: "osm-clean",
            minzoom: 0,
            maxzoom: 20
          }
        ]
      };
    }
  }

  function haversineMeters(lat1, lng1, lat2, lng2) {
    const R = 6371e3;
    const p1 = (lat1 * Math.PI) / 180;
    const p2 = (lat2 * Math.PI) / 180;
    const dp = ((lat2 - lat1) * Math.PI) / 180;
    const dl = ((lng2 - lng1) * Math.PI) / 180;
    const a =
      Math.sin(dp / 2) * Math.sin(dp / 2) +
      Math.cos(p1) * Math.cos(p2) * Math.sin(dl / 2) * Math.sin(dl / 2);
    return Math.round(2 * R * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a)));
  }

  function formatDistance(meters) {
    if (meters == null || isNaN(meters)) return 'En territorio';
    if (meters < 1000) return `${meters} m`;
    return `${(meters / 1000).toFixed(1)} km`;
  }

  /**
   * Genera un anillo GeoJSON circular/poligonal en metros reales sobre la superficie terrestre.
   */
  function createCircleRing(lng, lat, radiusMeters, sides = 14, offsetLngM = 0, offsetLatM = 0) {
    const latRad = (lat * Math.PI) / 180;
    const mPerDegLat = 111320;
    const mPerDegLng = 111320 * Math.max(0.1, Math.cos(latRad));
    const cLng = lng + offsetLngM / mPerDegLng;
    const cLat = lat + offsetLatM / mPerDegLat;
    const ring = [];
    for (let i = 0; i <= sides; i++) {
      const angle = (i / sides) * Math.PI * 2;
      const dx = Math.cos(angle) * radiusMeters;
      const dy = Math.sin(angle) * radiusMeters;
      ring.push([cLng + dx / mPerDegLng, cLat + dy / mPerDegLat]);
    }
    return ring;
  }

  function resolveTreeHeightMeters(item, defaultHeight) {
    const explicit = parseFloat(item.heightMeters ?? item.treeHeight);
    if (!isNaN(explicit) && explicit >= 2 && explicit <= 45) return explicit;

    const notes = String(item.notes || '');
    const match = notes.match(/Altura:\s*(\d+(?:\.\d+)?)\s*m/i);
    if (match) {
      const parsed = parseFloat(match[1]);
      if (!isNaN(parsed) && parsed >= 2 && parsed <= 45) return parsed;
    }

    const alt = parseFloat(item.altitude);
    if (!isNaN(alt) && alt >= 2 && alt <= 45) return alt;

    return defaultHeight;
  }

  function getTreeBotanicalProfile(data) {
    const rawName = (
      (data.species?.name || "") + " " +
      (data.species?.scientificName || "") + " " +
      (data.species?.commonName || "") + " " +
      (data.speciesName || data.species_name || data.name || "")
    ).toLowerCase();

    if (rawName.includes("neem") || rawName.includes("nim") || rawName.includes("azadirachta")) {
      return {
        type: "neem",
        displayName: data.species?.name || data.speciesName || "Neem Guajiro",
        scientificName: "Azadirachta indica",
        isInvasive: true,
        badgeText: "Invasor • Alelopatía",
        icon: "🚨",
        defaultHeight: 12.5,
        canopyRatio: 0.44,
        dotColor: "#dc2626",
        trunkColor: "#5c2d16",
        colorBase: "#991b1b",
        colorMid: "#dc2626",
        colorTop: "#ef4444",
        footprintFill: "rgba(239, 68, 68, 0.24)",
        footprintStroke: "#ef4444",
        windShiftM: 0
      };
    }

    if (rawName.includes("trupillo") || rawName.includes("prosopis") || rawName.includes("mezquite")) {
      return {
        type: "trupillo",
        displayName: data.species?.name || data.speciesName || "Trupillo",
        scientificName: data.species?.scientificName || "Prosopis juliflora",
        isInvasive: false,
        badgeText: "Nativa Protectora",
        icon: "🌿",
        defaultHeight: 8.5,
        canopyRatio: 0.56,
        dotColor: "#059669",
        trunkColor: "#713f12",
        colorBase: "#065f46",
        colorMid: "#059669",
        colorTop: "#34d399",
        footprintFill: "rgba(16, 185, 129, 0.18)",
        footprintStroke: "#059669",
        windShiftM: 0
      };
    }

    if (rawName.includes("guayacan") || rawName.includes("guayacán") || rawName.includes("handroanthus") || rawName.includes("tabebuia")) {
      return {
        type: "guayacan",
        displayName: data.species?.name || data.speciesName || "Guayacán",
        scientificName: data.species?.scientificName || "Handroanthus chrysanthus",
        isInvasive: false,
        badgeText: "Nativa en Floración",
        icon: "🌸",
        defaultHeight: 11.5,
        canopyRatio: 0.46,
        dotColor: "#d97706",
        trunkColor: "#78350f",
        colorBase: "#a16207",
        colorMid: "#eab308",
        colorTop: "#fde047",
        footprintFill: "rgba(234, 179, 8, 0.18)",
        footprintStroke: "#d97706",
        windShiftM: 0
      };
    }

    if (rawName.includes("dividivi") || rawName.includes("divi-divi") || rawName.includes("libidibia") || rawName.includes("caesalpinia")) {
      return {
        type: "dividivi",
        displayName: data.species?.name || data.speciesName || "Dividivi",
        scientificName: data.species?.scientificName || "Libidibia coriaria",
        isInvasive: false,
        badgeText: "Ancestral Wayuu",
        icon: "🍃",
        defaultHeight: 7.5,
        canopyRatio: 0.54,
        dotColor: "#0d9488",
        trunkColor: "#713f12",
        colorBase: "#115e59",
        colorMid: "#0d9488",
        colorTop: "#2dd4bf",
        footprintFill: "rgba(13, 148, 136, 0.18)",
        footprintStroke: "#0d9488",
        windShiftM: 1.2
      };
    }

    if (rawName.includes("cardon") || rawName.includes("cardón") || rawName.includes("cactus") || rawName.includes("stenocereus")) {
      return {
        type: "cardon",
        displayName: data.species?.name || data.speciesName || "Cardón Guajiro",
        scientificName: data.species?.scientificName || "Stenocereus griseus",
        isInvasive: false,
        badgeText: "Cactácea Xerófila",
        icon: "🌵",
        defaultHeight: 6.5,
        canopyRatio: 0.25,
        dotColor: "#1e3a8a",
        trunkColor: "#065f46",
        colorBase: "#064e3b",
        colorMid: "#059669",
        colorTop: "#34d399",
        footprintFill: "rgba(16, 185, 129, 0.16)",
        footprintStroke: "#059669",
        windShiftM: 0
      };
    }

    const isVerified = Boolean(data.verified || data.isVerified || data.status === "APPROVED");
    return {
      type: "general",
      displayName: data.species?.name || data.speciesName || data.name || "Árbol Forestal",
      scientificName: data.species?.scientificName || "Especie Forestal",
      isInvasive: false,
      badgeText: isVerified ? "Verificado" : "Flora Nativa",
      icon: isVerified ? "🌳" : "🌱",
      defaultHeight: 9.5,
      canopyRatio: 0.45,
      dotColor: isVerified ? "#059669" : "#2563eb",
      trunkColor: "#78350f",
      colorBase: isVerified ? "#065f46" : "#1e3a8a",
      colorMid: isVerified ? "#10b981" : "#2563eb",
      colorTop: isVerified ? "#34d399" : "#60a5fa",
      footprintFill: isVerified ? "rgba(16, 185, 129, 0.18)" : "rgba(37, 99, 235, 0.16)",
      footprintStroke: isVerified ? "#059669" : "#2563eb",
      windShiftM: 0
    };
  }

  function buildTreeExtrusionParts(treeId, lng, lat, heightMeters, profile, isDraft = false) {
    const H = Math.max(3, Math.min(35, heightMeters));
    const canopyR = Math.max(2.0, Math.min(6.2, H * (profile.canopyRatio || 0.45)));
    const trunkR = Math.max(0.38, Math.min(0.95, canopyR * 0.15));
    const shift = profile.windShiftM || 0;
    const features = [];

    if (profile.type === "cardon") {
      const colColor = isDraft ? "#0284c7" : profile.colorMid;
      const armColor = isDraft ? "#38bdf8" : profile.colorTop;
      features.push({
        type: "Feature",
        properties: { treeId, part: "trunk", base: 0, height: H, color: colColor },
        geometry: { type: "Polygon", coordinates: [createCircleRing(lng, lat, 0.48, 10)] }
      });
      features.push({
        type: "Feature",
        properties: { treeId, part: "canopy-l", base: H * 0.34, height: H * 0.82, color: armColor },
        geometry: { type: "Polygon", coordinates: [createCircleRing(lng, lat, 0.36, 8, -0.95, 0.15)] }
      });
      features.push({
        type: "Feature",
        properties: { treeId, part: "canopy-r", base: H * 0.42, height: H * 0.88, color: armColor },
        geometry: { type: "Polygon", coordinates: [createCircleRing(lng, lat, 0.36, 8, 0.95, -0.15)] }
      });
      return { features, canopyRadius: Math.max(1.8, canopyR) };
    }

    const trunkTop = H * 0.48;
    features.push({
      type: "Feature",
      properties: {
        treeId,
        part: "trunk",
        base: 0,
        height: trunkTop,
        color: isDraft ? "#0369a1" : profile.trunkColor
      },
      geometry: { type: "Polygon", coordinates: [createCircleRing(lng, lat, trunkR, 10)] }
    });

    features.push({
      type: "Feature",
      properties: {
        treeId,
        part: "canopy-1",
        base: H * 0.36,
        height: H * 0.66,
        color: isDraft ? "#0284c7" : profile.colorBase
      },
      geometry: { type: "Polygon", coordinates: [createCircleRing(lng, lat, canopyR, 14, shift * 0.4, 0)] }
    });

    features.push({
      type: "Feature",
      properties: {
        treeId,
        part: "canopy-2",
        base: H * 0.58,
        height: H * 0.86,
        color: isDraft ? "#0ea5e9" : profile.colorMid
      },
      geometry: { type: "Polygon", coordinates: [createCircleRing(lng, lat, canopyR * 0.82, 14, shift * 0.85, 0)] }
    });

    features.push({
      type: "Feature",
      properties: {
        treeId,
        part: "canopy-3",
        base: H * 0.78,
        height: H,
        color: isDraft ? "#38bdf8" : profile.colorTop
      },
      geometry: { type: "Polygon", coordinates: [createCircleRing(lng, lat, canopyR * 0.54, 12, shift, 0)] }
    });

    return { features, canopyRadius: canopyR };
  }

  function buildCadastreGeoJSON(treesList) {
    const extrusionFeatures = [];
    const footprintFeatures = [];
    const pointFeatures = [];
    const lookup = {};

    (treesList || []).forEach((t, idx) => {
      const lat = parseFloat(t.latitude ?? t.lat);
      const lng = parseFloat(t.longitude ?? t.lng);
      if (isNaN(lat) || isNaN(lng)) return;

      const profile = getTreeBotanicalProfile(t);
      const treeId = String(t.id || t.clientId || (`tree-${idx}`));
      const heightMeters = resolveTreeHeightMeters(t, profile.defaultHeight);
      const { features, canopyRadius } = buildTreeExtrusionParts(treeId, lng, lat, heightMeters, profile, false);

      lookup[treeId] = { tree: t, profile, lat, lng, heightMeters, canopyRadius };
      extrusionFeatures.push(...features);

      const footprintR = profile.isInvasive ? canopyRadius * 1.55 : canopyRadius * 1.12;
      footprintFeatures.push({
        type: "Feature",
        properties: {
          treeId,
          isInvasive: profile.isInvasive ? 1 : 0,
          fillColor: profile.footprintFill,
          strokeColor: profile.footprintStroke
        },
        geometry: {
          type: "Polygon",
          coordinates: [createCircleRing(lng, lat, footprintR, 18)]
        }
      });

      pointFeatures.push({
        type: "Feature",
        properties: {
          treeId,
          label: profile.displayName,
          dotColor: profile.dotColor,
          isInvasive: profile.isInvasive ? 1 : 0
        },
        geometry: {
          type: "Point",
          coordinates: [lng, lat]
        }
      });
    });

    return {
      extrusionFC: { type: "FeatureCollection", features: extrusionFeatures },
      footprintFC: { type: "FeatureCollection", features: footprintFeatures },
      pointsFC: { type: "FeatureCollection", features: pointFeatures },
      lookup
    };
  }

  function isSafeImageSrc(url) {
    if (typeof url !== "string" || !url.trim()) return false;
    const trimmed = url.trim();
    return (
      trimmed.startsWith("https://") ||
      trimmed.startsWith("http://") ||
      trimmed.startsWith("/") ||
      trimmed.startsWith("data:image/")
    );
  }

  /**
   * Construye la ficha catastral/botánica usando nodos DOM seguros (sin innerHTML).
