    return card;
  }

  async function reverseGeocodeNominatim(lat, lng) {
    try {
      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), 5000);
      const url = `https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${encodeURIComponent(lat)}&lon=${encodeURIComponent(lng)}&zoom=12&accept-language=es`;
      const res = await fetch(url, { signal: ctrl.signal });
      clearTimeout(timer);
      if (!res.ok) return null;
      const json = await res.json();
      const addr = json.address || {};
      const municipio = addr.city || addr.town || addr.municipality || addr.village || addr.county || "";
      const state = addr.state || "";
      if (!municipio) return null;
      return {
        municipio,
        label: state && state !== municipio ? `${municipio}, ${state}` : municipio
      };
    } catch {
      return null;
    }
  }

  const activeMaps = [];

  document.addEventListener("astro:before-swap", () => {
    while (activeMaps.length) {
      try { activeMaps.pop().remove(); } catch { /* noop */ }
    }
    document.querySelectorAll('.astro-map').forEach((el) => {
      delete el.dataset.mapInitialized;
    });
  });

  document.addEventListener("astro:page-load", () => {
    import(MAPLIBRE_JS_URL).then(async (maplibreglModule) => {
      const maplibregl = maplibreglModule.default || window.maplibregl;
      const mapElements = document.querySelectorAll('.astro-map');

      for (const el of mapElements) {
        if (el.dataset.mapInitialized) continue;
        el.dataset.mapInitialized = 'true';

        let center = JSON.parse(el.dataset.center || "[-72.9068, 11.5448]");
        const zoom = parseFloat(el.dataset.zoom || "6");
        const readOnly = el.dataset.readonly === 'true';
        const enableCadastreTools = el.dataset.cadastreTools === 'true';
        const initial3D = el.dataset.initial3d === 'true';
        const initialMarkers = JSON.parse(el.dataset.markers || "[]");
        const interactiveMarkerData = el.dataset.interactive ? JSON.parse(el.dataset.interactive) : null;

        if (Array.isArray(center) && center.length === 2) {
          if (center[0] > -30 && center[0] < 30) {
            center = [center[1], center[0]];
          }
        } else if (center && typeof center === "object" && center.lat !== undefined) {
          center = [center.lng, center.lat];
        }

        const style = await buildStyle();

        let is3DMode = initial3D;
        let styleReady = false;
        let currentTrees = Array.isArray(initialMarkers) ? initialMarkers : [];
        let treesById = {};
        let selectedTreeId = null;
        let activePopup = null;
        let draftTreeData = null;

        // Persona & GPS state
        let isPersonMode = false;
        let personTargetEntry = null;
        let activeTreeIndex = 0;
        let userGpsCoords = null;
        let userGpsMarker = null;
        let userGpsLabelEl = null;
        let personAvatarMarker = null;
        let personAvatarBadgeEl = null;
        let toastTimer = null;

        const map = new maplibregl.Map({
          container: el.id,
          style: style,
          center: center,
          zoom: zoom,
          pitch: initial3D ? 54 : 0,
          bearing: initial3D ? -15 : 0,
          antialias: true,
          maxPitch: 80
        });
        activeMaps.push(map);

        map.addControl(new maplibregl.NavigationControl({ visualizePitch: true }), "top-right");

        // DOM references for this map instance
        const toastEl = document.getElementById(`${el.id}-status-toast`);
        const personHudEl = document.getElementById(`${el.id}-person-hud`);
        const personHudTextEl = document.getElementById(`${el.id}-person-hud-text`);
        const toggle3dBtn = document.getElementById(`${el.id}-toggle-3d`);
        const gpsBtn = document.getElementById(`${el.id}-btn-gps`);
        const personaBtn = document.getElementById(`${el.id}-btn-persona`);
        const personCard = document.getElementById(`${el.id}-person-card`);
        const personDistEl = document.getElementById(`${el.id}-person-distance`);
        const personSeqEl = document.getElementById(`${el.id}-person-seq`);
        const personTitleEl = document.getElementById(`${el.id}-person-title`);
        const personSubEl = document.getElementById(`${el.id}-person-sub`);
        const personPrevBtn = document.getElementById(`${el.id}-person-prev`);
        const personNextBtn = document.getElementById(`${el.id}-person-next`);
        const personOrbitBtn = document.getElementById(`${el.id}-person-orbit`);
        const personExitBtn = document.getElementById(`${el.id}-person-exit`);
        const legendToggle = document.getElementById(`${el.id}-legend-toggle`);
        const legendPanel = document.getElementById(`${el.id}-legend-panel`);
        const coordsDisplay = document.getElementById(`${el.id}-coords`);

        function showToast(msg, tone = "info") {
          if (!toastEl) return;
          if (toastTimer) clearTimeout(toastTimer);
          toastEl.textContent = msg;
          toastEl.className = `map-status-toast${tone === "success" ? " tone-success" : tone === "error" ? " tone-error" : ""}`;
          toastEl.hidden = false;
          toastTimer = setTimeout(() => { toastEl.hidden = true; }, 3500);
        }

        function ensureCadastreLayers() {
          if (!map || !styleReady) return;
          const emptyFC = { type: "FeatureCollection", features: [] };
          const beforeBuildings = map.getLayer("r_construccion-3d")
            ? "r_construccion-3d"
            : (map.getLayer("u_construccion-3d") ? "u_construccion-3d" : undefined);
          const beforeLabels = map.getLayer("r_vereda-label")
            ? "r_vereda-label"
            : (map.getLayer("u_nomenclatura_vial-label") ? "u_nomenclatura_vial-label" : undefined);

          try {
            if (!map.getSource("ecoraices-trees-footprint-source")) {
              map.addSource("ecoraices-trees-footprint-source", { type: "geojson", data: emptyFC });
            }
            if (!map.getSource("ecoraices-trees-3d-source")) {
              map.addSource("ecoraices-trees-3d-source", { type: "geojson", data: emptyFC });
            }
            if (!map.getSource("ecoraices-trees-points-source")) {
              map.addSource("ecoraices-trees-points-source", { type: "geojson", data: emptyFC });
            }
            if (!map.getSource("ecoraices-draft-footprint-source")) {
              map.addSource("ecoraices-draft-footprint-source", { type: "geojson", data: emptyFC });
            }
            if (!map.getSource("ecoraices-draft-3d-source")) {
              map.addSource("ecoraices-draft-3d-source", { type: "geojson", data: emptyFC });
            }
            if (!map.getSource("person-guide-source")) {
              map.addSource("person-guide-source", { type: "geojson", data: emptyFC });
            }

            if (!map.getLayer("ecoraices-trees-footprint-fill")) {
              map.addLayer({
                id: "ecoraices-trees-footprint-fill",
                type: "fill",
                source: "ecoraices-trees-footprint-source",
                minzoom: 12.5,
                paint: {
                  "fill-color": ["get", "fillColor"],
                  "fill-opacity": 0.9
                }
              }, beforeBuildings);
            }

            if (!map.getLayer("ecoraices-trees-footprint-line")) {
              map.addLayer({
                id: "ecoraices-trees-footprint-line",
                type: "line",
                source: "ecoraices-trees-footprint-source",
                minzoom: 13,
                paint: {
                  "line-color": ["get", "strokeColor"],
                  "line-width": ["case", ["==", ["get", "isInvasive"], 1], 2.2, 1.3],
                  "line-dasharray": [2, 1.5],
                  "line-opacity": 0.85
                }
              }, beforeBuildings);
            }

            if (!map.getLayer("ecoraices-trees-selected-ring")) {
              map.addLayer({
                id: "ecoraices-trees-selected-ring",
                type: "line",
                source: "ecoraices-trees-footprint-source",
                filter: ["==", ["get", "treeId"], selectedTreeId || "__none__"],
                paint: {
                  "line-color": "#10b981",
                  "line-width": 4,
                  "line-opacity": 0.95
                }
              }, beforeBuildings);
            }

            if (!map.getLayer("ecoraices-draft-footprint-fill")) {
              map.addLayer({
                id: "ecoraices-draft-footprint-fill",
                type: "fill",
                source: "ecoraices-draft-footprint-source",
                paint: {
                  "fill-color": "rgba(14, 165, 233, 0.25)",
                  "fill-opacity": 0.95
                }
              }, beforeBuildings);
            }

            if (!map.getLayer("ecoraices-draft-footprint-line")) {
              map.addLayer({
                id: "ecoraices-draft-footprint-line",
                type: "line",
                source: "ecoraices-draft-footprint-source",
                paint: {
                  "line-color": "#0284c7",
                  "line-width": 2.5,
                  "line-dasharray": [2, 1.5]
                }
              }, beforeBuildings);
            }

            if (!map.getLayer("ecoraices-trees-3d-layer")) {
              map.addLayer({
                id: "ecoraices-trees-3d-layer",
                type: "fill-extrusion",
                source: "ecoraices-trees-3d-source",
                minzoom: 11.5,
                paint: {
                  "fill-extrusion-color": ["get", "color"],
                  "fill-extrusion-base": ["get", "base"],
                  "fill-extrusion-height": ["get", "height"],
                  "fill-extrusion-opacity": 0.94,
                  "fill-extrusion-vertical-gradient": true
                }
              }, beforeLabels);
            }

            if (!map.getLayer("ecoraices-draft-tree-3d")) {
              map.addLayer({
                id: "ecoraices-draft-tree-3d",
                type: "fill-extrusion",
                source: "ecoraices-draft-3d-source",
                paint: {
                  "fill-extrusion-color": ["get", "color"],
                  "fill-extrusion-base": ["get", "base"],
                  "fill-extrusion-height": ["get", "height"],
                  "fill-extrusion-opacity": 0.84,
                  "fill-extrusion-vertical-gradient": true
                }
              }, beforeLabels);
            }

            if (!map.getLayer("ecoraices-trees-overview-halo")) {
              map.addLayer({
                id: "ecoraices-trees-overview-halo",
                type: "circle",
                source: "ecoraices-trees-points-source",
                paint: {
                  "circle-radius": ["interpolate", ["linear"], ["zoom"], 5, 8, 12, 12, 15.5, 14],
                  "circle-color": ["get", "dotColor"],
                  "circle-opacity": ["interpolate", ["linear"], ["zoom"], 5, 0.25, 14.2, 0.22, 15.8, 0]
                }
              });
            }

            if (!map.getLayer("ecoraices-trees-overview-dot")) {
              map.addLayer({
                id: "ecoraices-trees-overview-dot",
                type: "circle",
                source: "ecoraices-trees-points-source",
                paint: {
                  "circle-radius": ["interpolate", ["linear"], ["zoom"], 5, 5, 12, 7, 15.5, 5],
                  "circle-color": ["get", "dotColor"],
                  "circle-stroke-color": "#ffffff",
                  "circle-stroke-width": 2,
                  "circle-opacity": ["interpolate", ["linear"], ["zoom"], 5, 1, 14.5, 0.95, 16.0, 0],
                  "circle-stroke-opacity": ["interpolate", ["linear"], ["zoom"], 5, 1, 14.5, 0.95, 16.0, 0]
                }
              });
            }

            if (!map.getLayer("person-guide-glow")) {
              map.addLayer({
                id: "person-guide-glow",
                type: "line",
                source: "person-guide-source",
                layout: { "line-join": "round", "line-cap": "round" },
                paint: { "line-color": "#34d399", "line-width": 10, "line-opacity": 0.35 }
              });
            }

            if (!map.getLayer("person-guide-line")) {
              map.addLayer({
                id: "person-guide-line",
                type: "line",
                source: "person-guide-source",
                layout: { "line-join": "round", "line-cap": "round" },
                paint: {
                  "line-color": "#10b981",
                  "line-width": 4,
                  "line-dasharray": [2, 2],
                  "line-opacity": 0.95
                }
              });
            }

            // Etiquetas nativas WebGL sin superposición si el estilo tiene fuente configurada
            if (!map.getLayer("ecoraices-trees-labels") && map.getStyle()?.glyphs) {
              map.addLayer({
                id: "ecoraices-trees-labels",
                type: "symbol",
                source: "ecoraices-trees-points-source",
                minzoom: 14,
                layout: {
                  "text-field": ["get", "label"],
                  "text-font": ["Open Sans Bold"],
                  "text-size": ["interpolate", ["linear"], ["zoom"], 14, 10.5, 17, 12.5, 19, 14],
                  "text-offset": [0, 1.3],
                  "text-anchor": "top",
                  "text-allow-overlap": false,
                  "text-optional": true
                },
                paint: {
                  "text-color": ["case", ["==", ["get", "isInvasive"], 1], "#dc2626", "#065f46"],
                  "text-halo-color": "#ffffff",
                  "text-halo-width": 2
                }
              });
            }
          } catch (err) {
            console.warn("[Catastro 3D] Aviso al inicializar capas:", err);
          }
        }

        function updateSelectedRingFilter() {
          if (!map || !map.getLayer("ecoraices-trees-selected-ring")) return;
          const targetId = (personTargetEntry && personTargetEntry.treeId) || selectedTreeId || "__none__";
          map.setFilter("ecoraices-trees-selected-ring", ["==", ["get", "treeId"], targetId]);
        }

        function updatePersonGuideLine() {
          const src = map.getSource("person-guide-source");
          if (!src) return;
          if (isPersonMode && personTargetEntry && userGpsCoords) {
            src.setData({
              type: "Feature",
              geometry: {
                type: "LineString",
                coordinates: [
                  [userGpsCoords.lng, userGpsCoords.lat],
                  [personTargetEntry.lng, personTargetEntry.lat]
                ]
              },
              properties: {}
            });
          } else {
            src.setData({ type: "FeatureCollection", features: [] });
          }
        }

        function renderTreesToSources(shouldFit = false) {
          if (!styleReady) return;
          ensureCadastreLayers();
          const { extrusionFC, footprintFC, pointsFC, lookup } = buildCadastreGeoJSON(currentTrees);
          treesById = lookup;

          const s3d = map.getSource("ecoraices-trees-3d-source");
          const sFoot = map.getSource("ecoraices-trees-footprint-source");
          const sPts = map.getSource("ecoraices-trees-points-source");
          if (s3d) s3d.setData(extrusionFC);
          if (sFoot) sFoot.setData(footprintFC);
          if (sPts) sPts.setData(pointsFC);
          updateSelectedRingFilter();

          if (shouldFit) {
            fitVisibleTrees();
          }
        }

        function renderDraftTree(centerCamera = false) {
          if (!styleReady) return;
          ensureCadastreLayers();
          const sDraft3d = map.getSource("ecoraices-draft-3d-source");
          const sDraftFoot = map.getSource("ecoraices-draft-footprint-source");
          const emptyFC = { type: "FeatureCollection", features: [] };

          if (!draftTreeData || isNaN(draftTreeData.lat) || isNaN(draftTreeData.lng)) {
            if (sDraft3d) sDraft3d.setData(emptyFC);
            if (sDraftFoot) sDraftFoot.setData(emptyFC);
            return;
          }

          const profile = getTreeBotanicalProfile({ speciesName: draftTreeData.speciesName || "Ubicación" });
          const heightMeters = resolveTreeHeightMeters(draftTreeData, profile.defaultHeight);
          const { features, canopyRadius } = buildTreeExtrusionParts(
            "draft-tree",
            draftTreeData.lng,
            draftTreeData.lat,
            heightMeters,
            profile,
            true
          );

          if (sDraft3d) sDraft3d.setData({ type: "FeatureCollection", features });
          if (sDraftFoot) {
            sDraftFoot.setData({
              type: "FeatureCollection",
              features: [{
                type: "Feature",
                properties: {},
                geometry: {
                  type: "Polygon",
                  coordinates: [createCircleRing(draftTreeData.lng, draftTreeData.lat, canopyRadius * 1.25, 20)]
                }
              }]
            });
          }

          if (centerCamera) {
            map.easeTo({
              center: [draftTreeData.lng, draftTreeData.lat],
              zoom: Math.max(map.getZoom(), 17.4),
              pitch: is3DMode ? 58 : 0,
              duration: 750
            });
          }
        }

        function fitVisibleTrees() {
          const entries = Object.values(treesById);
          if (entries.length === 0) return;
          map.stop();
          if (entries.length === 1) {
            map.easeTo({
              center: [entries[0].lng, entries[0].lat],
              zoom: 17.0,
              pitch: is3DMode ? 55 : 0,
              bearing: is3DMode ? -15 : 0,
              duration: 950
            });
          } else {
            const bounds = new maplibregl.LngLatBounds();
            entries.forEach((e) => bounds.extend([e.lng, e.lat]));
            map.fitBounds(bounds, {
              padding: 75,
              maxZoom: 16.5,
              pitch: is3DMode ? 54 : 0,
              bearing: is3DMode ? -15 : 0,
              duration: 1000
            });
          }
        }

        function enterPersonMode(entry) {
          if (!entry) return;

          isPersonMode = true;
          personTargetEntry = { ...entry, treeId: String(entry.tree?.id || entry.tree?.clientId || "") };
          selectedTreeId = personTargetEntry.treeId;

          const allEntries = Object.values(treesById);
          const idx = allEntries.findIndex(
            (item) => String(item.tree?.id || item.tree?.clientId) === personTargetEntry.treeId
          );
          if (idx !== -1) activeTreeIndex = idx;

          if (activePopup) {
            activePopup.remove();
            activePopup = null;
          }

          updateSelectedRingFilter();

          const avatarLat = entry.isSelfLocation ? entry.lat : (entry.lat - 0.000075);
          const avatarLng = entry.isSelfLocation ? entry.lng : (entry.lng + 0.000045);
          const avatarText = entry.isSelfLocation ? "🚶‍♂️ Explorando desde tu GPS" : "🚶‍♂️ Frente al árbol 3D";

          if (!personAvatarMarker) {
            const pEl = document.createElement("div");
            pEl.className = "web-person-avatar";
            const badge = document.createElement("div");
            badge.className = "web-person-avatar-badge";
            badge.textContent = avatarText;
            personAvatarBadgeEl = badge;
            const circle = document.createElement("div");
            circle.className = "web-person-avatar-circle";
            circle.textContent = "🧍";
            pEl.appendChild(badge);
            pEl.appendChild(circle);

            personAvatarMarker = new maplibregl.Marker({ element: pEl, anchor: "bottom" })
              .setLngLat([avatarLng, avatarLat])
              .addTo(map);
          } else {
            personAvatarMarker.setLngLat([avatarLng, avatarLat]);
            if (personAvatarBadgeEl) personAvatarBadgeEl.textContent = avatarText;
          }

          updatePersonGuideLine();

          map.stop();
          const curCenter = map.getCenter();
          const distCam = haversineMeters(curCenter.lat, curCenter.lng, entry.lat, entry.lng);
          const camOpts = {
            center: [entry.lng, entry.lat],
            zoom: 19.0,
            pitch: 72,
            bearing: -20,
            duration: distCam > 2500 ? 1200 : 900
          };
          if (distCam > 2500) map.flyTo(camOpts);
          else map.easeTo(camOpts);

          if (personaBtn) {
            personaBtn.classList.add("is-active");
            personaBtn.setAttribute("aria-pressed", "true");
          }
          if (personHudEl && personHudTextEl) {
            personHudTextEl.textContent = `MODO PERSONA 3D • ${(entry.profile?.displayName || "ÁRBOL").toUpperCase()}`;
            personHudEl.hidden = false;
          }
          if (personCard) {
            const distToUser = userGpsCoords
              ? (entry.isSelfLocation ? 0 : haversineMeters(userGpsCoords.lat, userGpsCoords.lng, entry.lat, entry.lng))
              : null;
            if (personDistEl) personDistEl.textContent = formatDistance(distToUser);
            if (personSeqEl) {
              personSeqEl.textContent = entry.isSelfLocation
                ? "EXPLORACIÓN EN TU GPS"
                : `ÁRBOL #${activeTreeIndex + 1} DE ${Math.max(1, allEntries.length)}`;
            }
            if (personTitleEl) {
              personTitleEl.textContent = `🚶‍♂️ ${entry.profile?.displayName || "Árbol Seleccionado"}`;
            }
            if (personSubEl) {
              const muni = entry.tree?.municipio || entry.tree?.municipality || "Territorio GPS";
              personSubEl.textContent = `Vista 3D (72°) • 📏 ${Number(entry.heightMeters || 8).toFixed(1)}m • 🏛️ ${muni}`;
            }
            personCard.hidden = false;
          }
        }

        function exitPersonMode(skipCameraReset = false) {
          isPersonMode = false;
          personTargetEntry = null;
          selectedTreeId = null;

          if (personAvatarMarker) {
            personAvatarMarker.remove();
            personAvatarMarker = null;
            personAvatarBadgeEl = null;
          }
          updateSelectedRingFilter();
          updatePersonGuideLine();

          if (personaBtn) {
            personaBtn.classList.remove("is-active");
            personaBtn.setAttribute("aria-pressed", "false");
          }
          if (personHudEl) personHudEl.hidden = true;
          if (personCard) personCard.hidden = true;

          if (!skipCameraReset) {
            map.stop();
            map.easeTo({
              pitch: is3DMode ? 54 : 0,
              zoom: 16.0,
              bearing: is3DMode ? -15 : 0,
              duration: 900
            });
          }
        }

        function pickBestTreeForPersonMode() {
          const allEntries = Object.values(treesById);
          if (selectedTreeId && treesById[selectedTreeId]) return treesById[selectedTreeId];
          if (allEntries.length === 0) return null;

          if (userGpsCoords) {
            let nearest = null;
            let minDist = Infinity;
            allEntries.forEach((entry) => {
              const d = haversineMeters(userGpsCoords.lat, userGpsCoords.lng, entry.lat, entry.lng);
              if (d < minDist) {
                minDist = d;
                nearest = entry;
              }
            });
            if (nearest) return nearest;
          }
          return allEntries[activeTreeIndex] || allEntries[0];
        }

        function updateUserGps(lat, lng, label = "", focusCamera = false) {
          userGpsCoords = { lat, lng, label };
          const badgeText = label ? `📍 Tú • ${label}` : "📍 Tú (GPS)";

          if (!userGpsMarker) {
            const wrap = document.createElement("div");
            wrap.className = "web-user-gps-marker";
            const lbl = document.createElement("div");
            lbl.className = "web-user-gps-label";
            lbl.textContent = badgeText;
            userGpsLabelEl = lbl;
            const dot = document.createElement("div");
            dot.className = "web-user-gps-dot";
            wrap.appendChild(lbl);
            wrap.appendChild(dot);

            userGpsMarker = new maplibregl.Marker({ element: wrap, anchor: "bottom" })
              .setLngLat([lng, lat])
              .addTo(map);
          } else {
            userGpsMarker.setLngLat([lng, lat]);
            if (userGpsLabelEl) userGpsLabelEl.textContent = badgeText;
          }

          if (gpsBtn) gpsBtn.classList.add("is-ready");

          if (focusCamera) {
            if (isPersonMode) exitPersonMode(true);
            map.stop();
            map.easeTo({
              center: [lng, lat],
              zoom: 17.0,
              pitch: is3DMode ? 56 : 0,
              bearing: is3DMode ? -15 : 0,
              duration: 950
            });
          } else {
            updatePersonGuideLine();
          }
        }

        async function requestBrowserGps() {
          if (!navigator.geolocation) {
            showToast("Tu navegador no soporta geolocalización GPS.", "error");
            return null;
          }
          showToast("📡 Obteniendo ubicación GPS...", "info");
          try {
            const pos = await new Promise((resolve, reject) => {
              navigator.geolocation.getCurrentPosition(resolve, reject, {
                enableHighAccuracy: true,
                timeout: 8000,
                maximumAge: 15000
              });
            });
            const lat = pos.coords.latitude;
            const lng = pos.coords.longitude;
            updateUserGps(lat, lng, userGpsCoords?.label || "", true);

            const resolved = await reverseGeocodeNominatim(lat, lng);
            if (resolved) {
              updateUserGps(lat, lng, resolved.label, false);
              showToast(`📍 Ubicación detectada: ${resolved.label}`, "success");
            } else {
              showToast(`📍 GPS fijado (${lat.toFixed(4)}, ${lng.toFixed(4)})`, "success");
            }

            el.dispatchEvent(new CustomEvent("gps-location-updated", {
              detail: {
                lat,
                lng,
                municipio: resolved?.municipio || "",
                label: resolved?.label || `${lat.toFixed(4)}, ${lng.toFixed(4)}`
              },
              bubbles: true
            }));

            return { lat, lng, resolved };
          } catch {
            showToast("No se pudo obtener el GPS. Verifica los permisos de ubicación.", "error");
            return null;
          }
        }

        function openTreePopup(treeId) {
          const entry = treesById[treeId];
          if (!entry) return;
          selectedTreeId = treeId;
          updateSelectedRingFilter();

          if (activePopup) {
            activePopup.remove();
            activePopup = null;
          }

          const node = createPopupElement(
            entry,
            enableCadastreTools ? (targetEntry) => enterPersonMode(targetEntry) : null
          );

          activePopup = new maplibregl.Popup({
            offset: [0, -14],
            className: "ecoraices-map-popup",
            maxWidth: "330px"
          })
            .setLngLat([entry.lng, entry.lat])
            .setDOMContent(node)
            .addTo(map);

          activePopup.on("close", () => {
            if (!isPersonMode) {
              selectedTreeId = null;
              updateSelectedRingFilter();
            }
          });
        }

        // Control 2D / 3D
        if (toggle3dBtn) {
          toggle3dBtn.addEventListener("click", () => {
            is3DMode = !is3DMode;
            if (isPersonMode) exitPersonMode(true);
            map.stop();
            map.easeTo({
              pitch: is3DMode ? 54 : 0,
              bearing: is3DMode ? -18 : 0,
              duration: 900
            });
            toggle3dBtn.classList.toggle("active-3d", is3DMode);
            toggle3dBtn.setAttribute("aria-pressed", is3DMode ? "true" : "false");
            const textSpan = toggle3dBtn.querySelector(".perspective-text");
            if (textSpan) textSpan.textContent = is3DMode ? "2D" : "3D";
            const iconSpan = toggle3dBtn.querySelector(".perspective-icon");
            if (iconSpan) iconSpan.textContent = is3DMode ? "🗺️" : "🌐";
          });
        }

        if (gpsBtn) {
          gpsBtn.addEventListener("click", () => {
            requestBrowserGps();
          });
        }

        if (personaBtn) {
          personaBtn.addEventListener("click", () => {
            if (isPersonMode) {
              exitPersonMode(false);
              return;
            }
            const target = pickBestTreeForPersonMode();
            if (target) {
              enterPersonMode(target);
              return;
            }
            if (userGpsCoords) {
              enterPersonMode({
                lat: userGpsCoords.lat,
                lng: userGpsCoords.lng,
                heightMeters: 8,
                isSelfLocation: true,
                tree: { id: "self-gps", municipio: userGpsCoords.label || "Tu ubicación GPS" },
                profile: { displayName: "Tu ubicación GPS" }
              });
              return;
            }
            showToast("Presiona 'Mi GPS' o selecciona un árbol para activar el Modo Persona 3D.", "info");
          });
        }

        const stepPersonTree = (delta) => {
          const allEntries = Object.values(treesById);
          if (allEntries.length === 0) return;
          activeTreeIndex = (activeTreeIndex + delta + allEntries.length) % allEntries.length;
          enterPersonMode(allEntries[activeTreeIndex]);
        };

        if (personPrevBtn) personPrevBtn.addEventListener("click", () => stepPersonTree(-1));
        if (personNextBtn) personNextBtn.addEventListener("click", () => stepPersonTree(1));
        if (personOrbitBtn) {
          personOrbitBtn.addEventListener("click", () => {
            if (!personTargetEntry) return;
            map.stop();
            map.easeTo({
              center: [personTargetEntry.lng, personTargetEntry.lat],
              zoom: 19.0,
              pitch: 72,
              bearing: map.getBearing() + 72,
              duration: 800
            });
          });
        }
        if (personExitBtn) personExitBtn.addEventListener("click", () => exitPersonMode(false));

        // Leyenda colapsable
        if (legendToggle && legendPanel) {
          legendToggle.addEventListener("click", () => {
            const open = legendPanel.classList.toggle("is-open");
            legendToggle.setAttribute("aria-expanded", open ? "true" : "false");
          });
        }

        // Click unificado en WebGL (modo community picker cuando !readOnly, o selección de árbol 3D)
        map.on("click", (e) => {
          const lat = e.lngLat.lat;
          const lng = e.lngLat.lng;

          if (!readOnly) {
            if (coordsDisplay) {
              coordsDisplay.textContent = `📍 Lat: ${lat.toFixed(6)} | Lng: ${lng.toFixed(6)}`;
              coordsDisplay.style.display = "block";
            }
            draftTreeData = { lat, lng, heightMeters: 8, speciesName: "Ubicación" };
            renderDraftTree(false);
            el.dispatchEvent(new CustomEvent("location-selected", {
              detail: { lat, lng },
              bubbles: true
            }));
            return;
          }

          const existingLayers = INTERACTIVE_TREE_LAYERS.filter((layerId) => Boolean(map.getLayer(layerId)));
          if (existingLayers.length === 0) return;
          const hits = map.queryRenderedFeatures(e.point, { layers: existingLayers });
          if (hits && hits.length > 0) {
            const hitTreeId = hits[0].properties?.treeId;
            if (hitTreeId && treesById[hitTreeId]) {
              openTreePopup(hitTreeId);
            }
          }
        });

        map.on("mousemove", (e) => {
          if (!readOnly) {
            map.getCanvas().style.cursor = "pointer";
            return;
          }
          const existingLayers = INTERACTIVE_TREE_LAYERS.filter((layerId) => Boolean(map.getLayer(layerId)));
          if (existingLayers.length === 0) return;
          const hits = map.queryRenderedFeatures(e.point, { layers: existingLayers });
          map.getCanvas().style.cursor = hits && hits.length > 0 ? "pointer" : "";
        });

        // Inicialización de capas WebGL al cargar estilo
        const onStyleReady = () => {
          styleReady = true;
          ensureCadastreLayers();
          renderTreesToSources(currentTrees.length > 0);
          if (interactiveMarkerData && !readOnly) {
            const lng = parseFloat(interactiveMarkerData.lng ?? interactiveMarkerData[0]);
            const lat = parseFloat(interactiveMarkerData.lat ?? interactiveMarkerData[1]);
            if (!isNaN(lat) && !isNaN(lng)) {
              if (coordsDisplay) {
                coordsDisplay.textContent = `📍 Lat: ${lat.toFixed(6)} | Lng: ${lng.toFixed(6)}`;
                coordsDisplay.style.display = "block";
              }
              draftTreeData = { lat, lng, heightMeters: 8, speciesName: "Ubicación" };
              renderDraftTree(true);
            }
          } else if (draftTreeData) {
            renderDraftTree(false);
          }
          updatePersonGuideLine();
        };

        map.on("style.load", onStyleReady);
        map.on("load", () => {
          if (!styleReady) onStyleReady();
        });

        // Bridge de eventos externos desde ObservationsMap u otros componentes
        el.addEventListener("update-markers", (e) => {
          const { newMarkers, shouldFit = true } = e.detail || {};
          if (Array.isArray(newMarkers)) {
            currentTrees = newMarkers;
            renderTreesToSources(Boolean(shouldFit));
          }
        });

        el.addEventListener("trigger-gps", () => {
          requestBrowserGps();
        });

        el.addEventListener("fit-trees", () => {
          fitVisibleTrees();
        });
      }
    });
  });
</script>
