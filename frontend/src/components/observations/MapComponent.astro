---
// frontend/src/components/observations/MapComponent.astro
import { MAP_API_URL, MAPLIBRE_CSS, MAPLIBRE_JS } from "../../lib/constants.js";
const {
  id = "map-container",
  center = [-72.9068, 11.5448], // Centrado en La Guajira por defecto
  zoom = 6,
  markers = [],
  readOnly = false,
  interactiveMarker = null,
  height = "560px",
  enableCadastreTools = false,
  initial3D = false
} = Astro.props;
---

<div class="map-system-container light-theme-map" style={`--map-height: ${height};`}>
  <!-- Map Canvas -->
  <div
    id={id}
    class="astro-map"
    data-center={JSON.stringify(center)}
    data-zoom={zoom}
    data-markers={JSON.stringify(markers)}
    data-readonly={readOnly.toString()}
    data-interactive={interactiveMarker ? JSON.stringify(interactiveMarker) : ""}
    data-cadastre-tools={enableCadastreTools.toString()}
    data-initial-3d={initial3D.toString()}
  ></div>

  <!-- Top-Left Status Toast & Modo Persona HUD -->
  <div id={`${id}-status-toast`} class="map-status-toast" role="status" aria-live="polite" hidden></div>

  <div id={`${id}-person-hud`} class="map-person-hud" hidden>
    <span class="person-hud-dot" aria-hidden="true"></span>
    <span id={`${id}-person-hud-text`}>MODO PERSONA 3D • CATASTRO ARBÓREO</span>
  </div>

  <!-- Top Floating Controls: Catastro 3D Cockpit -->
  <div class="map-floating-top-controls">
    {enableCadastreTools && (
      <button
        type="button"
        id={`${id}-btn-gps`}
        class="map-tool-btn map-tool-gps"
        title="Centrar mapa en mi ubicación GPS actual"
      >
        <span aria-hidden="true">📍</span>
        <span class="tool-label">Mi GPS</span>
      </button>
    )}

    <button
      type="button"
      id={`${id}-toggle-3d`}
      class={`map-perspective-btn ${initial3D ? 'active-3d' : ''}`}
      title="Alternar perspectiva 2D cenital y 3D isométrica"
      aria-label="Cambiar vista 2D o 3D"
      aria-pressed={initial3D ? "true" : "false"}
    >
      <span class="perspective-icon" aria-hidden="true">{initial3D ? '🗺️' : '🌐'}</span>
      <span class="perspective-text">{initial3D ? '2D' : '3D'}</span>
      <span class="perspective-badge">VISTA</span>
    </button>

    {enableCadastreTools && (
      <button
        type="button"
        id={`${id}-btn-persona`}
        class="map-tool-btn map-tool-persona"
        title="Explorar al pie de los árboles en Modo Persona 3D"
        aria-pressed="false"
      >
        <span aria-hidden="true">🚶</span>
        <span class="tool-label">Persona</span>
      </button>
    )}
  </div>

  <!-- Floating Bottom Cockpit: Modo Persona 3D -->
  {enableCadastreTools && (
    <div id={`${id}-person-card`} class="person-mode-card" hidden>
      <div class="person-meta-row">
        <span id={`${id}-person-distance`} class="person-distance-pill">En territorio</span>
        <span id={`${id}-person-seq`} class="person-seq-label">ÁRBOL #1</span>
        <div class="person-nav-arrows">
          <button type="button" id={`${id}-person-prev`} class="person-step-btn" aria-label="Árbol anterior" title="Árbol anterior">‹</button>
          <button type="button" id={`${id}-person-next`} class="person-step-btn" aria-label="Siguiente árbol" title="Siguiente árbol">›</button>
        </div>
      </div>

      <div class="person-title-row">
        <span class="person-live-dot" aria-hidden="true"></span>
        <div class="person-title-wrap">
          <strong id={`${id}-person-title`} class="person-title">Árbol Seleccionado</strong>
          <span id={`${id}-person-sub`} class="person-sub">Vista en Persona 3D (72°)</span>
        </div>
      </div>

      <div class="person-actions-row">
        <button type="button" id={`${id}-person-orbit`} class="person-orbit-btn">
          ↻ Girar 360°
        </button>
        <button type="button" id={`${id}-person-exit`} class="person-exit-btn">
          ✕ Salir a Vista Aérea
        </button>
      </div>
    </div>
  )}

  <!-- Bottom Right Collapsible Minimalist Legend -->
  <div class="map-floating-legend-container" id={`${id}-legend-container`}>
    <div class="legend-panel-minimal" id={`${id}-legend-panel`}>
      <button
        type="button"
        class="legend-toggle-btn"
        id={`${id}-legend-toggle`}
        aria-label="Ver leyenda botánica"
        aria-expanded="false"
        title="Mostrar / ocultar convenciones de especies"
      >
        <span class="legend-icon" aria-hidden="true">🌿</span>
        <span class="legend-btn-text">Leyenda 3D</span>
        <span class="legend-arrow" id={`${id}-legend-arrow`} aria-hidden="true">▾</span>
      </button>

      <div class="legend-content-chips" id={`${id}-legend-content`}>
        <div class="legend-chip chip-neem" title="Especie Invasora de Alto Impacto (Alelopatía)">
          <span class="legend-dot dot-red"></span>
          <span class="legend-label">🚨 Neem (Invasor • Alelopatía)</span>
        </div>
        <div class="legend-chip chip-trupillo" title="Nativa Resiliente del Bosque Seco Guajiro">
          <span class="legend-dot dot-emerald"></span>
          <span class="legend-label">🌿 Trupillo (Nativo)</span>
        </div>
        <div class="legend-chip chip-guayacan" title="Especie Nativa en Floración">
          <span class="legend-dot dot-yellow"></span>
          <span class="legend-label">🌸 Guayacán (Floración)</span>
        </div>
        <div class="legend-chip chip-dividivi" title="Especie Ancestral y Medicinal">
          <span class="legend-dot dot-teal"></span>
          <span class="legend-label">🍃 Dividivi (Ancestral)</span>
        </div>
        <div class="legend-chip chip-cardon" title="Cactácea Xerófila Guajira">
          <span class="legend-dot dot-cyan"></span>
          <span class="legend-label">🌵 Cardón Guajiro</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Minimalist Coords Display (Bottom Left) -->
  <div
    id={`${id}-coords`}
    class="map-coords-badge"
    style="display: none;"
  ></div>
</div>

<link rel="stylesheet" href={MAPLIBRE_CSS} />

<style>
  .map-system-container {
    position: relative;
    width: 100%;
    min-width: 0;
    height: 100%;
    min-height: var(--map-height, 560px);
    isolation: isolate;
    background: #f8fafc;
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.08);
  }

  .astro-map {
    width: 100%;
    height: 100%;
    min-height: var(--map-height, 560px);
    border-radius: 16px;
    overflow: hidden;
  }

  /* Status Toast & Person HUD */
  .map-status-toast {
    position: absolute;
    top: 14px;
    left: 14px;
    max-width: min(360px, calc(100% - 28px));
    background: rgba(15, 23, 42, 0.92);
    color: #f8fafc;
    font-size: 12px;
    font-weight: 700;
    padding: 8px 13px;
    border-radius: 10px;
    z-index: 25;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.22);
    backdrop-filter: blur(8px);
  }

  .map-status-toast.tone-success {
    background: rgba(6, 95, 70, 0.94);
  }

  .map-status-toast.tone-error {
    background: rgba(185, 28, 28, 0.94);
  }

  .map-person-hud {
    position: absolute;
    top: 14px;
    left: 14px;
    background: rgba(6, 78, 59, 0.94);
    color: #ecfdf5;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.04em;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 1px solid rgba(52, 211, 153, 0.45);
    box-shadow: 0 6px 18px rgba(6, 78, 59, 0.35);
    z-index: 15;
    max-width: calc(100% - 28px);
  }

  .map-person-hud[hidden],
  .map-status-toast[hidden],
  .person-mode-card[hidden] {
    display: none !important;
  }

  .person-hud-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 8px #34d399;
    flex-shrink: 0;
  }

  /* Top Right Floating Controls */
  .map-floating-top-controls {
    position: absolute;
    top: 14px;
    right: 54px;
    z-index: 14;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 7px;
    align-items: center;
    max-width: calc(100% - 68px);
  }

  .map-tool-btn,
  .map-perspective-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #0f172a;
    border: 1px solid rgba(15, 23, 42, 0.12);
    padding: 6px 12px;
    border-radius: 9999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.01em;
    cursor: pointer;
    box-shadow: 0 2px 10px rgba(15, 23, 42, 0.09);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    user-select: none;
    white-space: nowrap;
  }

  .map-tool-btn:hover,
  .map-perspective-btn:hover {
    background: #ffffff;
    border-color: #10b981;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(16, 185, 129, 0.2);
  }

  .map-tool-btn:focus-visible,
  .map-perspective-btn:focus-visible,
  .legend-toggle-btn:focus-visible,
  .person-step-btn:focus-visible,
  .person-orbit-btn:focus-visible,
  .person-exit-btn:focus-visible {
    outline: 2px solid #0284c7;
    outline-offset: 2px;
  }

  .map-tool-add {
    background: #f0f9ff;
    border-color: #7dd3fc;
    color: #0369a1;
  }

  .map-tool-add.is-active {
    background: #0284c7;
    border-color: #0369a1;
    color: #ffffff;
    box-shadow: 0 0 14px rgba(2, 132, 199, 0.38);
  }

  .map-tool-gps.is-ready {
    border-color: #86efac;
    color: #065f46;
  }

  .map-tool-persona.is-active {
    background: #059669;
    border-color: #047857;
    color: #ffffff;
    box-shadow: 0 0 14px rgba(5, 150, 105, 0.38);
  }

  .map-perspective-btn.active-3d {
    background: #064e3b;
    border-color: #059669;
    color: #34d399;
    box-shadow: 0 0 14px rgba(16, 185, 129, 0.32);
  }

  .perspective-badge {
    font-size: 9px;
    padding: 2px 6px;
    background: rgba(0, 0, 0, 0.06);
    border-radius: 4px;
    color: #64748b;
    font-weight: 700;
  }

  .active-3d .perspective-badge {
    background: rgba(16, 185, 129, 0.25);
    color: #6ee7b7;
  }

  /* Floating Person Mode Cockpit Card */
  .person-mode-card {
    position: absolute;
    bottom: 18px;
    left: 50%;
    transform: translateX(-50%);
    width: min(440px, calc(100% - 28px));
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(12px);
    border: 1.5px solid #10b981;
    border-radius: 16px;
    padding: 13px 15px;
    box-shadow: 0 14px 34px rgba(15, 23, 42, 0.24);
    z-index: 22;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .person-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .person-distance-pill {
    background: #065f46;
    color: #ffffff;
    font-size: 10px;
    font-weight: 800;
    padding: 3px 9px;
    border-radius: 999px;
  }

  .person-seq-label {
    font-size: 10px;
    font-weight: 800;
    color: #475569;
    letter-spacing: 0.04em;
  }

  .person-nav-arrows {
    display: inline-flex;
    gap: 6px;
  }

  .person-step-btn {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    color: #065f46;
    font-size: 16px;
    font-weight: 800;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .person-step-btn:hover {
    background: #d1fae5;
  }

  .person-title-row {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .person-live-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.7);
    flex-shrink: 0;
  }

  .person-title-wrap {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .person-title {
    font-size: 14px;
    font-weight: 800;
    color: #0f172a;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .person-sub {
    font-size: 11px;
    color: #64748b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .person-actions-row {
    display: flex;
    gap: 10px;
  }

  .person-orbit-btn,
  .person-exit-btn {
    flex: 1;
    border-radius: 10px;
    padding: 8px 10px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .person-orbit-btn {
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    color: #065f46;
  }

  .person-orbit-btn:hover {
    background: #d1fae5;
  }

  .person-exit-btn {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #dc2626;
  }

  .person-exit-btn:hover {
    background: #fee2e2;
  }

  /* Bottom Right Minimalist Collapsible Legend */
  .map-floating-legend-container {
    position: absolute;
    bottom: 34px;
    right: 12px;
    z-index: 12;
    max-width: calc(100% - 24px);
  }

  .legend-panel-minimal {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    padding: 6px;
    transition: all 0.25s ease;
    max-width: 100%;
  }

  .legend-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    color: #0f172a;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 8px;
  }

  .legend-toggle-btn:hover {
    background: rgba(0, 0, 0, 0.04);
  }

  .legend-arrow {
    font-size: 10px;
    transition: transform 0.25s ease;
    color: #64748b;
  }

  .legend-panel-minimal.is-open .legend-arrow {
    transform: rotate(180deg);
  }

  .legend-content-chips {
    display: none;
    flex-direction: column;
    gap: 6px;
    padding-top: 8px;
    margin-top: 4px;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    width: 100%;
  }

  .legend-panel-minimal.is-open .legend-content-chips {
    display: flex;
  }

  .legend-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 600;
    color: #334155;
    padding: 4px 8px;
    border-radius: 6px;
    background: #f8fafc;
    border: 1px solid rgba(0, 0, 0, 0.04);
    white-space: nowrap;
  }

  .legend-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .dot-red { background-color: #ef4444; box-shadow: 0 0 5px rgba(239, 68, 68, 0.6); }
  .dot-emerald { background-color: #10b981; box-shadow: 0 0 5px rgba(16, 185, 129, 0.6); }
  .dot-yellow { background-color: #eab308; box-shadow: 0 0 5px rgba(234, 179, 8, 0.6); }
  .dot-teal { background-color: #0d9488; box-shadow: 0 0 5px rgba(13, 148, 136, 0.6); }
  .dot-cyan { background-color: #1e3a8a; box-shadow: 0 0 5px rgba(30, 58, 138, 0.5); }

  /* Coords Display (Bottom Left) */
  .map-coords-badge {
    position: absolute;
    bottom: 34px;
    left: 12px;
    max-width: calc(100% - 24px);
    background: rgba(255, 255, 255, 0.94);
    color: #0f172a;
    padding: 5px 10px;
    border-radius: 8px;
    font-size: 11px;
    font-family: monospace;
    border: 1px solid rgba(0, 0, 0, 0.08);
    backdrop-filter: blur(8px);
    pointer-events: none;
    z-index: 10;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  @media (max-width: 768px) {
    .map-system-container,
    .astro-map {
      min-height: min(var(--map-height, 560px), 68dvh);
    }
  }

  @media (max-width: 640px) {
    .map-floating-top-controls {
      right: 46px;
      top: 10px;
      max-width: calc(100% - 56px);
      gap: 5px;
    }
    .map-tool-btn,
    .map-perspective-btn {
      padding: 5px 9px;
      font-size: 11px;
    }
    .perspective-badge {
      display: none;
    }
    .map-floating-legend-container {
      bottom: 32px;
      right: 10px;
      max-width: calc(100% - 20px);
    }
    .legend-chip {
      white-space: normal;
    }
    .map-coords-badge {
      bottom: 32px;
      left: 10px;
      font-size: 10px;
    }
  }
</style>

<!-- Estilos globales para Popups del Catastro 3D, Marcador GPS y Avatar Persona -->
<style is:global>
  .ecoraices-map-popup .maplibregl-popup-content {
    background: #ffffff !important;
    color: #0f172a !important;
    border-radius: 14px;
    padding: 0;
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.2) !important;
    border: 1px solid #e2e8f0 !important;
    overflow: hidden;
    max-width: min(325px, calc(100vw - 44px));
    font-family: inherit;
  }

  .ecoraices-map-popup .maplibregl-popup-close-button {
    color: #64748b;
    font-size: 18px;
    padding: 6px 10px;
    right: 4px;
    top: 4px;
    z-index: 10;
  }

  .ecoraices-map-popup .maplibregl-popup-close-button:hover {
    color: #0f172a;
    background: transparent;
  }

  .popup-tree-card {
    padding: 13px;
    display: flex;
    flex-direction: column;
    gap: 9px;
    background: #ffffff;
  }

  .popup-tree-card.is-invasive {
    border-top: 4px solid #ef4444;
  }

  .popup-tree-card.is-native {
    border-top: 4px solid #10b981;
  }

  .popup-thumb-img {
    width: 100%;
    height: 112px;
    object-fit: cover;
    border-radius: 8px;
    display: block;
    background: #f1f5f9;
  }

  .popup-card-header {
    display: flex;
    align-items: flex-start;
    gap: 9px;
  }

  .popup-header-icon {
    font-size: 22px;
    line-height: 1;
  }

  .popup-card-header h4 {
    margin: 0;
    font-size: 14.5px;
    font-weight: 800;
    color: #0f172a;
  }

  .popup-species-scientific {
    font-size: 11.5px;
    font-style: italic;
    color: #64748b;
    margin: 2px 0 0 0;
  }

  .popup-badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 4px;
  }

  .badge-category-alert {
    display: inline-block;
    font-size: 9.5px;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 4px;
    text-transform: uppercase;
  }

  .badge-danger-alert {
    background: #fee2e2;
    color: #b91c1c;
  }

  .badge-native-success {
    background: #d1fae5;
    color: #065f46;
  }

  .badge-cadastre-3d {
    background: #e0f2fe;
    color: #0369a1;
  }

  .cadastre-metrics-row {
    display: flex;
    gap: 6px;
  }

  .cadastre-metric-pill {
    flex: 1;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 7px;
    padding: 5px 8px;
    font-size: 11px;
    font-weight: 700;
    color: #334155;
    text-align: center;
  }

  .allelopathy-box {
    background: #fff1f2;
    border: 1px solid #fecdd3;
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 11px;
    line-height: 1.4;
    color: #9f1239;
  }

  .native-value-box {
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.22);
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 11px;
    line-height: 1.4;
    color: #065f46;
  }

  .substitution-block {
    background: #f8fafc;
    border-radius: 8px;
    padding: 8px 10px;
    border: 1px solid #e2e8f0;
  }

  .substitution-title {
    font-size: 11px;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 6px 0;
  }

  .substitution-options {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }

  .sub-option-item {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 4px 6px;
    text-align: center;
    display: flex;
    flex-direction: column;
