---
// frontend/src/components/observations/NewObservationForm.astro
const { categories = [], speciesList = [], communities = [], userId } = Astro.props;
---

<div class="quick-form-container">
  <!-- Barra de sincronización offline -->
  <div id="offline-sync-bar" class="offline-sync-bar" style="display: none;">
    <div class="offline-bar-content">
      <span class="offline-icon">📶</span>
      <span id="offline-bar-text">3 árboles guardados localmente (sin conexión)</span>
    </div>
    <button type="button" id="btn-sync-offline-now" class="btn-sync-offline">
      Sincronizar ahora
    </button>
  </div>

  <div id="alert-success" class="quick-alert success" role="alert" style="display: none;"></div>
  <div id="alert-error" class="quick-alert error" role="alert" style="display: none;"></div>

  <form id="observation-form" class="quick-form" novalidate>
    <input type="hidden" id="userId" name="userId" value={userId} />
    <input type="hidden" id="latitude" name="latitude" />
    <input type="hidden" id="longitude" name="longitude" />
    <input type="hidden" id="estadoFitosanitario" name="estadoFitosanitario" value="Sano y vigoroso" />

    <!-- ========================================== -->
    <!-- TARJETA 1: UBICACIÓN ACTUAL                -->
    <!-- ========================================== -->
    <div class="quick-card location-card">
      <div class="card-header">
        <div class="header-icon-badge">📍</div>
        <div>
          <h2 class="card-title">Ubicación Actual</h2>
          <span class="card-subtitle">Georreferenciación GPS en campo</span>
        </div>
      </div>

      <div class="coords-display-box">
        <div class="coord-pill">
          <span class="coord-tag">Lat:</span>
          <span id="display-lat" class="coord-val">--.------</span>
        </div>
        <div class="coord-pill">
          <span class="coord-tag">Lng:</span>
          <span id="display-lng" class="coord-val">--.------</span>
        </div>
        <span id="gps-status-indicator" class="gps-status-badge waiting">
          Buscando satélites...
        </span>
      </div>

      <div class="location-btn-row">
        <button type="button" id="btn-where-am-i" class="btn-location">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <circle cx="12" cy="12" r="10"/>
            <polygon points="12 2 12 6 12 18 12 22"/>
            <polygon points="2 12 6 12 18 12 22 12"/>
          </svg>
          ¿Dónde estoy?
        </button>
        <button type="button" id="btn-toggle-map" class="btn-map-toggle">
          🗺️ Ajustar en mapa
        </button>
      </div>

      <!-- Mapa colapsable opcional (cero scroll por defecto) -->
      <div id="map-drawer" class="map-drawer" style="display: none;">
        <div id="quick-map" class="drawer-map"></div>
        <span class="map-hint">Toca en el mapa para ajustar manualmente la coordenada del árbol.</span>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- TARJETA 2: DATOS DEL ÁRBOL                 -->
    <!-- ========================================== -->
    <div class="quick-card data-card">
      <!-- Campo Especie / Nombre Comunitario -->
      <div class="form-item">
        <label for="speciesInput" class="item-label">
          <span class="item-label-icon">🌱</span> Especie o Nombre Común <span class="req">*</span>
        </label>
        <div class="input-shell">
          <input 
            type="text" 
            id="speciesInput" 
            name="speciesInput"
            class="item-input" 
            placeholder="Ej. Trupillo, Guayacán, Ceiba, Olleto..."
            autocomplete="off"
            list="species-presets"
            required
          />
        </div>
        <datalist id="species-presets">
          {speciesList.slice(0, 50).map((sp) => (
            <option value={sp.name}>{sp.scientificName ? `(${sp.scientificName})` : ''}</option>
          ))}
        </datalist>
      </div>

      <!-- Campo Municipio -->
      <div class="form-item">
        <label for="municipioInput" class="item-label">
          <span class="item-label-icon">📍</span> Municipio o Sector <span class="req">*</span>
        </label>
        <div class="input-shell">
          <input 
            type="text" 
            id="municipioInput" 
            name="municipioInput"
            class="item-input" 
            list="municipios-list"
            placeholder="Seleccione o escriba un municipio"
            required
          />
        </div>
        <datalist id="municipios-list">
          <option value="Riohacha" />
          <option value="Dibulla" />
          <option value="Manaure" />
          <option value="Maicao" />
          <option value="San Juan del Cesar" />
          <option value="Fonseca" />
          <option value="Barrancas" />
          <option value="Albania" />
          <option value="Hatonuevo" />
          <option value="Villanueva" />
          <option value="Uribia" />
          <option value="Distracción" />
        </datalist>
      </div>

      <!-- Botón para desplegar opciones secundarias -->
      <div class="extra-toggle-wrap">
        <button type="button" id="btn-toggle-extra" class="btn-extra-pill">
          <span class="pill-icon">✨</span>
          <span id="extra-btn-text">Opciones adicionales (Foto, Salud, Notas)</span>
          <span class="pill-arrow" id="extra-arrow">▾</span>
        </button>
      </div>

      <!-- Sección secundaria estilizada con componentes pulidos -->
      <div id="extra-fields" class="extra-fields-panel" style="display: none;">
        
        <!-- Foto Rápida con botón estilizado y Thumbnail Preview -->
        <div class="form-item">
          <span class="item-label-mini">📷 Fotografía del Árbol</span>
          <div class="photo-uploader-box">
            <input type="file" id="quick-image" accept="image/*" class="file-hidden-input" />
            <div id="photo-placeholder-btn" class="photo-btn-styled">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                <circle cx="12" cy="13" r="4"/>
              </svg>
              <span>Tomar foto o subir imagen</span>
            </div>

            <!-- Preview miniatura -->
            <div id="photo-preview-wrap" class="photo-preview-thumb" style="display: none;">
              <img id="thumb-img" src="" alt="Thumbnail" />
              <div class="thumb-info">
                <span id="thumb-name" class="thumb-filename">foto.jpg</span>
                <button type="button" id="btn-remove-thumb" class="btn-remove-thumb">✕ Quitar</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Chips de Salud Fitosanitaria en 1 toque -->
        <div class="form-item">
          <span class="item-label-mini">🌿 Condición de Salud</span>
          <div class="health-chips-row">
            <button type="button" class="mini-chip active" data-health="Sano y vigoroso">
              🌳 Sano
            </button>
            <button type="button" class="mini-chip" data-health="Con floración o frutos">
              🌸 Flores/Fruto
            </button>
            <button type="button" class="mini-chip" data-health="Dañado o talado">
              🪓 Dañado
            </button>
            <button type="button" class="mini-chip" data-health="Seco o con plaga">
              🍂 Seco/Plaga
            </button>
          </div>
        </div>

        <!-- Comunidad Enlazada -->
        {communities && communities.length > 0 && (
          <div class="form-item">
            <label for="quick-community" class="item-label-mini">
              👥 Comunidad del Sector
            </label>
            <select id="quick-community" class="item-select">
              <option value="">-- Sin comunidad específica --</option>
              {communities.map((c) => (
                <option value={c.id}>{c.name} {c.location ? `(${c.location})` : ''}</option>
              ))}
            </select>
          </div>
        )}

        <!-- Notas Breves -->
        <div class="form-item">
          <label for="quick-notes" class="item-label-mini">
            📝 Notas breves de campo
          </label>
          <input 
            type="text" 
            id="quick-notes" 
            class="item-input input-compact" 
            placeholder="Ej. Altura 6m, cerca a la quebrada, tronco espinoso..."
          />
        </div>
      </div>

      <!-- Botón Enviar Principal con estilo EcoRaíces -->
      <button type="submit" id="submit-btn" class="btn-send-ecoraices">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span>Enviar Registro</span>
      </button>

      <!-- Modo ráfaga continua para 100 árboles -->
      <label class="continuous-mode-toggle">
        <input type="checkbox" id="continuous-mode" checked />
        <span>⚡ Modo ráfaga: registrar y continuar con el siguiente árbol</span>
      </label>
    </div>
  </form>
</div>

<link rel="stylesheet" href="https://unpkg.com/maplibre-gl@3.6.2/dist/maplibre-gl.css" />

<style>
  .quick-form-container {
    width: 100%;
    margin: 0 auto;
  }

  .quick-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Alertas */
  /* Barra offline */
  .offline-sync-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: var(--radius-sm, 8px);
    padding: 0.65rem 0.95rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #1e40af;
    margin-bottom: 0.75rem;
  }

  .offline-bar-content {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .btn-sync-offline {
    background: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 0.35rem 0.75rem;
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .btn-sync-offline:hover {
    background: #1d4ed8;
  }

  .btn-sync-offline:disabled {
    background: #93c5fd;
    cursor: not-allowed;
  }

  .quick-alert {
    padding: 0.85rem 1.15rem;
    border-radius: var(--radius-sm, 8px);
    font-size: 0.92rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    text-align: center;
  }

  .quick-alert.success {
    background: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
    box-shadow: 0 2px 6px rgba(16, 185, 129, 0.1);
  }

  .quick-alert.error {
    background: #fef2f2;
    color: #991b1b;
    border: 1px solid #fecaca;
  }

  /* Tarjetas base con diseño EcoRaíces */
  .quick-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: var(--radius-md, 12px);
    padding: 1.35rem 1.5rem;
    box-shadow: 0 2px 10px -2px rgba(15, 23, 42, 0.05);
  }

  /* Header de la tarjeta */
  .card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.95rem;
  }

  .header-icon-badge {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .card-title {
    font-family: var(--font-heading, sans-serif);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-primary-dark, #14532d);
    margin: 0;
    line-height: 1.2;
  }

  .card-subtitle {
    font-size: 0.8rem;
    color: var(--color-text-muted, #64748b);
  }

  /* Coordenadas en caja estilizada */
  .coords-display-box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 0.65rem 0.85rem;
    margin-bottom: 1rem;
  }

  .coord-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: monospace;
    font-size: 0.92rem;
  }

  .coord-tag {
    color: #64748b;
    font-weight: 600;
  }

  .coord-val {
    color: #1e293b;
    font-weight: 700;
  }

  .coord-val.active {
    color: #059669;
  }

  .gps-status-badge {
    margin-left: auto;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }

  .gps-status-badge.waiting {
    background: #fef3c7;
    color: #92400e;
  }

  .gps-status-badge.ready {
    background: #dcfce7;
    color: #15803d;
  }

  /* Botones de ubicación */
  .location-btn-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .btn-location {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: #dc2626;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 0.7rem 1.25rem;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
    box-shadow: 0 2px 6px rgba(220, 38, 38, 0.25);
  }

  .btn-location:hover {
    background: #b91c1c;
    transform: translateY(-1px);
  }

  .btn-location:active {
    transform: translateY(0);
  }

  .btn-location:disabled {
    background: #94a3b8;
    box-shadow: none;
    cursor: not-allowed;
  }

  .btn-map-toggle {
    background: #ffffff;
    border: 1.5px solid #cbd5e1;
    color: #334155;
    border-radius: 8px;
    padding: 0.65rem 1rem;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-map-toggle:hover {
    background: #f1f5f9;
    border-color: #94a3b8;
  }

  /* Drawer de mapa desplegable */
  .map-drawer {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px dashed #e2e8f0;
  }

  .drawer-map {
    width: 100%;
    height: 230px;
    border-radius: 8px;
    border: 1.5px solid #cbd5e1;
    overflow: hidden;
  }

  .map-hint {
    display: block;
    font-size: 0.78rem;
    color: #64748b;
    margin-top: 0.35rem;
    text-align: center;
  }

  /* Tarjeta de Datos */
  .data-card {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .form-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .item-label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-main, #1e293b);
  }

  .item-label-icon {
    font-size: 1.1rem;
  }

  .req {
    color: #ef4444;
  }

  .input-shell {
    position: relative;
  }

  .item-input {
    width: 100%;
    border: 1.5px solid #cbd5e1;
    border-radius: 8px;
    padding: 0.75rem 0.95rem;
    font-size: 1rem;
    color: #1e293b;
    background: #ffffff;
    outline: none;
    transition: all 0.2s ease;
    box-sizing: border-box;
  }

  .item-input:focus {
    border-color: var(--color-primary, #1b5e20);
    box-shadow: 0 0 0 3px rgba(27, 94, 32, 0.15);
  }

  .input-compact {
    padding: 0.55rem 0.85rem;
    font-size: 0.9rem;
  }

  /* Botón Pill de Opciones Adicionales */
  .extra-toggle-wrap {
    display: flex;
    justify-content: center;
    margin: 0.25rem 0;
  }

  .btn-extra-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    border-radius: 999px;
    padding: 0.45rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #334155;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-extra-pill:hover {
    background: #e2e8f0;
    border-color: #94a3b8;
  }

  .pill-icon {
    font-size: 0.95rem;
  }

  .pill-arrow {
    font-size: 0.8rem;
    transition: transform 0.2s ease;
  }

  .btn-extra-pill.active .pill-arrow {
    transform: rotate(180deg);
  }

  /* Panel secundario */
  .extra-fields-panel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.15rem;
    background: #f8fafc;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
  }

  .item-label-mini {
    font-size: 0.84rem;
    font-weight: 700;
    color: #475569;
    margin-bottom: 0.2rem;
  }

  .item-select {
    width: 100%;
    border: 1.5px solid #cbd5e1;
    border-radius: 8px;
    padding: 0.6rem 0.85rem;
    font-size: 0.9rem;
    color: #1e293b;
    background: #ffffff;
    outline: none;
    box-sizing: border-box;
  }

  /* Foto Uploader */
  .photo-uploader-box {
    position: relative;
  }

  .file-hidden-input {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    opacity: 0;
    cursor: pointer;
    z-index: 5;
  }

  .photo-btn-styled {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: #ffffff;
    border: 2px dashed #a7f3d0;
    border-radius: 8px;
    padding: 0.85rem;
    color: #065f46;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .photo-btn-styled:hover {
    background: #ecfdf5;
    border-color: #10b981;
  }

  .photo-preview-thumb {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 0.5rem 0.75rem;
  }

  .photo-preview-thumb img {
    width: 48px;
    height: 48px;
    border-radius: 6px;
    object-fit: cover;
  }

  .thumb-info {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .thumb-filename {
    font-size: 0.82rem;
    color: #334155;
    font-weight: 500;
    max-width: 180px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .btn-remove-thumb {
    background: none;
    border: 1px solid #ef4444;
    color: #ef4444;
    border-radius: 6px;
    padding: 0.25rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
  }

  .btn-remove-thumb:hover {
    background: #fee2e2;
  }

  /* Chips de Salud */
  .health-chips-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .mini-chip {
    background: #ffffff;
    border: 1.5px solid #cbd5e1;
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: #475569;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .mini-chip:hover {
    background: #f1f5f9;
    border-color: #94a3b8;
  }

  .mini-chip.active {
    background: #ecfdf5;
    border-color: #10b981;
    color: #065f46;
    box-shadow: 0 1px 4px rgba(16, 185, 129, 0.2);
  }

  /* Botón Enviar Principal EcoRaíces */
  .btn-send-ecoraices {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    background: linear-gradient(135deg, var(--color-primary, #1b5e20) 0%, #15803d 100%);
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 0.95rem;
    font-family: var(--font-heading, sans-serif);
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 3px 12px rgba(27, 94, 32, 0.25);
    margin-top: 0.25rem;
  }

  .btn-send-ecoraices:hover {
    background: linear-gradient(135deg, #14532d 0%, #166534 100%);
    box-shadow: 0 6px 16px rgba(27, 94, 32, 0.35);
    transform: translateY(-1px);
  }

  .btn-send-ecoraices:active {
    transform: translateY(0);
  }

  .btn-send-ecoraices:disabled {
    background: #94a3b8;
    box-shadow: none;
    cursor: not-allowed;
  }

  /* Modo ráfaga continua */
  .continuous-mode-toggle {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.82rem;
    color: #475569;
    font-weight: 600;
    cursor: pointer;
    margin-top: 0.15rem;
  }

  .continuous-mode-toggle input {
    cursor: pointer;
    accent-color: #16a34a;
    width: 16px;
    height: 16px;
  }

  @media (max-width: 640px) {
    .quick-card {
      padding: 1.15rem;
    }
    .btn-send-ecoraices {
      padding: 0.85rem;
      font-size: 1.05rem;
    }
  }
</style>

<script define:vars={{ categories, communities }}>
  document.addEventListener("DOMContentLoaded", () => {
    initQuickObservationForm();
  });
  document.addEventListener("astro:page-load", () => {
    initQuickObservationForm();
  });

  function initQuickObservationForm() {
    const form = document.getElementById('observation-form');
    if (!form || form.dataset.initialized) return;
    form.dataset.initialized = "true";

    const alertSuccess = document.getElementById('alert-success');
    const alertError = document.getElementById('alert-error');
    const submitBtn = document.getElementById('submit-btn');

    const latInput = document.getElementById('latitude');
    const lngInput = document.getElementById('longitude');
    const displayLat = document.getElementById('display-lat');
    const displayLng = document.getElementById('display-lng');
    const gpsStatusBadge = document.getElementById('gps-status-indicator');
    const btnWhereAmI = document.getElementById('btn-where-am-i');

    const speciesInput = document.getElementById('speciesInput');
    const municipioInput = document.getElementById('municipioInput');
    const estadoFitosanitarioInput = document.getElementById('estadoFitosanitario');
    const continuousMode = document.getElementById('continuous-mode');

    const btnToggleExtra = document.getElementById('btn-toggle-extra');
    const extraFields = document.getElementById('extra-fields');
    const extraBtnText = document.getElementById('extra-btn-text');

    const btnToggleMap = document.getElementById('btn-toggle-map');
    const mapDrawer = document.getElementById('map-drawer');

    // Uploader de foto rápida
    const quickImage = document.getElementById('quick-image');
    const photoPlaceholderBtn = document.getElementById('photo-placeholder-btn');
    const photoPreviewWrap = document.getElementById('photo-preview-wrap');
    const thumbImg = document.getElementById('thumb-img');
    const thumbName = document.getElementById('thumb-name');
    const btnRemoveThumb = document.getElementById('btn-remove-thumb');

    let map = null;
    let marker = null;
    let mapInitialized = false;

    // Recordar el último municipio utilizado para agilizar ráfaga en campo
    const savedMunicipio = localStorage.getItem('ecoraices_last_municipio');
    if (savedMunicipio && !municipioInput.value) {
      municipioInput.value = savedMunicipio;
    }

    const showSuccess = (msg) => {
      alertSuccess.textContent = msg;
      alertSuccess.style.display = 'block';
      alertError.style.display = 'none';
      alertSuccess.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };

    const showError = (msg) => {
      alertError.textContent = msg;
      alertError.style.display = 'block';
      alertSuccess.style.display = 'none';
      alertError.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };

    const hideAlerts = () => {
      alertSuccess.style.display = 'none';
      alertError.style.display = 'none';
    };

    // Actualizar coordenadas en la UI
    function setCoordinates(lat, lng, accuracy = null) {
      latInput.value = Number(lat).toFixed(6);
      lngInput.value = Number(lng).toFixed(6);
      displayLat.textContent = Number(lat).toFixed(6);
      displayLng.textContent = Number(lng).toFixed(6);
      displayLat.classList.add('active');
      displayLng.classList.add('active');

      if (gpsStatusBadge) {
        const accText = accuracy ? ` (±${Math.round(accuracy)}m)` : '';
        gpsStatusBadge.textContent = `✓ GPS fijado${accText}`;
        gpsStatusBadge.className = "gps-status-badge ready";
      }

      if (marker && map) {
        marker.setLngLat([lng, lat]);
      }
    }

    // Geolocalización con watchPosition continuo (GPS caliente para campo)
    let watchId = null;
    function startContinuousGPS() {
      if (!navigator.geolocation) return;

      watchId = navigator.geolocation.watchPosition(
        (pos) => {
          setCoordinates(pos.coords.latitude, pos.coords.longitude, pos.coords.accuracy);
        },
        (err) => {
          console.warn('[GPS Watch]', err.message);
        },
        { enableHighAccuracy: true, maximumAge: 6000, timeout: 15000 }
      );
    }

    function requestGPS(silent = false) {
      if (!navigator.geolocation) {
        if (!silent) alert('Tu navegador no soporta geolocalización.');
        return;
      }

      btnWhereAmI.disabled = true;
      btnWhereAmI.innerHTML = `
        <svg class="animate-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10" stroke-opacity="0.25"/>
          <path d="M12 2a10 10 0 0 1 10 10"/>
        </svg>
        Obteniendo GPS...
      `;

      navigator.geolocation.getCurrentPosition(
        (pos) => {
          setCoordinates(pos.coords.latitude, pos.coords.longitude, pos.coords.accuracy);
          btnWhereAmI.disabled = false;
          btnWhereAmI.innerHTML = `✓ Ubicación fijada`;
          setTimeout(() => {
            btnWhereAmI.innerHTML = `
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <circle cx="12" cy="12" r="10"/>
                <polygon points="12 2 12 6 12 18 12 22"/>
                <polygon points="2 12 6 12 18 12 22 12"/>
              </svg>
              ¿Dónde estoy?
            `;
          }, 3000);
        },
        (err) => {
          btnWhereAmI.disabled = false;
          btnWhereAmI.innerHTML = `¿Dónde estoy?`;
          if (!silent) {
            alert('No se pudo obtener la ubicación GPS automática. Por favor activa los permisos de ubicación o usa "Ajustar en mapa".');
          }
        },
        { enableHighAccuracy: true, timeout: 12000, maximumAge: 5000 }
      );
    }

    btnWhereAmI?.addEventListener('click', () => requestGPS(false));

    // Iniciar GPS continuo al abrir la pantalla para campo
    startContinuousGPS();
    if (!latInput.value) {
      requestGPS(true);
    }

    // ==========================================
    // SISTEMA DE COLA OFFLINE (TRABAJO EN CAMPO)
    // ==========================================
    const offlineSyncBar = document.getElementById('offline-sync-bar');
    const offlineBarText = document.getElementById('offline-bar-text');
    const btnSyncOfflineNow = document.getElementById('btn-sync-offline-now');

    function getOfflineQueue() {
      try {
        return JSON.parse(localStorage.getItem('ecoraices_offline_trees') || '[]');
      } catch {
        return [];
      }
    }

    function saveOfflineQueue(queue) {
      try {
        localStorage.setItem('ecoraices_offline_trees', JSON.stringify(queue));
      } catch (e) {
        console.error('[OfflineQueue] Error guardando cola:', e);
      }
      updateOfflineUI();
    }

    function updateOfflineUI() {
      const queue = getOfflineQueue();
      if (!offlineSyncBar) return;
      if (queue.length > 0) {
        offlineBarText.textContent = `${queue.length} árbol(es) guardado(s) localmente (sin conexión)`;
        offlineSyncBar.style.display = 'flex';
      } else {
        offlineSyncBar.style.display = 'none';
      }
    }

    updateOfflineUI();

    async function syncOfflineQueue() {
      const queue = getOfflineQueue();
      if (!queue.length) return;

      btnSyncOfflineNow.disabled = true;
      btnSyncOfflineNow.textContent = "Sincronizando...";

      let successCount = 0;
      const remaining = [];

      for (const item of queue) {
        try {
          const fd = new FormData();
          fd.append("userId", item.userId);
          fd.append("nombreComunitario", item.nombreComunitario);
          fd.append("municipio", item.municipio);
          fd.append("latitude", item.latitude);
          fd.append("longitude", item.longitude);
          fd.append("estadoFitosanitario", item.estadoFitosanitario || "Sano y vigoroso");
          fd.append("observationDate", item.observationDate);

          if (item.notes) fd.append("notes", item.notes);
          if (item.communityId) fd.append("communityId", item.communityId);

          if (item.imageDataUrl) {
            const blob = await fetch(item.imageDataUrl).then(r => r.blob());
            fd.append("image", blob, item.imageName || "offline_tree.jpg");
          }

          const res = await fetch('/api/observations', {
            method: 'POST',
            body: fd
          });

          if (res.ok) {
            successCount++;
          } else {
            remaining.push(item);
          }
        } catch {
          remaining.push(item);
        }
      }

      saveOfflineQueue(remaining);
      btnSyncOfflineNow.disabled = false;
      btnSyncOfflineNow.textContent = "Sincronizar ahora";

      if (successCount > 0) {
        showSuccess(`✓ ${successCount} árbol(es) sincronizado(s) exitosamente con el servidor.`);
      }
    }

    btnSyncOfflineNow?.addEventListener('click', syncOfflineQueue);
    window.addEventListener('online', () => {
      showSuccess("📶 Señal de internet recuperada. Sincronizando árboles pendientes...");
      syncOfflineQueue();
    });

    // Foto rápida y preview
    let currentPhotoDataUrl = null;
    let currentPhotoName = null;

    quickImage?.addEventListener('change', (e) => {
      const file = e.target.files?.[0];
      if (file && file.type.startsWith('image/')) {
        currentPhotoName = file.name;
        const reader = new FileReader();
        reader.onload = (ev) => {
          currentPhotoDataUrl = ev.target.result;
          thumbImg.src = currentPhotoDataUrl;
          thumbName.textContent = file.name;
          photoPreviewWrap.style.display = 'flex';
          photoPlaceholderBtn.style.display = 'none';
        };
        reader.readAsDataURL(file);
      }
    });

    btnRemoveThumb?.addEventListener('click', (e) => {
      e.stopPropagation();
      quickImage.value = '';
      currentPhotoDataUrl = null;
      currentPhotoName = null;
      thumbImg.src = '';
      photoPreviewWrap.style.display = 'none';
      photoPlaceholderBtn.style.display = 'flex';
    });

    // Chips de salud
    const miniChips = document.querySelectorAll('.mini-chip');
    miniChips.forEach(chip => {
      chip.addEventListener('click', () => {
        miniChips.forEach(c => c.classList.remove('active'));
        chip.classList.add('active');
        estadoFitosanitarioInput.value = chip.dataset.health;
      });
    });

    // Toggle panel secundario
    btnToggleExtra?.addEventListener('click', () => {
      const isHidden = extraFields.style.display === 'none';
      extraFields.style.display = isHidden ? 'flex' : 'none';
      btnToggleExtra.classList.toggle('active', isHidden);
      extraBtnText.textContent = isHidden ? 'Ocultar opciones adicionales' : 'Opciones adicionales (Foto, Salud, Notas)';
    });

    // Toggle mini-mapa
    btnToggleMap?.addEventListener('click', () => {
      const isHidden = mapDrawer.style.display === 'none';
      mapDrawer.style.display = isHidden ? 'block' : 'none';
      btnToggleMap.textContent = isHidden ? '✕ Cerrar mapa' : '🗺️ Ajustar en mapa';

      if (isHidden && !mapInitialized) {
        mapInitialized = true;
        import('https://unpkg.com/maplibre-gl@3.6.2/dist/maplibre-gl.js').then((module) => {
          const maplibregl = module.default || window.maplibregl;
          const initialLat = parseFloat(latInput.value) || 11.5448;
          const initialLng = parseFloat(lngInput.value) || -72.9068;

          map = new maplibregl.Map({
            container: 'quick-map',
            style: 'https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json',
            center: [initialLng, initialLat],
            zoom: latInput.value ? 15 : 8
          });

          marker = new maplibregl.Marker({ color: '#16a34a' })
            .setLngLat([initialLng, initialLat])
            .addTo(map);

          map.on('click', (e) => {
            setCoordinates(e.lngLat.lat, e.lngLat.lng);
          });
        });
      }
    });

    // Envío ultrarrápido con soporte Online / Offline
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideAlerts();

      const userId = document.getElementById('userId').value;
      if (!userId) {
        showError("Por favor inicia sesión para registrar árboles.");
        return;
      }

      if (!latInput.value || !lngInput.value) {
        showError("Por favor presiona '¿Dónde estoy?' para obtener las coordenadas.");
        btnWhereAmI?.scrollIntoView({ behavior: 'smooth' });
        return;
      }

      const speciesVal = speciesInput?.value.trim();
      if (!speciesVal) {
        showError("Por favor ingresa el nombre de la especie o nombre común.");
        speciesInput?.focus();
        return;
      }

      const municipioVal = municipioInput?.value.trim();
      if (!municipioVal) {
        showError("Por favor ingresa o selecciona el municipio.");
        municipioInput?.focus();
        return;
      }

      // Guardar municipio para siguientes registros en campo
      localStorage.setItem('ecoraices_last_municipio', municipioVal);

      submitBtn.disabled = true;
      submitBtn.innerHTML = `
        <svg class="animate-spin" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10" stroke-opacity="0.25"/>
          <path d="M12 2a10 10 0 0 1 10 10"/>
        </svg>
        <span>Enviando registro...</span>
      `;

      const observationData = {
        userId,
        nombreComunitario: speciesVal,
        municipio: municipioVal,
        latitude: latInput.value,
        longitude: lngInput.value,
        estadoFitosanitario: estadoFitosanitarioInput.value || "Sano y vigoroso",
        observationDate: new Date().toISOString().split("T")[0],
        notes: document.getElementById('quick-notes')?.value.trim() || null,
        communityId: document.getElementById('quick-community')?.value || null,
        imageDataUrl: currentPhotoDataUrl,
        imageName: currentPhotoName
      };

      const handleSuccessUI = (isOffline = false) => {
        if (continuousMode.checked) {
          const msg = isOffline 
            ? `💾 Árbol "${speciesVal}" guardado en memoria offline (sin señal). Se sincronizará al detectar red. ¡Listo para el siguiente!`
            : `✓ Árbol "${speciesVal}" registrado exitosamente en ${municipioVal}. ¡Listo para el siguiente!`;
          showSuccess(msg);
          speciesInput.value = '';
          const quickNotesEl = document.getElementById('quick-notes');
          if (quickNotesEl) quickNotesEl.value = '';
          
          // Limpiar foto
          if (quickImage) quickImage.value = '';
          currentPhotoDataUrl = null;
          currentPhotoName = null;
          photoPreviewWrap.style.display = 'none';
          photoPlaceholderBtn.style.display = 'flex';

          submitBtn.disabled = false;
          submitBtn.innerHTML = `
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <span>Enviar Registro</span>
          `;
          speciesInput.focus();
        } else {
          showSuccess(isOffline 
            ? "💾 Árbol guardado en memoria local sin conexión. Se sincronizará al detectar red."
            : "¡Árbol registrado con éxito! Redirigiendo a su ficha..."
          );
          setTimeout(() => {
            window.location.href = `/observaciones`;
          }, 1200);
        }
      };

      // Si el navegador está offline directamente:
      if (!navigator.onLine) {
        const queue = getOfflineQueue();
        queue.push(observationData);
        saveOfflineQueue(queue);
        handleSuccessUI(true);
        return;
      }

      // Si está online, intentar enviar por red
      try {
        const formData = new FormData();
        formData.append("userId", userId);
        formData.append("nombreComunitario", speciesVal);
        formData.append("municipio", municipioVal);
        formData.append("latitude", latInput.value);
        formData.append("longitude", lngInput.value);
        formData.append("estadoFitosanitario", observationData.estadoFitosanitario);
        formData.append("observationDate", observationData.observationDate);

        if (observationData.notes) formData.append("notes", observationData.notes);
        if (observationData.communityId) formData.append("communityId", observationData.communityId);

        if (quickImage && quickImage.files && quickImage.files[0]) {
          formData.append("image", quickImage.files[0]);
        }

        const res = await fetch('/api/observations', {
          method: 'POST',
          body: formData
        });

        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.detail || errData.message || "Error al registrar el árbol.");
        }

        handleSuccessUI(false);

      } catch (err) {
        // Fallback por corte de señal intermitente en campo
        console.warn('[Offline Fallback]', err);
        const queue = getOfflineQueue();
        queue.push(observationData);
        saveOfflineQueue(queue);
        handleSuccessUI(true);
      }
    });
  }
</script>
