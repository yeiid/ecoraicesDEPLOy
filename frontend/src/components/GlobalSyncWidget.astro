---
import { Icon } from 'astro-icon/components';
---

<!-- EcoRaíces · Widget Global de Estado de Red y Sincronización de Campo -->
<div id="global-sync-widget" class="global-sync-widget" role="status" aria-live="polite">
  <div class="sync-indicator online" id="sync-pill-indicator">
    <span class="sync-dot"></span>
    <span class="sync-text" id="sync-status-text">Conectado</span>
    <button type="button" id="btn-global-sync-action" class="btn-global-sync" style="display: none;" title="Sincronizar ahora con el servidor">
      <Icon name="lucide:refresh-cw" class="sync-refresh-icon" />
      <span id="btn-sync-label">Sincronizar</span>
    </button>
  </div>
</div>

<script>
  import { getPendingCount, syncPendingObservations } from '../lib/offlineStore.js';

  function initGlobalSync() {
    const pill = document.getElementById('sync-pill-indicator');
    const statusText = document.getElementById('sync-status-text');
    const syncBtn = document.getElementById('btn-global-sync-action');
    const btnLabel = document.getElementById('btn-sync-label');

    if (!pill || !statusText || !syncBtn) return;

    // Limpiar escuchadores previos de ViewTransitions para no disparar sincronizaciones múltiples
    if (window.__ecoraicesGlobalSyncAbort) {
      window.__ecoraicesGlobalSyncAbort.abort();
    }
    const abortCtrl = new AbortController();
    window.__ecoraicesGlobalSyncAbort = abortCtrl;
    const { signal } = abortCtrl;

    async function updateWidgetState() {
      const isOnline = navigator.onLine;
      const isSyncing = Boolean(window.__ecoraicesActiveSyncPromise);
      const pendingCount = await getPendingCount();

      pill.classList.remove('online', 'offline', 'pending', 'syncing');

      if (isSyncing) {
        pill.classList.add('syncing');
        statusText.textContent = 'Sincronizando...';
        syncBtn.disabled = true;
        return;
      }

      syncBtn.disabled = false;

      if (!isOnline) {
        pill.classList.add('offline');
        if (pendingCount > 0) {
          statusText.textContent = `Sin señal (${pendingCount} en espera)`;
        } else {
          statusText.textContent = 'Modo Campo (Sin señal)';
        }
        syncBtn.style.display = 'none';
      } else {
        if (pendingCount > 0) {
          pill.classList.add('pending');
          statusText.textContent = `${pendingCount} árbol(es) por subir`;
          syncBtn.style.display = 'inline-flex';
          if (btnLabel) btnLabel.textContent = 'Subir';
        } else {
          pill.classList.add('online');
          statusText.textContent = 'En línea';
          syncBtn.style.display = 'none';
        }
      }
    }

    async function triggerGlobalSync() {
      if (!navigator.onLine) return;
      pill.classList.add('syncing');
      statusText.textContent = 'Sincronizando...';
      syncBtn.disabled = true;

      try {
        await syncPendingObservations();
      } catch (err) {
        console.error('[Sync Widget] Error general durante la sincronización:', err);
      } finally {
        syncBtn.disabled = false;
        await updateWidgetState();
      }
    }

    window.addEventListener('online', () => {
      updateWidgetState();
      triggerGlobalSync();
    }, { signal });

    window.addEventListener('offline', updateWidgetState, { signal });
    window.addEventListener('ecoraices:sync-count-changed', updateWidgetState, { signal });
    window.addEventListener('ecoraices:sync-started', updateWidgetState, { signal });
    window.addEventListener('ecoraices:sync-completed', updateWidgetState, { signal });
    window.addEventListener('ecoraices:sync-error', (e) => {
      updateWidgetState();
      const detail = e?.detail;
      if (detail?.authError) {
        statusText.textContent = 'Sesión expirada (Re-ingresa)';
      }
    }, { signal });

    syncBtn.addEventListener('click', triggerGlobalSync, { signal });

    updateWidgetState();
  }

  document.addEventListener('astro:page-load', initGlobalSync);
</script>

<style>
  .global-sync-widget {
    display: inline-flex;
    align-items: center;
  }

  .sync-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    transition: var(--transition-smooth);
    border: 1px solid var(--color-border);
  }

  .sync-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    transition: background 0.2s ease;
  }

  /* Estado: Conectado */
  .sync-indicator.online {
    background: var(--color-success-bg);
    color: var(--color-primary);
    border-color: rgba(16, 185, 129, 0.3);
  }
  .sync-indicator.online .sync-dot {
    background: var(--color-success);
    box-shadow: 0 0 6px var(--color-success);
  }

  /* Estado: Sin conexión (Modo Campo) */
  .sync-indicator.offline {
    background: var(--color-warning-bg);
    color: var(--color-warning);
    border-color: rgba(217, 119, 6, 0.3);
  }
  .sync-indicator.offline .sync-dot {
    background: var(--color-warning);
  }

  /* Estado: Árboles pendientes listos para subir */
  .sync-indicator.pending {
    background: var(--color-info-bg);
    color: var(--color-info);
    border-color: rgba(37, 99, 235, 0.3);
  }
  .sync-indicator.pending .sync-dot {
    background: var(--color-info);
    animation: blinkDot 1.5s infinite;
  }

  /* Estado: Sincronizando */
  .sync-indicator.syncing {
    background: var(--color-info-bg);
    color: var(--color-info);
  }
  .sync-indicator.syncing .sync-dot {
    background: var(--color-info);
  }

  @keyframes blinkDot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .btn-global-sync {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: var(--color-primary);
    color: #ffffff;
    border: none;
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
    margin-left: 0.25rem;
    transition: var(--transition-smooth);
  }

  .btn-global-sync:hover {
    filter: brightness(0.9);
  }

  .sync-refresh-icon {
    width: 12px;
    height: 12px;
  }

  .sync-indicator.syncing .sync-refresh-icon {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @media (max-width: 640px) {
    .sync-text {
      display: none;
    }
    .sync-indicator {
      padding: 0.35rem 0.5rem;
      gap: 0.25rem;
    }
    .btn-global-sync {
      padding: 0.15rem 0.4rem;
      font-size: 0.68rem;
    }
  }
</style>
