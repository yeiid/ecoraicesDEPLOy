---
import Layout from "../../layouts/Layout.astro";
import { apiGet } from "../../lib/api/client.js";
import { getSessionUser } from "../../lib/middleware/auth.js";

const user = await getSessionUser({ cookies: Astro.cookies, request: Astro.request });

if (!user) {
  return Astro.redirect("/auth/login");
}
if (!user.isAdmin) {
  return Astro.redirect("/");
}

let obsCount, obsPending, obsApproved, obsRejected, communityCount, speciesCount, userCount;
let communities = [];
let observations = [];
let users = [];

try {
  const data = await apiGet("/admin/dashboard");
  
  obsCount = data.stats.obsCount;
  obsPending = data.stats.obsPending;
  obsApproved = data.stats.obsApproved;
  obsRejected = data.stats.obsRejected;
  communityCount = data.stats.communityCount;
  speciesCount = data.stats.speciesCount;
  userCount = data.stats.userCount;
  
  communities = data.communities || [];
  observations = data.observations || [];
  users = data.users || [];
} catch (error) {
  console.error("Error fetching admin dashboard:", error);
}

const statusLabel = { PENDING: "Pendiente", APPROVED: "Aprobada", REJECTED: "Rechazada" };
const statusBadge = {
  PENDING: "badge-warning",
  APPROVED: "badge-success",
  REJECTED: "badge-danger",
};
const statusClass = { PENDING: "pending", APPROVED: "approved", REJECTED: "rejected" };
---

<Layout title="Panel Admin - EcoRaíces">
  <div class="admin-container">
    <header class="admin-header">
      <h1>Panel de Administración</h1>
      <p class="admin-subtitle">Gestión de datos generales y comunidades</p>
    </header>

    <!-- Stats -->
    <section class="stats-grid">
      <div class="stat-box">
        <span class="stat-value">{obsCount}</span>
        <span class="stat-label">Observaciones</span>
      </div>
      <div class="stat-box warning">
        <span class="stat-value">{obsPending}</span>
        <span class="stat-label">Pendientes de revisión</span>
      </div>
      <div class="stat-box success">
        <span class="stat-value">{obsApproved}</span>
        <span class="stat-label">Aprobadas</span>
      </div>
      <div class="stat-box danger">
        <span class="stat-value">{obsRejected}</span>
        <span class="stat-label">Rechazadas</span>
      </div>
      <div class="stat-box">
        <span class="stat-value">{communityCount}</span>
        <span class="stat-label">Comunidades</span>
      </div>
      <div class="stat-box">
        <span class="stat-value">{speciesCount}</span>
        <span class="stat-label">Especies</span>
      </div>
      <div class="stat-box">
        <span class="stat-value">{userCount}</span>
        <span class="stat-label">Usuarios</span>
      </div>
    </section>

    <!-- Comunidades -->
    <section class="panel-section card">
      <div class="section-head">
        <h2>Comunidades</h2>
        <span class="muted">{communities.length} total</span>
      </div>
      {communities.length === 0 ? (
        <p class="empty-state">No hay comunidades registradas.</p>
      ) : (
        <div class="table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th scope="col">Nombre</th>
                <th scope="col">Propietario</th>
                <th scope="col">Miembros</th>
                <th scope="col">Creada</th>
                <th scope="col" class="col-actions">Acciones</th>
              </tr>
            </thead>
            <tbody>
              {communities.map((c) => (
                <tr>
                  <td>
                    <a href={`/comunidades/${c.id}`} class="cell-link">{c.name}</a>
                    {c.location ? <div class="cell-sub">{c.location}</div> : null}
                  </td>
                  <td>{c.owner?.username || "—"}</td>
                  <td>{c._count.members}</td>
                  <td>{new Date(c.createdAt).toLocaleDateString("es-CO")}</td>
                  <td class="col-actions">
                    <button
                      class="btn btn-danger btn-sm"
                      data-action="delete-community"
                      data-id={c.id}
                      data-name={c.name}
                      aria-label={`Eliminar comunidad ${c.name}`}
                    >Eliminar</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>

    <!-- Observaciones -->
    <section class="panel-section card">
      <div class="section-head">
        <h2>Observaciones</h2>
        <span class="muted">Últimas {observations.length}</span>
      </div>
      {observations.length === 0 ? (
        <p class="empty-state">No hay observaciones registradas.</p>
      ) : (
        <div class="table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th scope="col">Especie</th>
                <th scope="col">Autor</th>
                <th scope="col">Fecha</th>
                <th scope="col">Estado</th>
                <th scope="col" class="col-actions">Acciones</th>
              </tr>
            </thead>
            <tbody>
              {observations.map((o) => (
                <tr class={statusClass[o.status]}>
                  <td>
                    <a href={`/observaciones/${o.id}`} class="cell-link">{o.species?.name || "—"}</a>
                    {o.species?.scientificName ? <div class="cell-sub">{o.species.scientificName}</div> : null}
                  </td>
                  <td>{o.user?.username || "—"}</td>
                  <td>{new Date(o.createdAt).toLocaleDateString("es-CO")}</td>
                  <td><span class={`badge ${statusBadge[o.status]}`}>{statusLabel[o.status]}</span></td>
                  <td class="col-actions">
                    {o.status !== "APPROVED" && (
                      <button
                        class="btn btn-primary btn-sm"
                        data-action="verify-observation"
                        data-id={o.id}
                        data-status="APPROVED"
                        aria-label={`Aprobar observación de ${o.species?.name || "especie desconocida"}`}
                      >Aprobar</button>
                    )}
                    {o.status !== "REJECTED" && (
                      <button
                        class="btn btn-secondary btn-sm"
                        data-action="verify-observation"
                        data-id={o.id}
                        data-status="REJECTED"
                        aria-label={`Rechazar observación de ${o.species?.name || "especie desconocida"}`}
                      >Rechazar</button>
                    )}
                    <button
                      class="btn btn-danger btn-sm"
                      data-action="delete-observation"
                      data-id={o.id}
                      aria-label={`Eliminar observación de ${o.species?.name || "especie desconocida"}`}
                    >Eliminar</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>

    <!-- Usuarios Registrados -->
    <section class="panel-section card">
      <div class="section-head">
        <div>
          <h2>Usuarios Registrados</h2>
          <span class="muted">{users.length} total</span>
        </div>
        <button type="button" id="btn-open-create-user" class="btn btn-primary btn-sm">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Nuevo Usuario
        </button>
      </div>
      {users.length === 0 ? (
        <p class="empty-state">No hay usuarios registrados.</p>
      ) : (
        <div class="table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th scope="col">Usuario</th>
                <th scope="col">Email</th>
                <th scope="col">Rol</th>
                <th scope="col">Admin</th>
                <th scope="col">Observaciones</th>
                <th scope="col">Registrado</th>
                <th scope="col" class="col-actions">Acciones</th>
              </tr>
            </thead>
            <tbody>
              {users.map((u) => (
                <tr>
                  <td>
                    <div class="user-cell">
                      {u.avatarUrl ? (
                        <img src={u.avatarUrl} alt={u.name || u.username} class="user-cell-avatar" />
                      ) : (
                        <div class="user-cell-initial">{(u.name || u.username || 'U')[0].toUpperCase()}</div>
                      )}
                      <div>
                        <span class="cell-link">{u.name || u.username}</span>
                        <div class="cell-sub">@{u.username}</div>
                      </div>
                    </div>
                  </td>
                  <td>{u.email}</td>
                  <td>
                    <span class="badge badge-neutral">
                      {u.role === "COMMUNITY" ? "Comunidad" : "Guardabosques"}
                    </span>
                  </td>
                  <td>
                    {u.isAdmin ? (
                      <span class="badge badge-success">Sí (Admin)</span>
                    ) : (
                      <span class="badge badge-neutral">No</span>
                    )}
                  </td>
                  <td>{u.observationsCount}</td>
                  <td>{u.createdAt ? new Date(u.createdAt).toLocaleDateString("es-CO") : "—"}</td>
                  <td class="col-actions">
                    {u.id !== user.id ? (
                      <div class="actions-group">
                        <button
                          class={`btn btn-sm ${u.isAdmin ? 'btn-secondary' : 'btn-outline'}`}
                          data-action="toggle-admin"
                          data-id={u.id}
                          data-admin={u.isAdmin ? "true" : "false"}
                          data-name={u.name || u.username}
                          aria-label={`${u.isAdmin ? 'Quitar rol admin a' : 'Hacer admin a'} ${u.username}`}
                        >
                          {u.isAdmin ? "Quitar Admin" : "Hacer Admin"}
                        </button>
                        <button
                          class="btn btn-danger btn-sm"
                          data-action="delete-user"
                          data-id={u.id}
                          data-name={u.name || u.username}
                          aria-label={`Eliminar usuario ${u.username}`}
                        >
                          Eliminar
                        </button>
                      </div>
                    ) : (
                      <span class="badge badge-info">Tú</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>

    <!-- Modal Crear Usuario -->
    <div id="create-user-modal" class="modal-backdrop" style="display: none;">
      <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <div class="modal-header">
          <h3 id="modal-title">Registrar Nuevo Usuario</h3>
          <button type="button" id="btn-close-modal" class="modal-close" aria-label="Cerrar modal">✕</button>
        </div>
        <form id="create-user-form" class="modal-form">
          <div id="modal-alert" class="alert-box error" style="display: none;"></div>

          <div class="form-group">
            <label for="new-name" class="modal-label">Nombre completo</label>
            <input type="text" id="new-name" class="input" placeholder="Ej. Juan Pérez" />
          </div>

          <div class="form-row-2">
            <div class="form-group">
              <label for="new-username" class="modal-label">Usuario <span class="required">*</span></label>
              <input type="text" id="new-username" class="input" placeholder="juanperez" required autocomplete="off" />
            </div>

            <div class="form-group">
              <label for="new-email" class="modal-label">Correo <span class="required">*</span></label>
              <input type="email" id="new-email" class="input" placeholder="juan@ejemplo.com" required autocomplete="off" />
            </div>
          </div>

          <div class="form-row-2">
            <div class="form-group">
              <label for="new-password" class="modal-label">Contraseña <span class="required">*</span></label>
              <input type="password" id="new-password" class="input" placeholder="Mínimo 6 carácteres" required minlength="6" />
            </div>

            <div class="form-group">
              <label for="new-role" class="modal-label">Rol inicial</label>
              <select id="new-role" class="select">
                <option value="COLLECTOR">Guardabosques</option>
                <option value="COMMUNITY">Comunidad</option>
              </select>
            </div>
          </div>

          <div class="form-group-checkbox">
            <label class="checkbox-label">
              <input type="checkbox" id="new-is-admin" />
              <span>Conceder rol de Administrador</span>
            </label>
          </div>

          <div class="modal-actions">
            <button type="button" id="btn-cancel-modal" class="btn btn-secondary">Cancelar</button>
            <button type="submit" id="btn-submit-modal" class="btn btn-primary">Guardar Usuario</button>
          </div>
        </form>
      </div>
    </div>

    <div id="admin-alert" class="alert-box error" role="alert" aria-live="polite" style="display: none;"></div>
  </div>
</Layout>

<style>
  .admin-container {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .admin-header h1 {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-primary-dark);
    letter-spacing: -0.02em;
  }

  .admin-subtitle {
    color: var(--color-text-light);
    margin-top: 0.25rem;
    font-size: 0.95rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.85rem;
    width: 100%;
  }

  @media (max-width: 960px) {
    .stats-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 640px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.65rem;
    }

    .admin-header h1 {
      font-size: 1.6rem;
    }
  }

  .stat-box {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.1rem 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    box-shadow: var(--shadow-sm);
    min-width: 0;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .stat-box:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
  }

  .stat-box.warning { border-top: 3px solid var(--color-warning); }
  .stat-box.success { border-top: 3px solid var(--color-success); }
  .stat-box.danger  { border-top: 3px solid var(--color-danger); }

  .stat-value {
    font-family: var(--font-heading);
    font-size: 1.7rem;
    font-weight: 800;
    color: #1f2937;
    line-height: 1.2;
  }

  .stat-label {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    line-height: 1.3;
  }

  .panel-section {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg, 16px);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
    width: 100%;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .panel-section {
      padding: 1rem 0.75rem;
    }
  }

  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .section-head h2 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary-dark);
  }

  .muted {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .empty-state {
    color: var(--color-text-muted);
    padding: 1.5rem 0;
    text-align: center;
    font-size: 0.95rem;
  }

  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-radius: var(--radius-md, 10px);
    border: 1px solid var(--color-border);
    width: 100%;
  }

  .table-wrap::-webkit-scrollbar {
    height: 6px;
  }
  .table-wrap::-webkit-scrollbar-track {
    background: #f8fafc;
  }
  .table-wrap::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 999px;
  }
  .table-wrap::-webkit-scrollbar-thumb:hover {
    background: #94a3b8;
  }

  .admin-table {
    width: 100%;
    min-width: 680px;
    border-collapse: collapse;
    font-size: 0.88rem;
  }

  .admin-table th {
    background: var(--color-gray-50, #f8fafc);
    text-align: left;
    padding: 0.75rem 0.85rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 2px solid var(--color-border);
    white-space: nowrap;
  }

  .admin-table td {
    padding: 0.75rem 0.85rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: middle;
  }

  .admin-table tbody tr:hover {
    background-color: #f8fafc;
  }

  .admin-table tr.rejected { background: rgba(239, 68, 68, 0.04); }

  .cell-link {
    color: var(--color-primary-dark);
    font-weight: 600;
    text-decoration: none;
  }

  .cell-link:hover {
    color: var(--color-success);
    text-decoration: underline;
  }

  .cell-sub {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin-top: 0.15rem;
  }

  .col-actions {
    white-space: nowrap;
    text-align: right;
  }

  .col-actions .btn + .btn {
    margin-left: 0.4rem;
  }

  .actions-group {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
  }

  .user-cell {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .user-cell-avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .user-cell-initial {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--color-success-bg, #e8f5e9);
    color: var(--color-primary-dark, #1b5e20);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    flex-shrink: 0;
  }
  /* Modal de Crear Usuario */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.5);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 1rem;
  }

  .modal-dialog {
    background: #ffffff;
    border-radius: var(--radius-lg, 16px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
    width: 100%;
    max-width: 520px;
    overflow: hidden;
    animation: modalPop 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes modalPop {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .modal-header h3 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-primary-dark);
  }

  .modal-close {
    background: none;
    border: none;
    font-size: 1.25rem;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .modal-close:hover {
    color: var(--color-text-main);
    background: #f1f5f9;
  }

  .modal-form {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 520px) {
    .form-row-2 {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }

  .modal-label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-main);
    margin-bottom: 0.35rem;
  }

  .required {
    color: var(--color-danger);
    font-weight: 700;
  }

  .form-group-checkbox {
    margin-top: 0.25rem;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-text-main);
    cursor: pointer;
  }

  .checkbox-label input[type="checkbox"] {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--color-success);
    cursor: pointer;
  }

  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const alertBox = document.getElementById("admin-alert");
    const showAlert = (message) => {
      alertBox.textContent = message;
      alertBox.style.display = "block";
      alertBox.scrollIntoView({ behavior: "smooth", block: "nearest" });
    };
    const hideAlert = () => {
      alertBox.style.display = "none";
    };

    const run = async (path, options) => {
      const res = await fetch(path, options);
      const body = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(body.message || body.detail || `Error (${res.status})`);
      return body;
    };

    // Modal Crear Usuario
    const modal = document.getElementById("create-user-modal");
    const openModalBtn = document.getElementById("btn-open-create-user");
    const closeModalBtn = document.getElementById("btn-close-modal");
    const cancelModalBtn = document.getElementById("btn-cancel-modal");
    const createUserForm = document.getElementById("create-user-form");
    const modalAlert = document.getElementById("modal-alert");

    const openModal = () => {
      if (modal) {
        modal.style.display = "flex";
        createUserForm?.reset();
        if (modalAlert) modalAlert.style.display = "none";
        document.getElementById("new-username")?.focus();
      }
    };

    const closeModal = () => {
      if (modal) modal.style.display = "none";
    };

    openModalBtn?.addEventListener("click", openModal);
    closeModalBtn?.addEventListener("click", closeModal);
    cancelModalBtn?.addEventListener("click", closeModal);

    modal?.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });

    createUserForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById("btn-submit-modal");
      try {
        if (modalAlert) modalAlert.style.display = "none";
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = "Guardando...";
        }

        const username = document.getElementById("new-username")?.value.trim();
        const email = document.getElementById("new-email")?.value.trim();
        const password = document.getElementById("new-password")?.value;
        const name = document.getElementById("new-name")?.value.trim();
        const role = document.getElementById("new-role")?.value;
        const isAdmin = document.getElementById("new-is-admin")?.checked;

        await run("/api/admin/users", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            username,
            email,
            password,
            name: name || null,
            role,
            isAdmin
          })
        });

        window.location.reload();
      } catch (err) {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Guardar Usuario";
        }
        if (modalAlert) {
          modalAlert.textContent = err.message;
          modalAlert.style.display = "block";
        }
      }
    });

    document.querySelectorAll("[data-action='delete-community']").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const name = btn.dataset.name;
        if (!confirm(`¿Eliminar la comunidad "${name}" y todos sus miembros?`)) return;
        try {
          hideAlert();
          btn.disabled = true;
          await run(`/api/communities/${btn.dataset.id}`, { method: "DELETE" });
          window.location.reload();
        } catch (err) {
          btn.disabled = false;
          showAlert(err.message);
        }
      });
    });

    document.querySelectorAll("[data-action='verify-observation']").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const status = btn.dataset.status;
        const notes = status === "REJECTED"
          ? prompt("Motivo del rechazo (opcional):") ?? ""
          : null;
        try {
          hideAlert();
          btn.disabled = true;
          await run(`/api/admin/observations/${btn.dataset.id}`, {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ status, verificationNotes: notes }),
          });
          window.location.reload();
        } catch (err) {
          btn.disabled = false;
          showAlert(err.message);
        }
      });
    });

    document.querySelectorAll("[data-action='delete-observation']").forEach((btn) => {
      btn.addEventListener("click", async () => {
        if (!confirm("¿Eliminar esta observación? Esta acción no se puede deshacer.")) return;
        try {
          hideAlert();
          btn.disabled = true;
          await run(`/api/admin/observations/${btn.dataset.id}`, { method: "DELETE" });
          window.location.reload();
        } catch (err) {
          btn.disabled = false;
          showAlert(err.message);
        }
      });
    });

    document.querySelectorAll("[data-action='toggle-admin']").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const isCurrentAdmin = btn.dataset.admin === "true";
        const newIsAdmin = !isCurrentAdmin;
        const name = btn.dataset.name;
        const msg = newIsAdmin
          ? `¿Promover a "${name}" como Administrador?`
          : `¿Revocar privilegios de Administrador a "${name}"?`;
        if (!confirm(msg)) return;
        try {
          hideAlert();
          btn.disabled = true;
          await run(`/api/admin/users/${btn.dataset.id}`, {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ isAdmin: newIsAdmin }),
          });
          window.location.reload();
        } catch (err) {
          btn.disabled = false;
          showAlert(err.message);
        }
      });
    });

    document.querySelectorAll("[data-action='delete-user']").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const name = btn.dataset.name;
        if (!confirm(`¿Eliminar al usuario "${name}" y todos sus datos asociados? Esta acción no se puede deshacer.`)) return;
        try {
          hideAlert();
          btn.disabled = true;
          await run(`/api/admin/users/${btn.dataset.id}`, { method: "DELETE" });
          window.location.reload();
        } catch (err) {
          btn.disabled = false;
          showAlert(err.message);
        }
      });
    });
  });
</script>
