---
import Layout from "../../layouts/Layout.astro";
import { apiGet } from "../../lib/api/client.js";
import { getSessionUser } from "../../lib/middleware/auth.js";
import ConfirmDialog from "../../components/ui/ConfirmDialog.astro";

const user = await getSessionUser({ cookies: Astro.cookies, request: Astro.request });

if (!user) {
  return Astro.redirect("/auth/login");
}
if (!user.isAdmin) {
  return Astro.redirect("/");
}

let obsCount, obsPending, obsApproved, obsRejected, communityCount, speciesCount, userCount;
let communities = [];
let observations = [];
let users = [];

try {
  const data = await apiGet("/admin/dashboard");
  
  obsCount = data.stats.obsCount;
  obsPending = data.stats.obsPending;
  obsApproved = data.stats.obsApproved;
  obsRejected = data.stats.obsRejected;
  communityCount = data.stats.communityCount;
  speciesCount = data.stats.speciesCount;
  userCount = data.stats.userCount;
  
  communities = data.communities || [];
  observations = data.observations || [];
  users = data.users || [];
} catch (error) {
  console.error("Error fetching admin dashboard:", error);
}

const statusLabel = { PENDING: "Pendiente", APPROVED: "Aprobada", REJECTED: "Rechazada" };
const statusBadge = {
  PENDING: "badge-warning",
  APPROVED: "badge-success",
  REJECTED: "badge-danger",
};
const statusClass = { PENDING: "pending", APPROVED: "approved", REJECTED: "rejected" };
---

<Layout title="Panel Admin - EcoRaíces">
  <div class="admin-container">
    <header class="admin-header">
      <h1>Panel de Administración</h1>
      <p class="admin-subtitle">Gestión de datos generales y comunidades</p>
    </header>

    <!-- Stats -->
    <section class="stats-grid">
      <div class="stat-box">
        <span class="stat-value">{obsCount}</span>
        <span class="stat-label">Observaciones</span>
      </div>
      <div class="stat-box warning">
        <span class="stat-value">{obsPending}</span>
        <span class="stat-label">Pendientes de revisión</span>
      </div>
      <div class="stat-box success">
        <span class="stat-value">{obsApproved}</span>
        <span class="stat-label">Aprobadas</span>
      </div>
      <div class="stat-box danger">
        <span class="stat-value">{obsRejected}</span>
        <span class="stat-label">Rechazadas</span>
      </div>
      <div class="stat-box">
        <span class="stat-value">{communityCount}</span>
        <span class="stat-label">Comunidades</span>
      </div>
      <div class="stat-box">
        <span class="stat-value">{speciesCount}</span>
        <span class="stat-label">Especies</span>
      </div>
      <div class="stat-box">
        <span class="stat-value">{userCount}</span>
        <span class="stat-label">Usuarios</span>
      </div>
    </section>

    <!-- Comunidades -->
    <section class="panel-section card">
      <div class="section-head">
        <div>
          <h2>Comunidades</h2>
          <span class="muted">{communities.length} registradas</span>
        </div>
      </div>
      {communities.length === 0 ? (
        <p class="empty-state">No hay comunidades registradas.</p>
      ) : (
        <div class="cards-grid">
          {communities.map((c) => (
            <div class="entity-card">
              <div class="entity-card-header">
                <div class="entity-icon community-icon">👥</div>
                <div class="entity-title-wrap">
                  <a href={`/comunidades/${c.id}`} class="entity-title">{c.name}</a>
                  {c.location && <div class="entity-subtitle">📍 {c.location}</div>}
                </div>
              </div>

              <div class="entity-details-grid">
                <div class="detail-item">
                  <span class="detail-label">Propietario</span>
                  <span class="detail-value">@{c.owner?.username || "—"}</span>
                </div>
                <div class="detail-item">
                  <span class="detail-label">Miembros</span>
                  <span class="badge badge-neutral badge-mini">👥 {c._count.members}</span>
                </div>
                <div class="detail-item">
                  <span class="detail-label">Creada</span>
                  <span class="detail-value">{new Date(c.createdAt).toLocaleDateString("es-CO")}</span>
                </div>
              </div>

              <div class="entity-card-actions">
                <button
                  class="btn btn-danger-outline btn-sm btn-full"
                  data-action="delete-community"
                  data-id={c.id}
                  data-name={c.name}
                  aria-label={`Eliminar comunidad ${c.name}`}
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                  </svg>
                  Eliminar
                </button>
              </div>
            </div>
          ))}
        </div>
      )}
    </section>

    <!-- Observaciones -->
    <section class="panel-section card">
      <div class="section-head">
        <div>
          <h2>Observaciones</h2>
          <span class="muted">Últimas {observations.length} registradas</span>
        </div>
      </div>
      {observations.length === 0 ? (
        <p class="empty-state">No hay observaciones registradas.</p>
      ) : (
        <div class="cards-grid">
          {observations.map((o) => (
            <div class={`entity-card obs-card ${statusClass[o.status]}`}>
              <div class="entity-card-header">
                <div class="entity-icon obs-icon">🌳</div>
                <div class="entity-title-wrap">
                  <a href={`/observaciones/${o.id}`} class="entity-title">{o.species?.name || "Especie no identificada"}</a>
                  {o.species?.scientificName && (
                    <div class="entity-subtitle italic">{o.species.scientificName}</div>
                  )}
                </div>
                <span class={`badge ${statusBadge[o.status]}`}>{statusLabel[o.status]}</span>
              </div>

              <div class="entity-details-grid">
                <div class="detail-item">
                  <span class="detail-label">Registrado por</span>
                  <span class="detail-value">@{o.user?.username || "—"}</span>
                </div>
                <div class="detail-item">
                  <span class="detail-label">Fecha</span>
                  <span class="detail-value">{new Date(o.createdAt).toLocaleDateString("es-CO")}</span>
                </div>
              </div>

              <div class="entity-card-actions">
                {o.status !== "APPROVED" && (
                  <button
                    class="btn btn-primary btn-sm flex-1"
                    data-action="verify-observation"
                    data-id={o.id}
                    data-status="APPROVED"
                    aria-label={`Aprobar observación de ${o.species?.name || "especie"}`}
                  >
                    ✓ Aprobar
                  </button>
                )}
                {o.status !== "REJECTED" && (
                  <button
                    class="btn btn-secondary btn-sm flex-1"
                    data-action="verify-observation"
                    data-id={o.id}
                    data-status="REJECTED"
                    aria-label={`Rechazar observación de ${o.species?.name || "especie"}`}
                  >
                    ✕ Rechazar
                  </button>
                )}
                <button
                  class="btn btn-danger-outline btn-sm"
                  data-action="delete-observation"
                  data-id={o.id}
                  aria-label={`Eliminar observación`}
                  title="Eliminar observación"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                  </svg>
                </button>
              </div>
            </div>
          ))}
        </div>
      )}
    </section>

    <!-- Usuarios Registrados -->
    <section class="panel-section card">
      <div class="section-head">
        <div>
          <h2>Usuarios Registrados</h2>
          <span class="muted">{users.length} total</span>
        </div>
        <button type="button" id="btn-open-create-user" class="btn btn-primary btn-sm">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Nuevo Usuario
        </button>
      </div>
      {users.length === 0 ? (
        <p class="empty-state">No hay usuarios registrados.</p>
      ) : (
        <div class="cards-grid">
          {users.map((u) => (
            <div class="entity-card user-card">
              <div class="entity-card-header">
                {u.avatarUrl ? (
                  <img src={u.avatarUrl} alt={u.name || u.username} class="user-cell-avatar" />
                ) : (
                  <div class="user-cell-initial">{(u.name || u.username || 'U')[0].toUpperCase()}</div>
                )}
                <div class="entity-title-wrap">
                  <div class="entity-title user-name-wrap">
                    <span>{u.name || u.username}</span>
                    {u.id === user.id && <span class="badge badge-info badge-mini">Tú</span>}
                  </div>
                  <div class="entity-subtitle">@{u.username}</div>
                </div>
                {u.isAdmin ? (
                  <span class="badge badge-success">Admin</span>
                ) : (
                  <span class="badge badge-neutral">Usuario</span>
                )}
              </div>

              <div class="user-email-row">
                <span class="email-icon">✉</span>
                <span class="email-text" title={u.email}>{u.email}</span>
              </div>

              <div class="entity-details-grid">
                <div class="detail-item">
                  <span class="detail-label">Rol</span>
                  <span class="detail-value font-medium">
                    {u.role === "COMMUNITY" ? "Comunidad" : "Guardabosques"}
                  </span>
                </div>
                <div class="detail-item">
                  <span class="detail-label">Observaciones</span>
                  <span class="badge badge-accent badge-mini">🌳 {u.observationsCount}</span>
                </div>
                <div class="detail-item">
                  <span class="detail-label">Registro</span>
                  <span class="detail-value">{u.createdAt ? new Date(u.createdAt).toLocaleDateString("es-CO") : "—"}</span>
                </div>
              </div>

              {u.id !== user.id ? (
                <div class="entity-card-actions">
                  <button
                    class={`btn btn-sm flex-1 ${u.isAdmin ? 'btn-secondary' : 'btn-outline'}`}
                    data-action="toggle-admin"
                    data-id={u.id}
                    data-admin={u.isAdmin ? "true" : "false"}
                    data-name={u.name || u.username}
                    aria-label={`${u.isAdmin ? 'Quitar rol admin a' : 'Hacer admin a'} ${u.username}`}
                  >
                    {u.isAdmin ? "Quitar Admin" : "Hacer Admin"}
                  </button>
                  <button
                    class="btn btn-danger-outline btn-sm"
                    data-action="delete-user"
                    data-id={u.id}
                    data-name={u.name || u.username}
                    aria-label={`Eliminar usuario ${u.username}`}
                    title={`Eliminar usuario ${u.username}`}
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="3 6 5 6 21 6"></polyline>
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                    Eliminar
                  </button>
                </div>
              ) : (
                <div class="current-user-notice">
                  <span>Tu cuenta activa</span>
                </div>
              )}
            </div>
          ))}
        </div>
      )}
    </section>

    <!-- Modal Crear Usuario -->
    <div id="create-user-modal" class="modal-backdrop" style="display: none;">
      <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <div class="modal-header">
          <h3 id="modal-title">Registrar Nuevo Usuario</h3>
          <button type="button" id="btn-close-modal" class="modal-close" aria-label="Cerrar modal">✕</button>
        </div>
        <form id="create-user-form" class="modal-form">
          <div id="modal-alert" class="alert-box error" style="display: none;"></div>

          <div class="form-group">
            <label for="new-name" class="modal-label">Nombre completo</label>
            <input type="text" id="new-name" class="input" placeholder="Ej. Juan Pérez" />
          </div>

          <div class="form-row-2">
            <div class="form-group">
              <label for="new-username" class="modal-label">Usuario <span class="required">*</span></label>
              <input type="text" id="new-username" class="input" placeholder="juanperez" required autocomplete="off" />
            </div>

            <div class="form-group">
              <label for="new-email" class="modal-label">Correo <span class="required">*</span></label>
              <input type="email" id="new-email" class="input" placeholder="juan@ejemplo.com" required autocomplete="off" />
            </div>
          </div>

          <div class="form-row-2">
            <div class="form-group">
              <label for="new-password" class="modal-label">Contraseña <span class="required">*</span></label>
              <input type="password" id="new-password" class="input" placeholder="Mínimo 6 carácteres" required minlength="6" />
            </div>

            <div class="form-group">
              <label for="new-role" class="modal-label">Rol inicial</label>
              <select id="new-role" class="select">
                <option value="COLLECTOR">Guardabosques</option>
                <option value="COMMUNITY">Comunidad</option>
              </select>
            </div>
          </div>

          <div class="form-group-checkbox">
            <label class="checkbox-label">
              <input type="checkbox" id="new-is-admin" />
              <span>Conceder rol de Administrador</span>
            </label>
          </div>

          <div class="modal-actions">
            <button type="button" id="btn-cancel-modal" class="btn btn-secondary">Cancelar</button>
            <button type="submit" id="btn-submit-modal" class="btn btn-primary">Guardar Usuario</button>
          </div>
        </form>
      </div>
    </div>

    <div id="admin-alert" class="alert-box error" role="alert" aria-live="polite" style="display: none;"></div>
  </div>
  <ConfirmDialog id="admin-confirm" title="Confirmar" message="¿Seguro?" confirmText="Confirmar" cancelText="Cancelar" variant="danger" />
  <ConfirmDialog id="admin-prompt" title="Motivo del rechazo" message="Indica el motivo (opcional):" confirmText="Confirmar" cancelText="Cancelar" variant="primary" showInput={true} inputLabel="Motivo" inputPlaceholder="Motivo del rechazo (opcional)" />
</Layout>

<style>
  .admin-container {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .admin-header h1 {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-primary-dark);
    letter-spacing: -0.02em;
  }

  .admin-subtitle {
    color: var(--color-text-light);
    margin-top: 0.25rem;
    font-size: 0.95rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.85rem;
    width: 100%;
  }

  @media (max-width: 960px) {
    .stats-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 640px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.65rem;
    }

    .admin-header h1 {
      font-size: 1.6rem;
    }
  }

  .stat-box {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.1rem 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    box-shadow: var(--shadow-sm);
    min-width: 0;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .stat-box:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
  }

  .stat-box.warning { border-top: 3px solid var(--color-warning); }
  .stat-box.success { border-top: 3px solid var(--color-success); }
  .stat-box.danger  { border-top: 3px solid var(--color-danger); }

  .stat-value {
    font-family: var(--font-heading);
    font-size: 1.7rem;
    font-weight: 800;
    color: #1f2937;
    line-height: 1.2;
  }

  .stat-label {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    line-height: 1.3;
  }

  .panel-section {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg, 16px);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
    width: 100%;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .panel-section {
      padding: 1rem 0.75rem;
    }
  }

  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .section-head h2 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary-dark);
  }

  .muted {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .empty-state {
    color: var(--color-text-muted);
    padding: 1.5rem 0;
    text-align: center;
    font-size: 0.95rem;
  }

  /* Cards Grid Layout (Sin Scroll Horizontal) */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.15rem;
    width: 100%;
  }

  @media (max-width: 640px) {
    .cards-grid {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }
  }

  .entity-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 12px);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .entity-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(15, 23, 42, 0.08);
    border-color: #cbd5e1;
  }

  .entity-card.rejected {
    background: #fff8f8;
    border-color: #fecaca;
  }

  .entity-card.approved {
    border-left: 4px solid var(--color-success);
  }

  .entity-card.pending {
    border-left: 4px solid var(--color-warning);
  }

  .entity-card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .entity-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .community-icon {
    background: #eff6ff;
  }

  .obs-icon {
    background: #ecfdf5;
  }

  .entity-title-wrap {
    flex: 1;
    min-width: 0;
  }

  .entity-title {
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-primary-dark);
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-decoration: none;
  }

  .entity-title:hover {
    color: var(--color-success);
    text-decoration: underline;
  }

  .user-name-wrap {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .entity-subtitle {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: 0.15rem;
  }

  .italic {
    font-style: italic;
  }

  .user-email-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    background: #f8fafc;
    padding: 0.4rem 0.65rem;
    border-radius: var(--radius-sm, 8px);
    overflow: hidden;
  }

  .email-icon {
    font-size: 0.9rem;
  }

  .email-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .entity-details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
    gap: 0.5rem;
    background: #f8fafc;
    padding: 0.65rem 0.75rem;
    border-radius: var(--radius-sm, 8px);
    border: 1px solid #f1f5f9;
  }

  .detail-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .detail-label {
    font-size: 0.7rem;
    color: var(--color-text-light);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }

  .detail-value {
    font-size: 0.83rem;
    color: var(--color-text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .font-medium {
    font-weight: 600;
  }

  .entity-card-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
    border-top: 1px dashed var(--color-border);
  }

  .flex-1 {
    flex: 1;
  }

  .btn-full {
    width: 100%;
  }

  .badge-mini {
    padding: 0.15rem 0.5rem;
    font-size: 0.7rem;
  }

  .current-user-notice {
    margin-top: auto;
    padding: 0.45rem 0.75rem;
    background: #eff6ff;
    color: #1e40af;
    border-radius: var(--radius-sm, 8px);
    font-size: 0.75rem;
    font-weight: 600;
    text-align: center;
  }

  .user-cell-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .user-cell-initial {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--color-success-bg, #e8f5e9);
    color: var(--color-primary-dark, #1b5e20);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    flex-shrink: 0;
  }
  /* Modal de Crear Usuario */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.5);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 1rem;
  }

  .modal-dialog {
    background: #ffffff;
    border-radius: var(--radius-lg, 16px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
    width: 100%;
    max-width: 520px;
    overflow: hidden;
    animation: modalPop 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes modalPop {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .modal-header h3 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-primary-dark);
  }

  .modal-close {
    background: none;
    border: none;
    font-size: 1.25rem;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .modal-close:hover {
    color: var(--color-text-main);
    background: #f1f5f9;
  }

  .modal-form {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 520px) {
    .form-row-2 {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }

  .modal-label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-main);
    margin-bottom: 0.35rem;
  }

  .required {
    color: var(--color-danger);
    font-weight: 700;
  }

  .form-group-checkbox {
    margin-top: 0.25rem;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-text-main);
    cursor: pointer;
  }

  .checkbox-label input[type="checkbox"] {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--color-success);
    cursor: pointer;
  }

  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const alertBox = document.getElementById("admin-alert");
    const showAlert = (message) => {
      console.error('[admin]', message);
      alertBox.textContent = message;
      alertBox.style.display = "block";
      alertBox.scrollIntoView({ behavior: "smooth", block: "nearest" });
    };
    const hideAlert = () => {
      alertBox.style.display = "none";
    };

    // Fase 3: diálogos accesibles con fallback nativo
    const askConfirm = (title, message) => {
      const dialog = document.getElementById('admin-confirm');
      if (dialog && typeof dialog.showModal === 'function') {
        dialog.querySelector('h2').textContent = title;
        dialog.querySelector('p').textContent = message;
        return new Promise((resolve) => {
          const onConfirm = (e) => {
            dialog.removeEventListener('confirm', onConfirm);
            resolve(!!e.detail?.confirmed);
          };
          dialog.addEventListener('confirm', onConfirm, { once: true });
          dialog.showModal();
        });
      }
      return Promise.resolve(window.confirm(`${title}\n${message}`));
    };
    const askNotes = () => {
      const dialog = document.getElementById('admin-prompt');
      if (dialog && typeof dialog.showModal === 'function') {
        const input = dialog.querySelector('input[name="dialogInput"]');
        if (input) input.value = '';
        return new Promise((resolve) => {
          const onConfirm = (e) => {
            dialog.removeEventListener('confirm', onConfirm);
            resolve(e.detail?.confirmed ? (e.detail?.value ?? '') : null);
          };
          dialog.addEventListener('confirm', onConfirm, { once: true });
          dialog.showModal();
        });
      }
      const v = window.prompt('Motivo del rechazo (opcional):');
      return Promise.resolve(v === null ? null : (v ?? ''));
    };

    const run = async (path, options) => {
      const res = await fetch(path, options);
      const body = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(body.message || body.detail || `Error (${res.status})`);
      return body;
    };

    // Modal Crear Usuario
    const modal = document.getElementById("create-user-modal");
    const openModalBtn = document.getElementById("btn-open-create-user");
    const closeModalBtn = document.getElementById("btn-close-modal");
    const cancelModalBtn = document.getElementById("btn-cancel-modal");
    const createUserForm = document.getElementById("create-user-form");
    const modalAlert = document.getElementById("modal-alert");

    const openModal = () => {
      if (modal) {
        modal.style.display = "flex";
        createUserForm?.reset();
        if (modalAlert) modalAlert.style.display = "none";
        document.getElementById("new-username")?.focus();
      }
    };

    const closeModal = () => {
      if (modal) modal.style.display = "none";
    };

    openModalBtn?.addEventListener("click", openModal);
    closeModalBtn?.addEventListener("click", closeModal);
    cancelModalBtn?.addEventListener("click", closeModal);

    modal?.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });

    createUserForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById("btn-submit-modal");
      try {
        if (modalAlert) modalAlert.style.display = "none";
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = "Guardando...";
        }

        const username = document.getElementById("new-username")?.value.trim();
        const email = document.getElementById("new-email")?.value.trim().toLowerCase();
        const password = document.getElementById("new-password")?.value;
        const name = document.getElementById("new-name")?.value.trim();
        const role = document.getElementById("new-role")?.value;
        const isAdmin = document.getElementById("new-is-admin")?.checked;

        // Fase 3: validación cliente antes del POST
        const failModal = (msg) => {
          if (modalAlert) {
            modalAlert.textContent = msg;
            modalAlert.style.display = "block";
          }
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = "Guardar Usuario";
          }
        };
        if (!username || username.length < 3) { failModal('Usuario mínimo 3 caracteres.'); return; }
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email || '')) { failModal('Email inválido.'); return; }
        if (!password || password.length < 8 || !/[a-zA-Z]/.test(password) || !/[0-9]/.test(password)) {
          failModal('Contraseña: mínimo 8 caracteres, letra y número.');
          return;
        }

        await run("/api/admin/users", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            username,
            email,
            password,
            name: name || null,
            role,
            isAdmin
          })
        });

        window.location.reload();
      } catch (err) {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Guardar Usuario";
        }
        if (modalAlert) {
          modalAlert.textContent = err.message;
          modalAlert.style.display = "block";
        }
      }
    });

    document.querySelectorAll("[data-action='delete-community']").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const name = btn.dataset.name;
        const ok = await askConfirm('Eliminar comunidad', `¿Eliminar la comunidad "${name}" y todos sus miembros?`);
        if (!ok) return;
        try {
          hideAlert();
          btn.disabled = true;
          await run(`/api/communities/${btn.dataset.id}`, { method: "DELETE" });
          window.location.reload();
        } catch (err) {
          btn.disabled = false;
          showAlert(err.message);
        }
      });
    });

    document.querySelectorAll("[data-action='verify-observation']").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const status = btn.dataset.status;
        let notes = null;
        if (status === "REJECTED") {
          notes = await askNotes();
          if (notes === null) return; // cancelado
        }
        try {
          hideAlert();
          btn.disabled = true;
          await run(`/api/admin/observations/${btn.dataset.id}`, {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ status, verificationNotes: notes }),
          });
          window.location.reload();
        } catch (err) {
          btn.disabled = false;
          showAlert(err.message);
        }
      });
    });

    document.querySelectorAll("[data-action='delete-observation']").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const ok = await askConfirm('Eliminar observación', '¿Eliminar esta observación? Esta acción no se puede deshacer.');
        if (!ok) return;
        try {
          hideAlert();
          btn.disabled = true;
          await run(`/api/admin/observations/${btn.dataset.id}`, { method: "DELETE" });
          window.location.reload();
        } catch (err) {
          btn.disabled = false;
          showAlert(err.message);
        }
      });
    });

    document.querySelectorAll("[data-action='toggle-admin']").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const isCurrentAdmin = btn.dataset.admin === "true";
        const newIsAdmin = !isCurrentAdmin;
        const name = btn.dataset.name;
        const msg = newIsAdmin
          ? `¿Promover a "${name}" como Administrador?`
          : `¿Revocar privilegios de Administrador a "${name}"?`;
        const okToggle = await askConfirm('Cambiar rol', msg);
        if (!okToggle) return;
        try {
          hideAlert();
          btn.disabled = true;
          await run(`/api/admin/users/${btn.dataset.id}`, {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ isAdmin: newIsAdmin }),
          });
          window.location.reload();
        } catch (err) {
          btn.disabled = false;
          showAlert(err.message);
        }
      });
    });

    document.querySelectorAll("[data-action='delete-user']").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const name = btn.dataset.name;
        const ok = await askConfirm('Eliminar usuario', `¿Eliminar al usuario "${name}" y todos sus datos asociados? Esta acción no se puede deshacer.`);
        if (!ok) return;
        try {
          hideAlert();
          btn.disabled = true;
          await run(`/api/admin/users/${btn.dataset.id}`, { method: "DELETE" });
          window.location.reload();
        } catch (err) {
          btn.disabled = false;
          showAlert(err.message);
        }
      });
    });
  });
</script>
