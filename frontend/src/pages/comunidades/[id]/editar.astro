---
import Layout from '../../../layouts/Layout.astro';
import CommunityLocationPicker from '../../../components/observations/CommunityLocationPicker.astro';
import { apiGet } from '../../../lib/api/client.js';
import { getSessionUser } from '../../../lib/middleware/auth.js';

export const prerender = false;

const { id } = Astro.params;
const user = await getSessionUser({ cookies: Astro.cookies, request: Astro.request });

if (!user) {
  return Astro.redirect(`/auth/login?redirect=${Astro.url.pathname}`);
}

let community = null;

try {
  const data = await apiGet(`/communities/${id}`);
  community = data.community;
} catch (error) {
  return Astro.redirect('/comunidades');
}

if (!community || (community.ownerId !== user.id && !user.isAdmin)) {
  return Astro.redirect('/comunidades');
}

const title = `Editar ${community.name} - EcoRaíces`;
---

<Layout title={title}>
  <div class="container">
    <div class="breadcrumbs">
      <a href="/">Inicio</a>
      <span aria-hidden="true">›</span>
      <a href="/comunidades">Comunidades</a>
      <span aria-hidden="true">›</span>
      <a href={`/comunidades/${community.id}`}>{community.name}</a>
      <span aria-hidden="true">›</span>
      <span class="current">Editar</span>
    </div>

    <div class="card form-card">
      <h1 class="page-title">Editar comunidad</h1>

      <div id="alert" class="alert-box" style="display: none;"></div>

      <form id="edit-form" class="form" novalidate>
        <div class="form-group">
          <label for="name">Nombre de la comunidad *</label>
          <input type="text" id="name" name="name" class="input" required value={community.name} />
        </div>

        <div class="form-group">
          <label for="description">Descripción</label>
          <textarea id="description" name="description" class="textarea" rows="4">{community.description || ''}</textarea>
        </div>

        <div class="form-group">
          <label for="location">Ubicación (texto)</label>
          <input type="text" id="location" name="location" class="input" value={community.location || ''} placeholder="Ej. Riohacha, La Guajira" />
        </div>

        <div class="form-group">
          <label>Ubicación Exacta en el Mapa</label>
          <CommunityLocationPicker
            initialLat={community.latitude}
            initialLng={community.longitude}
          />
        </div>

        <div class="flex gap-1">
          <button type="submit" id="submit-btn" class="btn btn-accent">
            Guardar cambios
          </button>
          <a href={`/comunidades/${community.id}`} class="btn btn-secondary">
            Cancelar
          </a>
        </div>
      </form>
    </div>
  </div>

  <script define:vars={{ communityId: community.id }}>
    const form = document.getElementById('edit-form');
    const alertBox = document.getElementById('alert');
    const submitBtn = document.getElementById('submit-btn');

    const showAlert = (message, type = 'error') => {
      alertBox.textContent = message;
      alertBox.className = `alert-box ${type}`;
      alertBox.style.display = 'block';
    };

    const fail = (message) => {
      showAlert(message, 'error');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Guardar cambios';
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      alertBox.style.display = 'none';

      const fd = new FormData(form);
      const name = (fd.get('name') ?? '').toString().trim();
      const description = (fd.get('description') ?? '').toString().trim() || null;
      const location = (fd.get('location') ?? '').toString().trim() || null;
      const latRaw = fd.get('latitude');
      const lngRaw = fd.get('longitude');

      if (!name) {
        fail('El nombre de la comunidad es obligatorio.');
        return;
      }
      if (name.length > 120) {
        fail('El nombre no puede superar 120 caracteres.');
        return;
      }
      let latitude = null;
      let longitude = null;
      if ((latRaw ?? '') !== '' && (lngRaw ?? '') !== '') {
        const lat = parseFloat(latRaw);
        const lng = parseFloat(lngRaw);
        if (Number.isNaN(lat) || Number.isNaN(lng) || lat < -90 || lat > 90 || lng < -180 || lng > 180) {
          fail('Coordenadas inválidas. Marca el punto en el mapa.');
          return;
        }
        latitude = lat;
        longitude = lng;
      }
      const payload = { name, description, location, latitude, longitude };

      submitBtn.disabled = true;
      submitBtn.textContent = 'Guardando...';

      try {
        const res = await fetch(`/api/communities/${communityId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.message || 'No se pudieron guardar los cambios.');

        showAlert('Cambios guardados.', 'success');
        setTimeout(() => {
          window.location.href = `/comunidades/${communityId}`;
        }, 900);
      } catch (err) {
        console.error('[comunidades/editar]', err);
        showAlert(err.message || 'No se pudieron guardar los cambios.');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Guardar cambios';
      }
    });
  </script>

  <style>
    .container {
      max-width: 720px;
      margin: 0 auto;
      padding: 1.5rem 1rem;
    }

    .breadcrumbs {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.9rem;
      color: var(--color-text-muted);
      margin-bottom: 1.5rem;
    }

    .breadcrumbs a { color: var(--color-primary); }
    .breadcrumbs a:hover { text-decoration: underline; }
    .breadcrumbs .current { font-weight: 500; color: var(--color-text-main); }

    .form-card { padding: 2rem; }
    .form-card .page-title { margin-bottom: 1.75rem; font-size: 1.8rem; }
  </style>
</Layout>
