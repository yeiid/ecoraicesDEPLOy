---
import Layout from "../../layouts/Layout.astro";
import NewObservationForm from "../../components/observations/NewObservationForm.astro";
import { getSessionUser } from '../../lib/middleware/auth.js';
import { apiGet } from '../../lib/api/client.js';

// 🔐 Verificar estado de sesión y token
const user = await getSessionUser({ cookies: Astro.cookies, request: Astro.request });

// Redirigir si no está autenticado
if (!user) {
  return Astro.redirect(`/auth/login?redirect=${Astro.url.pathname}`);
}

// Obtener las categorías, especies y comunidades para el formulario (en paralelo)
let categories = [];
let species = [];
let communities = [];
{
  const [catsRes, speciesRes, commsRes] = await Promise.all([
    apiGet('/categories').catch((e) => {
      console.error('Error fetching categories:', e);
      return [];
    }),
    apiGet('/species').catch((e) => {
      console.error('Error fetching species:', e);
      return [];
    }),
    apiGet('/communities').catch((e) => {
      console.error('Error fetching communities:', e);
      return [];
    }),
  ]);
  categories = catsRes || [];
  species = speciesRes || [];
  communities = commsRes || [];
}

// Título de la página
const title = "Registro Rápido de Árboles - EcoRaíces";
---

<Layout title={title}>
  <div class="new-observation-page">
    <div class="page-header">
      <h1>Formulario de Registro de Especies</h1>
    </div>

    <div class="form-container">
      <NewObservationForm
        categories={categories}
        speciesList={species}
        communities={communities}
        userId={user.id}
      />
    </div>
  </div>
</Layout>

<style>
  .new-observation-page {
    max-width: 580px;
    margin: 1.5rem auto 3rem;
    padding: 0 1rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .page-header h1 {
    font-size: 1.75rem;
    font-weight: 800;
    color: #1e293b;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .form-container {
    width: 100%;
  }

  @media (max-width: 640px) {
    .new-observation-page {
      margin-top: 0.75rem;
      padding: 0 0.75rem;
    }
    .page-header h1 {
      font-size: 1.4rem;
    }
  }
</style>
