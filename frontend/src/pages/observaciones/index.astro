---
import Layout from '../../layouts/Layout.astro';
import ObservationsMap from '../../components/observations/ObservationsMap.astro';

// Obtener filtro de categoría de la URL, si existe
const { searchParams } = Astro.url;
const categoryId = searchParams.get('categoria') || null;

const title = "Explorador Territorial de Especies - EcoRaíces";
---

<Layout title={title}>
  <div class="observations-page-container">
    <!-- Header Minimalista y Funcional -->
    <header class="explorer-header">
      <div class="header-titles">
        <div class="header-badge">
          <span class="live-dot"></span>
          <span>SIG Territorial · La Guajira</span>
        </div>
        <h1 class="main-title">Explorador Forestal</h1>
        <p class="subtitle">
          Cartografía botánica comunitaria: monitoreo de flora nativa resiliente y alerta temprana contra especies invasoras (Neem).
        </p>
      </div>

      <div class="header-actions">
        <a href="/observaciones/nueva" class="btn-register-tree">
          <span class="plus-icon">+</span>
          <span>Registrar Árbol</span>
        </a>
      </div>
    </header>

    <!-- Map Section -->
    <main class="map-showcase-section">
      <ObservationsMap
        initialFilterCategory={categoryId}
        showFilters={true}
      />
    </main>

    <!-- Guía Rápida Minimalista -->
    <section class="minimal-contribution-guide">
      <div class="guide-header">
        <h2>¿Cómo participar en el censo arbóreo?</h2>
        <p>Tu registro aporta datos científicos para restaurar el bosque seco guajiro.</p>
      </div>

      <div class="guide-steps-grid">
        <div class="guide-card">
          <span class="guide-num">1</span>
          <h3>Identifica</h3>
          <p>Localiza un árbol en tu sector (árbol nativo o foco de Neem).</p>
        </div>

        <div class="guide-card">
          <span class="guide-num">2</span>
          <h3>Geolocaliza</h3>
          <p>Captura las coordenadas precisas con el GPS de tu dispositivo.</p>
        </div>

        <div class="guide-card">
          <span class="guide-num">3</span>
          <h3>Documenta</h3>
          <p>Sube fotos de hojas, corteza y flores para verificación botánica.</p>
        </div>

        <div class="guide-card">
          <span class="guide-num">4</span>
          <h3>Acción Territorial</h3>
          <p>Promueve la conservación o solicita jornadas de sustitución ecológica.</p>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .observations-page-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.25rem 3rem;
  }

  /* Header Minimalista */
  .explorer-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin: 1.25rem 0 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border, #e2e8f0);
  }

  .header-titles {
    max-width: 780px;
  }

  .header-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(16, 185, 129, 0.12);
    color: #065f46;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    margin-bottom: 0.5rem;
    border: 1px solid rgba(16, 185, 129, 0.25);
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #10b981;
    box-shadow: 0 0 6px #10b981;
  }

  .main-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-text-main, #0f172a);
    margin: 0 0 0.4rem 0;
    line-height: 1.15;
  }

  .subtitle {
    font-size: 0.95rem;
    color: var(--color-text-muted, #64748b);
    margin: 0;
    line-height: 1.45;
  }

  .btn-register-tree {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #047857;
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 700;
    padding: 9px 18px;
    border-radius: 10px;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(4, 120, 87, 0.25);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
  }

  .btn-register-tree:hover {
    background: #065f46;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(4, 120, 87, 0.35);
  }

  .plus-icon {
    font-size: 1.2rem;
    line-height: 1;
  }

  /* Sección Principal del Mapa */
  .map-showcase-section {
    margin-bottom: 2.5rem;
  }

  /* Guía de Contribución Minimalista */
  .minimal-contribution-guide {
    background: var(--color-card, #ffffff);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 14px;
    padding: 1.75rem 2rem;
    box-shadow: 0 2px 10px rgba(15, 23, 42, 0.03);
  }

  .guide-header {
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .guide-header h2 {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--color-text-main, #0f172a);
    margin: 0 0 0.35rem 0;
  }

  .guide-header p {
    font-size: 0.88rem;
    color: var(--color-text-muted, #64748b);
    margin: 0;
  }

  .guide-steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .guide-card {
    background: var(--color-bg-secondary, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 10px;
    padding: 1.25rem;
    position: relative;
    transition: transform 0.2s ease;
  }

  .guide-card:hover {
    transform: translateY(-2px);
  }

  .guide-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: #10b981;
    color: #ffffff;
    font-size: 12px;
    font-weight: 800;
    margin-bottom: 0.75rem;
  }

  .guide-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-main, #0f172a);
    margin: 0 0 0.35rem 0;
  }

  .guide-card p {
    font-size: 0.82rem;
    color: var(--color-text-muted, #64748b);
    margin: 0;
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    .explorer-header {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
    }
    .btn-register-tree {
      justify-content: center;
    }
    .main-title {
      font-size: 1.6rem;
    }
    .minimal-contribution-guide {
      padding: 1.25rem;
    }
  }
</style>
