---
import Layout from "../../layouts/Layout.astro";
import { apiGet } from "../../lib/api/client.js";
import { getSessionUser, getToken, TOKEN_NAME } from "../../lib/middleware/auth.js";

const user = await getSessionUser({ cookies: Astro.cookies, request: Astro.request });

if (!user) {
  return Astro.redirect("/auth/login");
}

let profile = { ...user };
let observations = [];
let communities = [];

try {
  const token = getToken({ cookies: Astro.cookies, request: Astro.request });
  const headers = {};
  if (token) {
    headers["Cookie"] = `${TOKEN_NAME}=${token}`;
    headers["Authorization"] = `Bearer ${token}`;
  }
  
  const data = await apiGet("/users/me/profile", { headers });
  if (data && data.profile) {
    profile = { ...user, ...data.profile };
    observations = data.observations || [];
    communities = data.communities || [];
  }
} catch (error) {
  console.error("Error fetching profile from FastAPI:", error);
}

const statusLabel = { PENDING: "Pendiente", APPROVED: "Aprobada", REJECTED: "Rechazada" };
const statusBadge = {
  PENDING: "badge-warning",
  APPROVED: "badge-success",
  REJECTED: "badge-danger",
};
---

<Layout title="Mi Perfil - EcoRaíces">
  <div class="profile-container">
    <header class="profile-header">
      <div class="profile-avatar">
        {profile.avatarUrl ? (
          <img src={profile.avatarUrl} alt={profile.name || profile.username} class="avatar-img" />
        ) : (
          <span class="avatar-initial">{(profile.name || profile.username)[0].toUpperCase()}</span>
        )}
      </div>
      <div class="profile-heading">
        <h1>{profile.name || profile.username}</h1>
        <p class="profile-sub">
          @{profile.username} · {profile.isAdmin ? "Administrador" : profile.role === "COMMUNITY" ? "Comunidad" : "Guardabosques"}
          {profile.location && <span class="profile-location"> · 📍 {profile.location}</span>}
        </p>
      </div>
    </header>

    <div class="profile-grid">
      <!-- Editar perfil -->
      <section class="card profile-card">
        <h2 class="card-title">Editar perfil</h2>

        <div id="profile-alert" class="alert-box error" role="alert" aria-live="polite" style="display: none; margin-bottom: 1rem;"></div>
        <div id="profile-success" class="alert-box success" role="alert" aria-live="polite" style="display: none; margin-bottom: 1rem;"></div>

        <form id="profile-form">
          <div class="form-group">
            <label for="name">Nombre</label>
            <input type="text" id="name" name="name" value={profile.name || ""} class="input">
          </div>
          <div class="form-group">
            <label for="username">Nombre de usuario</label>
            <input type="text" id="username" name="username" value={profile.username} class="input">
          </div>
          <div class="form-group">
            <label for="email">Correo electrónico</label>
            <input type="email" id="email" name="email" value={profile.email} class="input">
          </div>
          <div class="form-group">
            <label for="location">Municipio / Territorio (Colombia)</label>
            <input type="text" id="location" name="location" list="municipios-colombia" value={profile.location || ""} class="input" placeholder="Ej. Riohacha, Santa Marta, Medellín, Bogotá, Cali...">
            <datalist id="municipios-colombia">
              <!-- La Guajira (Fase Pionera) -->
              <option value="Riohacha, La Guajira" />
              <option value="Dibulla, La Guajira" />
              <option value="Manaure, La Guajira" />
              <option value="Maicao, La Guajira" />
              <option value="Uribia, La Guajira" />
              <option value="San Juan del Cesar, La Guajira" />
              <option value="Fonseca, La Guajira" />
              <option value="Barrancas, La Guajira" />
              <option value="Albania, La Guajira" />
              <option value="Hatonuevo, La Guajira" />
              <option value="Villanueva, La Guajira" />
              <option value="Distracción, La Guajira" />
              <option value="Cabo de la Vela, La Guajira" />
              <option value="Nazareth (Alta Guajira)" />
              <option value="Serranía de la Macuira" />
              <!-- Cobertura Nacional Colombia -->
              <option value="Santa Marta, Magdalena" />
              <option value="Barranquilla, Atlántico" />
              <option value="Cartagena, Bolívar" />
              <option value="Valledupar, Cesar" />
              <option value="Montería, Córdoba" />
              <option value="Sincelejo, Sucre" />
              <option value="San Andrés Islas" />
              <option value="Bogotá D.C." />
              <option value="Medellín, Antioquia" />
              <option value="Cali, Valle del Cauca" />
              <option value="Bucaramanga, Santander" />
              <option value="Cúcuta, Norte de Santander" />
              <option value="Pereira, Risaralda" />
              <option value="Manizales, Caldas" />
              <option value="Armenia, Quindío" />
              <option value="Ibagué, Tolima" />
              <option value="Neiva, Huila" />
              <option value="Villavicencio, Meta" />
              <option value="Pasto, Nariño" />
              <option value="Popayán, Cauca" />
              <option value="Leticia, Amazonas" />
              <option value="Quibdó, Chocó" />
              <option value="Yopal, Casanare" />
            </datalist>
            <small class="text-muted" style="font-size: 0.8rem; display: block; margin-top: 0.25rem;">
              Tu territorio nos permite conectarte con las comunidades locales y observaciones de tu región en Colombia.
            </small>
          </div>
          <div class="form-group">
            <label for="avatarUrl">URL de la foto de perfil</label>
            <input type="url" id="avatarUrl" name="avatarUrl" value={profile.avatarUrl || ""} class="input" placeholder="https://ejemplo.com/foto.jpg" maxlength="500">
          </div>
          <div class="form-group">
            <label for="bio">Biografía</label>
            <textarea id="bio" name="bio" rows="3" maxlength="500" class="textarea" placeholder="Cuéntanos sobre ti...">{profile.bio || ""}</textarea>
          </div>
          <button type="submit" class="btn btn-primary">Guardar cambios</button>
        </form>
      </section>

      <!-- Cambiar contraseña -->
      <section class="card profile-card">
        <h2 class="card-title">Cambiar contraseña</h2>

        <div id="password-alert" class="alert-box error" role="alert" aria-live="polite" style="display: none; margin-bottom: 1rem;"></div>
        <div id="password-success" class="alert-box success" role="alert" aria-live="polite" style="display: none; margin-bottom: 1rem;"></div>

        <form id="password-form">
          <div class="form-group">
            <label for="currentPassword">Contraseña actual</label>
            <input type="password" id="currentPassword" name="currentPassword" class="input" autocomplete="current-password" required>
          </div>
          <div class="form-group">
            <label for="newPassword">Nueva contraseña</label>
            <input type="password" id="newPassword" name="newPassword" class="input" minlength="8" autocomplete="new-password" required>
          </div>
          <button type="submit" class="btn btn-secondary">Actualizar contraseña</button>
        </form>
      </section>
    </div>

    <!-- Mis observaciones -->
    <section class="card profile-card">
      <div class="section-head">
        <h2 class="card-title">Mis observaciones</h2>
        <a href="/observaciones/nueva" class="btn btn-primary btn-sm">+ Nueva</a>
      </div>
      {observations.length === 0 ? (
        <p class="empty-state">Aún no has registrado observaciones.</p>
      ) : (
        <div class="obs-list">
          {observations.map((o) => (
            <a href={`/observaciones/${o.id}`} class="obs-item">
              {o.species?.imageUrl ? (
                <img src={o.species.imageUrl} alt={o.species.name} class="obs-thumb" loading="lazy" />
              ) : (
                <div class="obs-thumb placeholder">🌿</div>
              )}
              <div class="obs-info">
                <span class="obs-name">{o.species?.name || "Sin especie"}</span>
                <span class="obs-date">{new Date(o.createdAt).toLocaleDateString("es-CO")} · {o.latitude.toFixed(4)}, {o.longitude.toFixed(4)}</span>
              </div>
              <span class={`badge ${statusBadge[o.status]}`}>{statusLabel[o.status]}</span>
            </a>
          ))}
        </div>
      )}
    </section>

    <!-- Mis comunidades -->
    <section class="card profile-card">
      <div class="section-head">
        <h2 class="card-title">Mis comunidades</h2>
        <a href="/comunidades/nueva" class="btn btn-primary btn-sm">+ Crear</a>
      </div>
      {communities.length === 0 ? (
        <p class="empty-state">No perteneces a ninguna comunidad.</p>
      ) : (
        <div class="obs-list">
          {communities.map((c) => (
            <a href={`/comunidades/${c.id}`} class="obs-item">
              <div class="obs-info">
                <span class="obs-name">{c.name}</span>
                <span class="obs-date">{c.location || "Sin ubicación"}</span>
              </div>
              <span class="badge badge-neutral">{c.role || "Miembro"}</span>
            </a>
          ))}
        </div>
      )}
    </section>
  </div>
</Layout>

<style>
  .profile-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .profile-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .profile-avatar {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-success-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 3px solid var(--color-success);
    flex-shrink: 0;
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .avatar-initial {
    font-family: var(--font-heading);
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--color-success-dark);
  }

  .profile-heading h1 {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-primary-dark);
  }

  .profile-sub {
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }

  .profile-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .profile-card {
    padding: 1.75rem;
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-bottom: 1.25rem;
  }

  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .section-head .card-title {
    margin-bottom: 0;
  }

  .form-group {
    margin-bottom: 1.1rem;
  }

  .form-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.35rem;
  }

  .empty-state {
    color: var(--color-text-muted);
    padding: 0.5rem 0;
  }

  .obs-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .obs-item {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: box-shadow 0.2s;
  }

  .obs-item:hover {
    box-shadow: var(--shadow-hover);
  }

  .obs-thumb {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-sm);
    object-fit: cover;
    flex-shrink: 0;
  }

  .obs-thumb.placeholder {
    background: var(--color-success-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
  }

  .obs-info {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .obs-name {
    font-weight: 600;
    color: var(--color-primary-dark);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .obs-date {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .profile-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const setBox = (id, message, type) => {
      const box = document.getElementById(id);
      box.textContent = message;
      box.className = `alert-box ${type}`;
      box.style.display = "block";
    };
    const hide = (id) => {
      document.getElementById(id).style.display = "none";
    };

    const profileForm = document.getElementById("profile-form");
    if (profileForm) {
      profileForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        hide("profile-alert");
        hide("profile-success");

        const raw = Object.fromEntries(new FormData(profileForm).entries());
        const btn = profileForm.querySelector("button[type='submit']");
        // Fase 3: trim + límites + avatar http(s) únicamente
        const data = {
          name: (raw.name ?? '').toString().trim().slice(0, 120),
          username: (raw.username ?? '').toString().trim().slice(0, 60),
          email: (raw.email ?? '').toString().trim().toLowerCase().slice(0, 254),
          location: (raw.location ?? '').toString().trim().slice(0, 100) || null,
          avatarUrl: (raw.avatarUrl ?? '').toString().trim().slice(0, 500) || null,
          bio: (raw.bio ?? '').toString().trim().slice(0, 500) || null,
        };
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(data.email)) {
          setBox("profile-alert", "Email inválido.", "error");
          btn.disabled = false;
          btn.textContent = "Guardar cambios";
          return;
        }
        if (data.avatarUrl && !/^https?:\/\/.+/i.test(data.avatarUrl)) {
          setBox("profile-alert", "La URL del avatar debe empezar con http(s).", "error");
          btn.disabled = false;
          btn.textContent = "Guardar cambios";
          return;
        }
        btn.disabled = true;
        btn.textContent = "Guardando...";

        try {
          const res = await fetch("/api/perfil", {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
          });
          const result = await res.json();
          if (!res.ok) throw new Error(result.message || "No se pudo guardar.");
          setBox("profile-success", "Perfil actualizado correctamente.", "success");
        } catch (err) {
          console.error('[perfil]', err);
          setBox("profile-alert", err.message || 'No se pudo guardar.', "error");
        } finally {
          btn.disabled = false;
          btn.textContent = "Guardar cambios";
        }
      });
    }

    const passwordForm = document.getElementById("password-form");
    if (passwordForm) {
      passwordForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        hide("password-alert");
        hide("password-success");

        const data = Object.fromEntries(new FormData(passwordForm).entries());
        const btn = passwordForm.querySelector("button[type='submit']");
        const newPass = (data.newPassword ?? data.password ?? '').toString();
        if (newPass.length < 8 || !/[a-zA-Z]/.test(newPass) || !/[0-9]/.test(newPass)) {
          setBox("password-alert", "La nueva contraseña debe tener mínimo 8 caracteres, letra y número.", "error");
          return;
        }
        btn.disabled = true;
        btn.textContent = "Actualizando...";

        try {
          const res = await fetch("/api/perfil/password", {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
          });
          const result = await res.json();
          if (!res.ok) throw new Error(result.message || "No se pudo cambiar la contraseña.");
          setBox("password-success", result.message || "Contraseña actualizada.", "success");
          passwordForm.reset();
        } catch (err) {
          setBox("password-alert", err.message, "error");
        } finally {
          btn.disabled = false;
          btn.textContent = "Actualizar contraseña";
        }
      });
    }
  });
</script>
