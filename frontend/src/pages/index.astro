---
import Layout from "../layouts/Layout.astro";
import { apiGet } from "../lib/api/client.js";
import { Icon } from 'astro-icon/components';

let totalObservations = 0;
let totalSpecies = 0;
let totalCommunities = 0;

try {
  const stats = await apiGet("/stats");
  totalObservations = stats.observations;
  totalSpecies = stats.species;
  totalCommunities = stats.communities;
} catch (error) {
  console.error("Error al obtener estadísticas de FastAPI:", error);
}

const pageTitle = "Inicio - EcoRaíces";
---

<Layout title={pageTitle}>
  <div class="home-container">
    <!-- Hero Section -->
    <header class="hero-card">
      <div class="hero-content">
        <div class="logo-wrapper">
          <img src="/eco.png" alt="EcoRaíces Logo" class="floating-logo" />
          <div class="glowing-halo"></div>
        </div>
        
        <h1 class="hero-title">¡Bienvenidos a <span class="accent-text">EcoRaíces</span>!</h1>
        <div class="divider-line"></div>
        
        <p class="hero-description">
          Plataforma de ciencia ciudadana para documentar, geolocalizar y proteger la biodiversidad. 
          Registra especies en tiempo real, contribuye al mapa comunitario y ayuda a construir 
          el inventario de tu región desde cero.
        </p>

        <div class="hero-badge-container">
          <span class="hero-badge">
            <Icon name="lucide:map-pin" class="badge-icon" />
            Geolocalización
          </span>
          <span class="hero-badge">
            <Icon name="lucide:book" class="badge-icon" />
            Catalogación
          </span>
          <span class="hero-badge">
            <Icon name="lucide:users" class="badge-icon" />
            Comunidad
          </span>
        </div>
      </div>
    </header>

    <!-- Stats Dashboard Section -->
    <section class="stats-section">
      <div class="stat-card">
        <div class="stat-icon-wrapper obs">
          <Icon name="lucide:tree-deciduous" class="stat-icon" />
        </div>
        <div class="stat-info">
          <span class="stat-number">{totalObservations}</span>
          <span class="stat-label">Árboles Mapeados</span>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon-wrapper spc">
          <Icon name="lucide:leaf" class="stat-icon" />
        </div>
        <div class="stat-info">
          <span class="stat-number">{totalSpecies}</span>
          <span class="stat-label">Especies Catalogadas</span>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon-wrapper com">
          <Icon name="lucide:users" class="stat-icon" />
        </div>
        <div class="stat-info">
          <span class="stat-number">{totalCommunities}</span>
          <span class="stat-label">Comunidades Colaborando</span>
        </div>
      </div>
    </section>

    <!-- Aforo de Noticias & Foro Global de Biodiversidad -->
    <section class="community-hub-section" id="aforo-noticias-foro">
      <div class="section-header">
        <span class="section-pill">
          <Icon name="lucide:messages-square" class="pill-icon" />
          Punto de Encuentro EcoRaíces
        </span>
        <h2 class="section-title">Aforo de Noticias & Foro Global</h2>
        <p class="section-subtitle">
          Boletines científicos, alertas de conservación biológica y diálogo abierto con la red de ciencia ciudadana.
        </p>
      </div>

      <div class="hub-container">
        <!-- Switcher de Pestañas: Noticias vs Foro -->
        <div class="hub-nav-tabs" role="tablist">
          <button type="button" class="hub-tab-btn active" data-target="noticias" role="tab" aria-selected="true">
            <Icon name="lucide:newspaper" class="tab-btn-icon" />
            <span>Aforo de Noticias</span>
            <span class="tab-badge">4 Nuevas</span>
          </button>
          <button type="button" class="hub-tab-btn" data-target="foro" role="tab" aria-selected="false">
            <Icon name="lucide:message-square" class="tab-btn-icon" />
            <span>Foro Global Ciudadano</span>
            <span class="tab-badge">Comunidad</span>
          </button>
        </div>

        <!-- Panel 1: Aforo de Noticias Ambientales -->
        <div class="hub-tab-panel active" id="panel-noticias" role="tabpanel">
          <!-- Filtro rápido de noticias -->
          <div class="hub-filter-bar">
            <div class="filter-pills-list">
              <button type="button" class="filter-pill active" data-filter="all">Todos los Boletines</button>
              <button type="button" class="filter-pill" data-filter="alerta">Alertas Botánicas</button>
              <button type="button" class="filter-pill" data-filter="reforestacion">Reforestación</button>
              <button type="button" class="filter-pill" data-filter="ciencia">Ciencia Ciudadana</button>
            </div>
            <span class="news-live-tag">
              <span class="pulse-dot"></span>
              Boletín en vivo
            </span>
          </div>

          <!-- Grilla de Noticias -->
          <div class="news-grid">
            <!-- Noticia Destacada -->
            <article class="news-card featured-news" data-category="alerta">
              <div class="news-card-badge danger-badge">
                <Icon name="lucide:alert-triangle" class="badge-mini-icon" />
                Alerta Prioritaria
              </div>
              <div class="news-body">
                <div class="news-meta">
                  <span class="meta-item"><Icon name="lucide:calendar" class="meta-icon" /> Hoy · Boletín #48</span>
                  <span class="meta-item"><Icon name="lucide:clock" class="meta-icon" /> Lectura: 3 min</span>
                </div>
                <h3 class="news-title">Protección Prioritaria del Caracolí (<em>Anacardium excelsum</em>) en Cuencas Urbanas</h3>
                <p class="news-excerpt">
                  Se identificaron 14 ejemplares centenarios en zonas periurbanas bajo presión de deforestación. 
                  La red comunitaria despliega georreferenciación de emergencia para blindar legalmente el dosel forestal.
                </p>
                <div class="news-footer">
                  <div class="news-tags">
                    <span class="tag-chip">Bosque Andino</span>
                    <span class="tag-chip">UICN Vulnerable</span>
                  </div>
                  <button type="button" class="btn-read-news" data-news-id="caracoli">
                    <span>Leer Boletín</span>
                    <Icon name="lucide:arrow-right" class="arrow-icon" />
                  </button>
                </div>
              </div>
            </article>

            <!-- Noticia 2 -->
            <article class="news-card" data-category="reforestacion">
              <div class="news-card-badge success-badge">
                <Icon name="lucide:tree-deciduous" class="badge-mini-icon" />
                Jornada Comunitaria
              </div>
              <div class="news-body">
                <div class="news-meta">
                  <span class="meta-item"><Icon name="lucide:calendar" class="meta-icon" /> Hace 2 días</span>
                  <span class="meta-item"><Icon name="lucide:clock" class="meta-icon" /> 2 min</span>
                </div>
                <h3 class="news-title">Campaña de Siembra: 250 Guayacanes Rosados Censados y Geolocalizados</h3>
                <p class="news-excerpt">
                  Voluntarios de Cundinamarca y Santander culminaron la primera fase de inventario digital de plántulas 
                  con coordenadas submétricas y fichas botánicas abiertas.
                </p>
                <div class="news-footer">
                  <div class="news-tags">
                    <span class="tag-chip">Guayacán</span>
                    <span class="tag-chip">Siembra Colectiva</span>
                  </div>
                  <button type="button" class="btn-read-news" data-news-id="guayacan">
                    <span>Leer Boletín</span>
                    <Icon name="lucide:arrow-right" class="arrow-icon" />
                  </button>
                </div>
              </div>
            </article>

            <!-- Noticia 3 -->
            <article class="news-card" data-category="ciencia">
              <div class="news-card-badge info-badge">
                <Icon name="lucide:book-open" class="badge-mini-icon" />
                Herbario Colaborativo
              </div>
              <div class="news-body">
                <div class="news-meta">
                  <span class="meta-item"><Icon name="lucide:calendar" class="meta-icon" /> Hace 4 días</span>
                  <span class="meta-item"><Icon name="lucide:clock" class="meta-icon" /> 4 min</span>
                </div>
                <h3 class="news-title">Monitoreo del Dividivi y Cardón Guajiro ante la Sequía en Bosque Seco</h3>
                <p class="news-excerpt">
                  Comunidades wayuu y botánicos documentan la capacidad de resiliencia hídrica de especies xerofíticas, 
                  estableciendo nuevas zonas piloto de recolección de semillas nativas.
                </p>
                <div class="news-footer">
                  <div class="news-tags">
                    <span class="tag-chip">La Guajira</span>
                    <span class="tag-chip">Bosque Seco</span>
                  </div>
                  <button type="button" class="btn-read-news" data-news-id="dividivi">
                    <span>Leer Boletín</span>
                    <Icon name="lucide:arrow-right" class="arrow-icon" />
                  </button>
                </div>
              </div>
            </article>

            <!-- Noticia 4 -->
            <article class="news-card" data-category="alerta">
              <div class="news-card-badge warning-badge">
                <Icon name="lucide:flame" class="badge-mini-icon" />
                Hallazgo Botánico
              </div>
              <div class="news-body">
                <div class="news-meta">
                  <span class="meta-item"><Icon name="lucide:calendar" class="meta-icon" /> Hace 1 semana</span>
                  <span class="meta-item"><Icon name="lucide:clock" class="meta-icon" /> 3 min</span>
                </div>
                <h3 class="news-title">Nuevo Registro de Población Silvestre de Cedro Negro (<em>Juglans neotropica</em>)</h3>
                <p class="news-excerpt">
                  Observadores ciudadanos validaron fotográficamente 8 árboles adultos en la cordillera oriental, 
                  notificando al sistema nacional para su custodia comunitaria.
                </p>
                <div class="news-footer">
                  <div class="news-tags">
                    <span class="tag-chip">Cedro Negro</span>
                    <span class="tag-chip">Endémico</span>
                  </div>
                  <button type="button" class="btn-read-news" data-news-id="cedro">
                    <span>Leer Boletín</span>
                    <Icon name="lucide:arrow-right" class="arrow-icon" />
                  </button>
                </div>
              </div>
            </article>
          </div>
        </div>

        <!-- Panel 2: Foro Global Ciudadano -->
        <div class="hub-tab-panel" id="panel-foro" role="tabpanel" style="display: none;">
          <!-- Barra superior del Foro -->
          <div class="forum-header-bar">
            <div class="forum-intro">
              <h3 class="forum-intro-title">Debates y Consultas de la Comunidad</h3>
              <p class="forum-intro-desc">Comparte dudas botánicas, organiza jornadas y dialoga con observadores de todo el país.</p>
            </div>
            <a href="/comunidades" class="btn-new-topic">
              <Icon name="lucide:plus" class="btn-icon" />
              <span>Participar en Comunidades</span>
            </a>
          </div>

          <!-- Lista de Debates Abiertos -->
          <div class="forum-threads-list">
            <!-- Debate 1 -->
            <div class="forum-thread-card">
              <div class="thread-vote-box">
                <Icon name="lucide:flame" class="thread-fire-icon" />
                <span class="vote-count">24</span>
                <span class="vote-label">aportes</span>
              </div>
              <div class="thread-content">
                <div class="thread-header-meta">
                  <span class="thread-badge active-badge">En Discusión Activa</span>
                  <span class="thread-time"><Icon name="lucide:clock" class="meta-icon-mini" /> Hace 1 hora</span>
                  <span class="thread-author">Por <strong>Carlos Mendoza</strong> · Comunidad Guajira Verde</span>
                </div>
                <h4 class="thread-title">
                  <a href="/comunidades">¿Cómo diferenciar plántulas de Ceiba Bonga (<em>Ceiba pentandra</em>) y Caracolí en etapa juvenil?</a>
                </h4>
                <p class="thread-preview">
                  En la última expedición observamos plántulas con follaje similar cerca al lecho del río. Hemos subido fotografías de los pecíolos y nervaduras foliares para confirmación de los botánicos...
                </p>
                <div class="thread-tags">
                  <span class="thread-tag">#Identificación</span>
                  <span class="thread-tag">#Dendrología</span>
                  <span class="thread-tag">#BosqueHúmedo</span>
                </div>
              </div>
              <div class="thread-actions">
                <a href="/comunidades" class="btn-thread-reply">
                  <Icon name="lucide:message-circle" class="w-4 h-4" />
                  <span>14 respuestas</span>
                </a>
              </div>
            </div>

            <!-- Debate 2 -->
            <div class="forum-thread-card">
              <div class="thread-vote-box">
                <Icon name="lucide:tree-deciduous" class="thread-tree-icon" />
                <span class="vote-count">19</span>
                <span class="vote-label">aportes</span>
              </div>
              <div class="thread-content">
                <div class="thread-header-meta">
                  <span class="thread-badge proposal-badge">Propuesta Agroforestal</span>
                  <span class="thread-time"><Icon name="lucide:clock" class="meta-icon-mini" /> Hace 3 horas</span>
                  <span class="thread-author">Por <strong>Asociación Reforesta Andina</strong></span>
                </div>
                <h4 class="thread-title">
                  <a href="/comunidades">Metodología de germinación y sustrato para semillas de Dividivi (<em>Libidibia coriaria</em>)</a>
                </h4>
                <p class="thread-preview">
                  Estamos ensayando escarificación mecánica y remojo de 24 horas antes de siembra en vivero comunitario. Compartimos tabla de resultados porcentuales de brote...
                </p>
                <div class="thread-tags">
                  <span class="thread-tag">#ViveroComunitario</span>
                  <span class="thread-tag">#Germinación</span>
                  <span class="thread-tag">#SuelosÁridos</span>
                </div>
              </div>
              <div class="thread-actions">
                <a href="/comunidades" class="btn-thread-reply">
                  <Icon name="lucide:message-circle" class="w-4 h-4" />
                  <span>28 respuestas</span>
                </a>
              </div>
            </div>

            <!-- Debate 3 -->
            <div class="forum-thread-card">
              <div class="thread-vote-box">
                <Icon name="lucide:check-circle-2" class="thread-resolved-icon" />
                <span class="vote-count">31</span>
                <span class="vote-label">aportes</span>
              </div>
              <div class="thread-content">
                <div class="thread-header-meta">
                  <span class="thread-badge resolved-badge">Solucionado</span>
                  <span class="thread-time"><Icon name="lucide:clock" class="meta-icon-mini" /> Hace 6 horas</span>
                  <span class="thread-author">Por <strong>Dra. Elena Ramos</strong> · Bióloga Verificadora</span>
                </div>
                <h4 class="thread-title">
                  <a href="/comunidades">Guía de árboles nativos recomendados para corredores de polinizadores urbanos</a>
                </h4>
                <p class="thread-preview">
                  Sintetizamos la lista de 15 especies arbóreas con floración escalonada que mejor atraen abejas nativas solitarias y colibríes en zonas urbanas de Colombia...
                </p>
                <div class="thread-tags">
                  <span class="thread-tag">#Polinizadores</span>
                  <span class="thread-tag">#BiodiversidadUrbana</span>
                  <span class="thread-tag">#GuíaBotánica</span>
                </div>
              </div>
              <div class="thread-actions">
                <a href="/comunidades" class="btn-thread-reply">
                  <Icon name="lucide:message-circle" class="w-4 h-4" />
                  <span>34 respuestas</span>
                </a>
              </div>
            </div>
          </div>

          <!-- Footer Banner del Foro -->
          <div class="forum-cta-banner">
            <div class="cta-banner-info">
              <Icon name="lucide:users" class="banner-icon" />
              <div>
                <strong>¿Quieres unirte o fundar un colectivo ambiental en tu territorio?</strong>
                <p>Nuestra sección de comunidades te permite crear asambleas virtuales, sincronizar datos y agendar salidas de campo.</p>
              </div>
            </div>
            <a href="/comunidades" class="btn-explore-communities">
              <span>Ver Comunidades</span>
              <Icon name="lucide:arrow-right" class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>

      <!-- Modal de Lectura de Noticias -->
      <div id="news-modal" class="news-modal-overlay" style="display: none;" role="dialog" aria-modal="true">
        <div class="news-modal-content">
          <div class="modal-header">
            <span class="modal-badge" id="modal-category-badge">Boletín Oficial</span>
            <button type="button" class="btn-close-modal" id="btn-close-news-modal" aria-label="Cerrar">
              <Icon name="lucide:x" class="w-5 h-5" />
            </button>
          </div>
          <div class="modal-body">
            <h3 class="modal-news-title" id="modal-news-title">Título del Boletín</h3>
            <div class="modal-meta" id="modal-news-meta">Publicado por el equipo científico de EcoRaíces</div>
            <div class="modal-news-text" id="modal-news-text">
              Contenido del boletín...
            </div>
          </div>
          <div class="modal-footer">
            <a href="/observaciones" class="btn-modal-action">
              <Icon name="lucide:map" class="w-4 h-4" />
              <span>Ver Ubicaciones en el Mapa</span>
            </a>
            <button type="button" class="btn-modal-secondary" id="btn-modal-dismiss">Cerrar</button>
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Actions Cards -->
    <section class="actions-grid">
      <a href="/observaciones/nueva" class="action-card primary-action">
        <div class="action-badge">GPS Móvil</div>
        <h2 class="action-title">Registrar Nuevo Árbol</h2>
        <p class="action-desc">
          Usa tu teléfono como un GPS de campo. Captura la ubicación en tiempo real, sube fotos 
          de hojas o corteza y ayuda a inventariar el ecosistema local.
        </p>
        <div class="action-footer">
          <span>Iniciar Registro de Campo</span>
          <Icon name="lucide:arrow-right" class="arrow-icon" />
        </div>
      </a>

      <a href="/observaciones" class="action-card secondary-action">
        <div class="action-badge border-badge">Mapa Interactivo</div>
        <h2 class="action-title">Mapa de Especies Nativas</h2>
        <p class="action-desc">
          Visualiza los árboles registrados por la comunidad. Filtra por categoría y explora el 
          territorio con nuestro visor de mapas en 3D de alto rendimiento.
        </p>
        <div class="action-footer">
          <span>Explorar el Mapa</span>
          <Icon name="lucide:arrow-right" class="arrow-icon" />
        </div>
      </a>

      <a href="/plantas" class="action-card catalog-action">
        <div class="action-badge border-badge">Herbario</div>
        <h2 class="action-title">Catálogo Científico</h2>
        <p class="action-desc">
          Consulta la base de datos de especies. Aprende sobre hábitats, 
          estado de conservación y características botánicas de los árboles registrados.
        </p>
        <div class="action-footer">
          <span>Ver Catálogo</span>
          <Icon name="lucide:arrow-right" class="arrow-icon" />
        </div>
      </a>
    </section>
  </div>
</Layout>

<script>
  interface NewsDetail {
    title: string;
    category: string;
    meta: string;
    text: string;
  }

  const newsData: Record<string, NewsDetail> = {
    caracoli: {
      title: "Protección Prioritaria del Caracolí (Anacardium excelsum) en Cuencas Urbanas",
      category: "Alerta Prioritaria · Bosque Andino",
      meta: "Publicado hoy por el Comité Científico de EcoRaíces · Boletín #48",
      text: `<p>El Caracolí (<em>Anacardium excelsum</em>) es una especie arbórea vital para la regulación hídrica de microcuencas y la estabilidad de taludes ribereños. En inspecciones recientes en las zonas periurbanas, observadores comunitarios documentaron 14 árboles centenarios con alturas superiores a los 35 metros que enfrentaban riesgo inminente por canalizaciones de aguas lluvias y obras civiles no autorizadas.</p>
      <p style="margin-top: 1rem;">Gracias a la georreferenciación colaborativa de la plataforma EcoRaíces, se radicó una solicitud formal de medida cautelar ambiental ante la autoridad territorial. Hacemos un llamado a todos los exploradores de la zona andina a continuar mapeando brotes y censando la fauna asociada a sus copas.</p>`
    },
    guayacan: {
      title: "Campaña de Siembra: 250 Guayacanes Rosados Censados y Geolocalizados",
      category: "Reforestación Comunitaria",
      meta: "Publicado hace 2 días · Alianza Viveros Ciudadanos",
      text: `<p>Durante el último mes, más de 40 brigadistas voluntarios y familias campesinas completaron la siembra y georreferenciación de 250 plántulas de Guayacán Rosado (<em>Handroanthus chrysanthus</em>).</p>
      <p style="margin-top: 1rem;">Cada ejemplar cuenta con un registro en la base de datos comunitaria, incluyendo diámetro a la altura de la base (DAB), tipo de suelo y registro fotográfico inicial. Esto permitirá realizar un seguimiento fenológico durante los próximos 5 años para evaluar tasas de supervivencia bajo diferentes condiciones climáticas.</p>`
    },
    dividivi: {
      title: "Monitoreo del Dividivi y Cardón Guajiro ante la Sequía en Bosque Seco",
      category: "Ciencia Ciudadana · Resiliencia Ecosistémica",
      meta: "Publicado hace 4 días · Nodo Guajira EcoRaíces",
      text: `<p>El Bosque Seco Tropical es uno de los ecosistemas más amenazados de Colombia. En La Guajira, la comunidad en colaboración con biólogos de campo ha puesto en marcha un monitoreo intensivo sobre la floración y fructificación del Dividivi (<em>Libidibia coriaria</em>) y cactáceas columnares.</p>
      <p style="margin-top: 1rem;">Los datos recopilados demuestran que las poblaciones con mayor cobertura de hojarasca retienen hasta un 30% más de humedad en el horizonte superficial del suelo, lo cual sustenta las recomendaciones de manejo de pastoreo comunitario en épocas de sequía severa.</p>`
    },
    cedro: {
      title: "Nuevo Registro de Población Silvestre de Cedro Negro (Juglans neotropica)",
      category: "Hallazgo Botánico · Especie en Riesgo",
      meta: "Publicado hace 1 semana · Red de Observadores de Montaña",
      text: `<p>En una zona de reserva campesina previamente no inventariada, dos observadores ciudadanos registraron 8 ejemplares adultos de Cedro Negro (<em>Juglans neotropica</em>), especie catalogada bajo grado de amenaza debido a la sobreexplotación maderera histórica.</p>
      <p style="margin-top: 1rem;">El registro ya fue validado botánicamente a través de nuestras claves dicotómicas digitales y se ha integrado al herbario científico. La comunidad ha constituido una custodia territorial voluntaria para proteger el semillero natural.</p>`
    }
  };

  function initCommunityHub() {
    // 1. Switcher de Tabs: Noticias vs Foro
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.hub-tab-btn');
    const panels = document.querySelectorAll<HTMLDivElement>('.hub-tab-panel');

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.target;
        tabBtns.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        panels.forEach((p) => {
          p.classList.remove('active');
          p.style.display = 'none';
        });

        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        const activePanel = document.getElementById(`panel-${target}`);
        if (activePanel) {
          activePanel.classList.add('active');
          activePanel.style.display = 'block';
        }
      });
    });

    // 2. Filtros de Noticias
    const filterPills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    const newsCards = document.querySelectorAll<HTMLElement>('.news-card');

    filterPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        filterPills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');

        const filter = pill.dataset.filter;
        newsCards.forEach((card) => {
          if (filter === 'all' || card.dataset.category === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // 3. Modal de Noticias
    const modal = document.getElementById('news-modal');
    const modalTitle = document.getElementById('modal-news-title');
    const modalBadge = document.getElementById('modal-category-badge');
    const modalMeta = document.getElementById('modal-news-meta');
    const modalText = document.getElementById('modal-news-text');
    const btnClose = document.getElementById('btn-close-news-modal');
    const btnDismiss = document.getElementById('btn-modal-dismiss');
    const readBtns = document.querySelectorAll<HTMLButtonElement>('.btn-read-news');

    const closeModal = () => {
      if (modal) modal.style.display = 'none';
      document.body.classList.remove('no-scroll');
    };

    readBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const newsId = btn.dataset.newsId;
        if (!newsId || !newsData[newsId] || !modal) return;

        const data = newsData[newsId];
        if (modalTitle) modalTitle.textContent = data.title;
        if (modalBadge) modalBadge.textContent = data.category;
        if (modalMeta) modalMeta.textContent = data.meta;
        if (modalText) modalText.innerHTML = data.text;

        modal.style.display = 'flex';
        document.body.classList.add('no-scroll');
      });
    });

    if (btnClose) btnClose.addEventListener('click', closeModal);
    if (btnDismiss) btnDismiss.addEventListener('click', closeModal);

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && modal.style.display !== 'none') {
        closeModal();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initCommunityHub);
  document.addEventListener('astro:page-load', initCommunityHub);
</script>

