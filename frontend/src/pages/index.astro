---
import Layout from "../layouts/Layout.astro";
import { apiGet } from "../lib/api/client.js";
import { Icon } from 'astro-icon/components';

let totalObservations = 0;
let totalSpecies = 0;
let totalCommunities = 0;

try {
  const stats = await apiGet("/stats");
  totalObservations = stats.observations;
  totalSpecies = stats.species;
  totalCommunities = stats.communities;
} catch (error) {
  console.error("Error al obtener estadísticas de FastAPI:", error);
}

const pageTitle = "Inicio - EcoRaíces";
---

<Layout title={pageTitle}>
  <div class="home-container">
    <!-- Hero Section -->
    <header class="hero-card">
      <div class="hero-content">
        <div class="logo-wrapper">
          <img src="/eco.png" alt="EcoRaíces Logo" class="floating-logo" />
          <div class="glowing-halo"></div>
        </div>
        
        <h1 class="hero-title">¡Bienvenidos a <span class="accent-text">EcoRaíces</span>!</h1>
        <div class="divider-line"></div>
        
        <p class="hero-description">
          Plataforma de ciencia ciudadana para documentar, geolocalizar y proteger la biodiversidad. 
          Registra especies en tiempo real, contribuye al mapa comunitario y ayuda a construir 
          el inventario de tu región desde cero.
        </p>

        <div class="hero-badge-container">
          <span class="hero-badge">
            <Icon name="lucide:map-pin" class="badge-icon" />
            Geolocalización
          </span>
          <span class="hero-badge">
            <Icon name="lucide:book" class="badge-icon" />
            Catalogación
          </span>
          <span class="hero-badge">
            <Icon name="lucide:users" class="badge-icon" />
            Comunidad
          </span>
        </div>
      </div>
    </header>

    <!-- Stats Dashboard Section -->
    <section class="stats-section">
      <div class="stat-card">
        <div class="stat-icon-wrapper obs">
          <Icon name="lucide:tree-deciduous" class="stat-icon" />
        </div>
        <div class="stat-info">
          <span class="stat-number">{totalObservations}</span>
          <span class="stat-label">Árboles Mapeados</span>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon-wrapper spc">
          <Icon name="lucide:leaf" class="stat-icon" />
        </div>
        <div class="stat-info">
          <span class="stat-number">{totalSpecies}</span>
          <span class="stat-label">Especies Catalogadas</span>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon-wrapper com">
          <Icon name="lucide:users" class="stat-icon" />
        </div>
        <div class="stat-info">
          <span class="stat-number">{totalCommunities}</span>
          <span class="stat-label">Comunidades Colaborando</span>
        </div>
      </div>
    </section>

    <!-- Quick Actions Cards -->
    <section class="actions-grid">
      <a href="/observaciones/nueva" class="action-card primary-action">
        <div class="action-badge">GPS Móvil</div>
        <h2 class="action-title">Registrar Nuevo Árbol</h2>
        <p class="action-desc">
          Usa tu teléfono como un GPS de campo. Captura la ubicación en tiempo real, sube fotos 
          de hojas o corteza y ayuda a inventariar el ecosistema local.
        </p>
        <div class="action-footer">
          <span>Iniciar Registro de Campo</span>
          <Icon name="lucide:arrow-right" class="arrow-icon" />
        </div>
      </a>

      <a href="/observaciones" class="action-card secondary-action">
        <div class="action-badge border-badge">Mapa Interactivo</div>
        <h2 class="action-title">Mapa de Especies Nativas</h2>
        <p class="action-desc">
          Visualiza los árboles registrados por la comunidad. Filtra por categoría y explora el 
          territorio con nuestro visor de mapas en 3D de alto rendimiento.
        </p>
        <div class="action-footer">
          <span>Explorar el Mapa</span>
          <Icon name="lucide:arrow-right" class="arrow-icon" />
        </div>
      </a>

      <a href="/plantas" class="action-card catalog-action">
        <div class="action-badge border-badge">Herbario</div>
        <h2 class="action-title">Catálogo Científico</h2>
        <p class="action-desc">
          Consulta la base de datos de especies. Aprende sobre hábitats, 
          estado de conservación y características botánicas de los árboles registrados.
        </p>
        <div class="action-footer">
          <span>Ver Catálogo</span>
          <Icon name="lucide:arrow-right" class="arrow-icon" />
        </div>
      </a>
    </section>
  </div>
</Layout>

<style>
  .home-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.5rem 1rem;
    animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(15px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Hero Card */
  .hero-card {
    background: white;
    border-radius: 1rem;
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.04);
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid #eef2f0;
    margin-bottom: 2rem;
    position: relative;
    overflow: hidden;
  }

  .hero-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--color-success) 0%, var(--color-success-dark) 100%);
  }

  .hero-content {
    max-width: 750px;
    margin: 0 auto;
  }

  .logo-wrapper {
    position: relative;
    width: 140px;
    height: 140px;
    margin: 0 auto 1.5rem;
  }

  .floating-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 50%;
    position: relative;
    z-index: 2;
    animation: float 4s ease-in-out infinite;
  }

  .glowing-halo {
    position: absolute;
    top: -5px;
    left: -5px;
    right: -5px;
    bottom: -5px;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.08);
    filter: blur(8px);
    z-index: 1;
    animation: pulse 3s infinite ease-in-out;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 0.5; }
    50% { transform: scale(1.08); opacity: 0.9; }
  }

  .hero-title {
    font-family: 'Outfit', sans-serif;
    font-size: 2.75rem;
    font-weight: 800;
    color: var(--color-primary-dark);
    margin-bottom: 1rem;
    letter-spacing: -0.025em;
  }

  .accent-text {
    color: var(--color-success);
  }

  .divider-line {
    width: 60px;
    height: 3px;
    background-color: var(--color-success);
    margin: 1.25rem auto;
    border-radius: 99px;
  }

  .hero-description {
    font-size: 1.125rem;
    line-height: 1.7;
    color: #4b5563;
    margin-bottom: 2rem;
  }

  .hero-badge-container {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #f0fdf4;
    color: #166534;
    border: 1px solid #dcfce7;
    padding: 0.5rem 1rem;
    border-radius: 99px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .badge-icon {
    width: 16px;
    height: 16px;
  }

  /* Stats Section */
  .stats-section {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .stat-card {
    background: white;
    border-radius: 0.75rem;
    border: 1px solid #eef2f0;
    padding: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    box-shadow: 0 2px 12px -2px rgba(0, 0, 0, 0.02);
  }

  .stat-icon-wrapper {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stat-icon-wrapper.obs { background-color: var(--color-success-bg); color: var(--color-success-dark); }
  .stat-icon-wrapper.spc { background-color: #f0fdf4; color: #15803d; }
  .stat-icon-wrapper.com { background-color: #f0fdfa; color: #0d9488; }

  .stat-icon {
    width: 24px;
    height: 24px;
  }

  .stat-info {
    display: flex;
    flex-direction: column;
  }

  .stat-number {
    font-size: 1.75rem;
    font-weight: 800;
    color: #1f2937;
    line-height: 1.2;
    font-family: 'Outfit', sans-serif;
  }

  .stat-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: #6b7280;
  }

  /* Actions Grid */
  .actions-grid {
    display: grid;
    grid-template-columns: 2fr 1.5fr 1.5fr;
    gap: 1.5rem;
  }

  .action-card {
    background: white;
    border-radius: 1rem;
    border: 1px solid #eef2f0;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 15px -3px rgba(0, 0, 0, 0.03);
    position: relative;
  }

  .action-badge {
    align-self: flex-start;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.625rem;
    border-radius: 0.25rem;
    margin-bottom: 1rem;
  }

  .primary-action {
    background: linear-gradient(135deg, #065f46 0%, #047857 100%);
    color: white;
    border: none;
  }

  .primary-action .action-badge {
    background-color: rgba(255, 255, 255, 0.15);
    color: #a7f3d0;
  }

  .primary-action .action-title {
    color: white;
  }

  .primary-action .action-desc {
    color: #d1fae5;
  }

  .primary-action .action-footer {
    color: #a7f3d0;
  }

  .action-card:not(.primary-action) .action-badge {
    background-color: #f3f4f6;
    color: #4b5563;
  }

  .action-card:not(.primary-action) .action-badge.border-badge {
    border: 1px solid #e5e7eb;
    background-color: transparent;
  }

  .action-title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 0.75rem;
    line-height: 1.25;
  }

  .action-desc {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: #4b5563;
    margin-bottom: 2rem;
    flex-grow: 1;
  }

  .action-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-success-dark);
    border-top: 1px solid #f3f4f6;
    padding-top: 1rem;
    transition: color 0.2s;
  }

  .primary-action .action-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .arrow-icon {
    width: 18px;
    height: 18px;
    transition: transform 0.2s;
  }

  /* Hover states */
  .action-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08);
  }

  .primary-action:hover {
    box-shadow: 0 10px 25px -5px rgba(6, 95, 70, 0.25);
  }

  .action-card:hover .arrow-icon {
    transform: translateX(4px);
  }

  /* Responsive styling */
  @media (max-width: 1024px) {
    .actions-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.25rem;
    }
    
    .stats-section {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    
    .actions-grid {
      grid-template-columns: 1fr;
    }
    
    .hero-card {
      padding: 2rem 1rem;
    }
  }
</style>
