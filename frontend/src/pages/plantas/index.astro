---
import Layout from "../../layouts/Layout.astro";

// Tipos para los parámetros de URL
interface FilterParams {
  categoria?: string;
  habitat?: string;
  estado?: string;
  ordenar?: string;
}

// Tipo para las especies
interface Especie {
  id: string;
  name: string;
  scientificName: string;
  description: string | null;
  habitat: string | null;
  imageUrl: string | null;
  status: string | null;
  categoryId: string;
  createdAt: string;
  updatedAt: string;
  category: {
    id: string;
    name: string;
    description: string | null;
    imageUrl: string | null;
    createdAt: string;
    updatedAt: string;
  };
}

// Obtener parámetros de la URL para filtrado
const { searchParams } = Astro.url;
const params: FilterParams = {
  categoria: searchParams.get("categoria") || undefined,
  habitat: searchParams.get("habitat") || undefined,
  estado: searchParams.get("estado") || undefined,
  ordenar: searchParams.get("ordenar") || "nombre-asc"
};

const { categoria, habitat, estado: estadoConservacion, ordenar } = params;

// URL base del backend interno (Docker)
const API_URL = "http://backend:8000/api";

// Obtener todas las categorías para el filtro
const categoriasRes = await fetch(`${API_URL}/categories`);
const categorias = categoriasRes.ok ? await categoriasRes.json() : [];

// Obtener hábitats únicos para el filtro
const habitatsRes = await fetch(`${API_URL}/species/habitats`);
const habitats = habitatsRes.ok ? await habitatsRes.json() : [];

// Construir la query string para especies
const queryParams = new URLSearchParams();
if (categoria) queryParams.append("categoria", categoria);
if (habitat) queryParams.append("habitat", habitat);
if (estadoConservacion) queryParams.append("estado", estadoConservacion);
if (ordenar) queryParams.append("ordenar", ordenar);

// Obtener especies según los filtros
const especiesRes = await fetch(`${API_URL}/species?${queryParams.toString()}`);
const especies: Especie[] = especiesRes.ok ? await especiesRes.json() : [];

// Función para obtener la etiqueta del estado de conservación
const getStatusLabel = (status: string): string => {
  const statusLabels: Record<string, string> = {
    'EXTINCT': '🌍 Extinto (EX)',
    'EXTINCT_IN_WILD': '🌳 Extinto en estado silvestre (EW)',
    'CRITICALLY_ENDANGERED': '🚨 En peligro crítico (CR)',
    'ENDANGERED': '⚠️ En peligro (EN)',
    'VULNERABLE': '⚠️ Vulnerable (VU)',
    'NEAR_THREATENED': '⚠️ Casi amenazado (NT)',
    'LEAST_CONCERN': '✅ Preocupación menor (LC)',
    'DATA_DEFICIENT': '❓ Datos insuficientes (DD)',
    'NOT_EVALUATED': '❔ No evaluado (NE)'
  };
  return statusLabels[status] || status;
};
---

<Layout title="Catálogo de Especies - EcoRaíces">
  <div class="species-page">
    <div class="page-header">
      <h1>Catálogo de Especies Nativas</h1>
      <p>Explora nuestra base de datos de especies nativas y contribuye a su conservación</p>
    </div>

    <div class="plants-container">
      <!-- Filtros Topbar -->
      <div class="filters-topbar">
        <form id="filter-form" method="get" class="filters-form">
          <!-- Filtro por categoría (Chips) -->
          <div class="filter-group categories-group">
            <div class="categories-chips">
              <label class={`chip-label ${!categoria ? 'active' : ''}`}>
                <input
                  type="radio"
                  name="categoria"
                  value=""
                  checked={!categoria}
                  class="sr-only"
                />
                Todas
              </label>
              {
                categorias.map((cat: { id: string; name: string }) => (
                  <label class={`chip-label ${categoria === cat.id ? 'active' : ''}`}>
                    <input
                      type="radio"
                      name="categoria"
                      value={cat.id}
                      checked={categoria === cat.id}
                      class="sr-only"
                    />
                    {cat.name}
                  </label>
                ))
              }
            </div>
          </div>

          <!-- Filtros secundarios horizontales -->
          <div class="secondary-filters">
            <div class="filter-group">
              <select name="habitat" id="habitat" class="form-control" aria-label="Hábitat">
                <option value="">Todos los hábitats</option>
                {habitats.map((h: { habitat: string | null }) => (
                  <option value={h.habitat} selected={habitat === h.habitat}>
                    {h.habitat}
                  </option>
                ))}
              </select>
            </div>

            <div class="filter-group">
              <select name="estado" id="estado" class="form-control" aria-label="Estado de conservación">
                <option value="">Todos los estados</option>
                <option value="EXTINCT" selected={estadoConservacion === 'EXTINCT'}>🌍 Extinto</option>
                <option value="EXTINCT_IN_WILD" selected={estadoConservacion === 'EXTINCT_IN_WILD'}>🌳 Extinto en estado silvestre</option>
                <option value="CRITICALLY_ENDANGERED" selected={estadoConservacion === 'CRITICALLY_ENDANGERED'}>🚨 En peligro crítico</option>
                <option value="ENDANGERED" selected={estadoConservacion === 'ENDANGERED'}>⚠️ En peligro</option>
                <option value="VULNERABLE" selected={estadoConservacion === 'VULNERABLE'}>⚠️ Vulnerable</option>
                <option value="NEAR_THREATENED" selected={estadoConservacion === 'NEAR_THREATENED'}>⚠️ Casi amenazado</option>
                <option value="LEAST_CONCERN" selected={estadoConservacion === 'LEAST_CONCERN'}>✅ Preocupación menor</option>
                <option value="DATA_DEFICIENT" selected={estadoConservacion === 'DATA_DEFICIENT'}>❓ Datos insuficientes</option>
                <option value="NOT_EVALUATED" selected={estadoConservacion === 'NOT_EVALUATED'}>➖ No evaluado</option>
              </select>
            </div>

            <div class="filter-group">
              <select name="ordenar" id="ordenar" aria-label="Ordenar por">
                <option value="nombre-asc" selected={ordenar === "nombre-asc"}>Nombre (A-Z)</option>
                <option value="nombre-desc" selected={ordenar === "nombre-desc"}>Nombre (Z-A)</option>
                <option value="fecha-reciente" selected={ordenar === "fecha-reciente"}>Más recientes</option>
                <option value="fecha-antigua" selected={ordenar === "fecha-antigua"}>Más antiguos</option>
              </select>
            </div>

            <div class="filter-actions">
              <button type="submit" class="btn btn-primary btn-sm">Filtrar</button>
              <button type="button" id="reset-filters" class="btn btn-secondary btn-sm">Reset</button>
            </div>
          </div>
        </form>
      </div>

      <!-- Listado de plantas -->
      <div class="plants-grid">
        {
          especies.length > 0 ? (
            especies.map((especie: Especie) => (
              <div class="plant-card">
                <div class="plant-image">
                  <img src={especie.imageUrl || 'https://images.unsplash.com/photo-1502082553048-f009c37129b9?auto=format&fit=crop&w=600&q=80'} 
                        onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1502082553048-f009c37129b9?auto=format&fit=crop&w=600&q=80';" 
                        alt={especie.name} />
                </div>
                <div class="plant-content">
                  <span class="plant-category">{especie.category.name}</span>
                  <h3 class="plant-title">{especie.name}</h3>
                  <p class="scientific-name"><i>{especie.scientificName}</i></p>
                  {especie.habitat && (
                    <div class="habitat">
                      <span class="label">Hábitat:</span> {especie.habitat}
                    </div>
                  )}
                  {especie.status && (
                    <div class={`status ${especie.status.toLowerCase()}`}>
                      {getStatusLabel(especie.status)}
                    </div>
                  )}
                  <div class="plant-actions">
                    <a href={`/plantas/${especie.id}`} class="btn btn-primary">
                      Ver detalles
                    </a>
                    <button
                      class="btn btn-secondary report-sighting"
                      data-id={especie.id}
                    >
                      Reportar avistamiento
                    </button>
                  </div>
                </div>
              </div>
            ))
          ) : (
            <div class="empty-state">
              <p>No se encontraron especies con los filtros seleccionados.</p>
              <button type="button" id="clear-filters" class="btn btn-primary">
                Limpiar filtros
              </button>
            </div>
          )
        }
      </div>
    </div>
  </div>
</Layout>

<script>
  // Reset filtros y reportar avistamientos
  document.addEventListener('astro:page-load', () => {
    // Botón de reset en el formulario de filtros
    const resetButton = document.getElementById("reset-filters");
    if (resetButton) {
      resetButton.addEventListener("click", (e) => {
        e.preventDefault();
        window.location.href = "/plantas";
      });
    }

    // Botón de limpiar filtros en estado vacío
    const clearButton = document.getElementById("clear-filters");
    if (clearButton) {
      clearButton.addEventListener("click", () => {
        window.location.href = "/plantas";
      });
    }

    // Agregar evento a los chips (radio buttons) para auto-submit y estilo
    document.querySelectorAll('.chip-label input[type="radio"]').forEach(radio => {
      radio.addEventListener('change', (e) => {
        // Enviar formulario al hacer click
        const form = document.getElementById('filter-form') as HTMLFormElement;
        if (form) form.submit();
      });
    });

    // Redirección para reportar avistamiento pre-seleccionando la especie
    document.querySelectorAll(".report-sighting").forEach((button) => {
      button.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLElement;
        const especieId = target.getAttribute("data-id");
        if (especieId) {
          window.location.href = `/observaciones/nueva?especieId=${especieId}`;
        }
      });
    });
  });
</script>

<style>
  .plants-page {
    margin-bottom: 3rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .page-header h1 {
    color: var(--color-primary);
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .plants-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Filtros Topbar */
  .filters-topbar {
    background-color: var(--color-card);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    position: sticky;
    top: 1rem;
    z-index: 10;
    border: 1px solid var(--color-border, #eef2f0);
  }

  .filters-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .categories-group {
    border-bottom: 1px solid var(--color-border, #eef2f0);
    padding-bottom: 1rem;
  }

  .categories-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  .chip-label {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 500;
    background-color: var(--color-bg-secondary, #f3f4f6);
    color: var(--color-text-muted, #4b5563);
    cursor: pointer;
    transition: all 0.2s ease;
    border: 1px solid transparent;
  }

  .chip-label:hover {
    background-color: var(--color-border, #e5e7eb);
  }

  .chip-label.active {
    background-color: var(--color-accent);
    color: var(--color-primary);
    border-color: var(--color-primary);
    font-weight: 600;
  }

  .secondary-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .secondary-filters .filter-group {
    flex: 1;
    min-width: 180px;
  }

  .secondary-filters select {
    width: 100%;
    padding: 0.5rem;
    border-radius: 6px;
    background-color: var(--color-bg-secondary, #f9fafb);
    border: 1px solid var(--color-border, #e5e7eb);
    color: var(--color-text, #111827);
    font-size: 0.9rem;
  }
  
  .filter-actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  
  .filter-actions .btn-sm {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
  }

  /* Listado de plantas */
  .plants-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .plant-card {
    background-color: var(--color-card);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .plant-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
  }

  .plant-image {
    aspect-ratio: 16/11;
    overflow: hidden;
  }

  .plant-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .plant-card:hover .plant-image img {
    transform: scale(1.05);
  }

  .plant-content {
    padding: 1.2rem;
  }

  .plant-category {
    display: inline-block;
    background-color: var(--color-accent);
    color: var(--color-primary);
    font-size: 0.8rem;
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    margin-bottom: 0.5rem;
  }

  .plant-title {
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
  }

  .plant-price {
    font-weight: bold;
    font-size: 1.2rem;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .plant-actions {
    display: flex;
    gap: 0.5rem;
  }

  .plant-actions .btn {
    padding: 0.6rem;
    font-size: 0.9rem;
    flex: 1;
  }

  /* Estado vacío */
  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 4rem 2rem;
    background-color: var(--color-card);
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
  }

  .empty-state p {
    margin-bottom: 1rem;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .filters-topbar {
      position: relative;
      top: 0;
    }
    
    .secondary-filters {
      flex-direction: column;
      align-items: stretch;
    }
    
    .filter-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    
    .plant-actions {
      flex-direction: column;
    }
  }
</style>

