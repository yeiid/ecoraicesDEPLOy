---
import { getSessionUser } from '../lib/middleware/auth.js';
import { ViewTransitions } from 'astro:transitions';
import { pwaInfo } from 'virtual:pwa-info';
import { Icon } from 'astro-icon/components';
import ThemeToggle from '../components/ThemeToggle.astro';
import LanguageToggle from '../components/LanguageToggle.astro';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "EcoRaices - Inventario Forestal Colaborativo" } = Astro.props;

// Obtener la ruta actual para marcar el elemento activo en el menú
const pathname = Astro.url.pathname;
const isActive = (path: string) => {
  if (path === "/") {
    return pathname === "/" || pathname === "/index.html";
  }
  return pathname.startsWith(path);
};

// 🔐 Verificar estado de sesión y token
const user = await getSessionUser({ cookies: Astro.cookies });
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="EcoRaíces — Plataforma de ciencia ciudadana para documentar, geolocalizar y proteger la biodiversidad." />
    <meta name="author" content="Yeifran Hernandez — NeuralJIRA" />
    <link rel="icon" type="image/x-icon" href="/icon.ico" />
    <ViewTransitions />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <meta name="theme-color" content="#1a472a" />
    <link rel="apple-touch-icon" href="/pwa-192x192.png" />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    
    <!-- Prevents FOUC for dark mode and lang -->
    <script is:inline>
      if (typeof window.initThemeAndLang === 'undefined') {
        window.initThemeAndLang = function() {
          // Theme
          const theme = (() => {
            if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
              return localStorage.getItem('theme');
            }
            if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
              return 'dark';
            }
            return 'light';
          })();
          if (theme === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
          } else {
            document.documentElement.removeAttribute('data-theme');
          }

          // Language
          const lang = typeof localStorage !== 'undefined' ? localStorage.getItem('lang') : 'es';
          if (lang === 'guc') {
            document.documentElement.setAttribute('data-lang', 'guc');
          } else {
            document.documentElement.removeAttribute('data-lang');
          }
        };
        document.addEventListener('astro:after-swap', window.initThemeAndLang);
      }
      // Run on initial load
      window.initThemeAndLang();
    </script>
  </head>
  <body>
    <div class="app-layout">
      <!-- Header Móvil Premium -->
      <header class="mobile-header">
        <button class="mobile-toggle" id="sidebar-toggle" aria-label="Toggle Sidebar">
          <Icon name="lucide:menu" class="w-6 h-6" />
        </button>
        <div class="mobile-brand">
          <img src="/eco.png" alt="EcoRaíces Logo" class="mobile-brand-logo" />
          <span class="mobile-brand-name">ECORAÍCES</span>
        </div>
        <div class="mobile-header-spacer"></div>
      </header>

      <!-- Overlay para móvil -->
      <div class="sidebar-overlay" id="sidebar-overlay"></div>

      <!-- Sidebar Izquierdo -->
      <aside class="sidebar" id="sidebar">
        <div class="logo-container">
          <a href="/">
            <img src="/eco.png" alt="ECORAICES" class="logo-img" />
          </a>
        </div>

        <!-- Menú de Navegación Stacked -->
        <nav class="sidebar-nav">
          <ul>
            <li>
              <a href="/" class={`nav-item ${isActive("/") ? "active" : ""}`}>
                <Icon name="lucide:home" class="nav-icon" />
                <span class="lang-es">Inicio</span>
                <span class="lang-guc">Antüshi</span>
              </a>
            </li>
            <li>
              <a href="/observaciones" class={`nav-item ${isActive("/observaciones") ? "active" : ""}`}>
                <Icon name="lucide:map" class="nav-icon" />
                <span class="lang-es">Mapa de Especies</span>
                <span class="lang-guc">Mma</span>
              </a>
            </li>
            <li>
              <a href="/plantas" class={`nav-item ${isActive("/plantas") ? "active" : ""}`}>
                <Icon name="lucide:book-open" class="nav-icon" />
                <span class="lang-es">Catálogo</span>
                <span class="lang-guc">Wunu'u</span>
              </a>
            </li>
            <li>
              <a href="/comunidades" class={`nav-item ${isActive("/comunidades") ? "active" : ""}`}>
                <Icon name="lucide:users" class="nav-icon" />
                <span class="lang-es">Comunidades</span>
                <span class="lang-guc">Apüshi</span>
              </a>
            </li>
            {user?.isAdmin && (
              <li>
                <a href="/admin" class={`nav-item ${isActive("/admin") ? "active" : ""}`}>
                  <Icon name="lucide:settings" class="nav-icon" />
                  <span class="lang-es">Panel Admin</span>
                  <span class="lang-guc">Anaa Panel</span>
                </a>
              </li>
            )}
            <li>
              <a href="/nosotros" class={`nav-item ${isActive("/nosotros") ? "active" : ""}`}>
                <Icon name="lucide:info" class="nav-icon" />
                <span class="lang-es">Acerca de</span>
                <span class="lang-guc">Atüja</span>
              </a>
            </li>
            <li>
              <a href="/contacto" class={`nav-item ${isActive("/contacto") ? "active" : ""}`}>
                <Icon name="lucide:help-circle" class="nav-icon" />
                <span class="lang-es">Ayuda</span>
                <span class="lang-guc">Akaaliijaa</span>
              </a>
            </li>
          </ul>
        </nav>

        <!-- Controles, Botón Iniciar Sesión o Widget de Usuario -->
        <div class="sidebar-footer">
          <div class="header-controls" style="display: flex; gap: 0.5rem; justify-content: center; margin-bottom: 1rem;">
            <LanguageToggle />
            <ThemeToggle />
          </div>

          {user ? (
            <div class="user-profile-widget">
              <div class="user-info-row">
                <div class="avatar-circle">
                  {user.avatarUrl ? (
                    <img src={user.avatarUrl} alt={user.name} class="avatar-img" />
                  ) : (
                    <span class="avatar-initial">{user.name ? user.name[0].toUpperCase() : 'U'}</span>
                  )}
                </div>
                <div class="user-details">
                  <span class="user-name">{user.name}</span>
                  <span class="user-role">{user.isAdmin ? 'Administrador' : 'Guardabosques'}</span>
                </div>
              </div>
              <div class="user-actions">
                <a href="/perfil" class="btn-profile">
                  <Icon name="lucide:user" class="profile-icon" />
                  <span class="lang-es">Mi Perfil</span>
                  <span class="lang-guc">Taya</span>
                </a>
                <a href="/auth/logout" class="btn-logout" title="Cerrar Sesión">
                  <Icon name="lucide:log-out" class="logout-icon" />
                  <span class="lang-es">Cerrar Sesión</span>
                  <span class="lang-guc">Ajuittüin</span>
                </a>
              </div>
            </div>
          ) : (
            <a href="/auth/login" class="btn-login">
              <Icon name="lucide:log-in" class="btn-icon" />
              <span class="lang-es">Iniciar Sesión</span>
              <span class="lang-guc">Anta</span>
            </a>
          )}
        </div>
      </aside>

      <!-- Panel de Contenido Principal -->
      <main class="main-container">
        <slot />

        <!-- Footer Global -->
        <footer class="site-footer">
          <div class="footer-inner">
            <div class="footer-brand">
              <img src="/eco.png" alt="EcoRaíces" class="footer-logo" />
              <span>EcoRaíces</span>
            </div>
            <div class="footer-contact">
              <a href="mailto:yeifran67@gmail.com">yeifran67@gmail.com</a>
              <a href="tel:+573058079573">+57 305 807 9573</a>
              <span>Bogotá, Colombia</span>
            </div>
          </div>
          <div class="footer-copy">
            © {new Date().getFullYear()} EcoRaíces · Desarrollado por NeuralJIRA
          </div>
        </footer>
      </main>
    </div>

    <!-- Script para Toggle de Menú Móvil -->
    <script>
      document.addEventListener("astro:page-load", () => {
        const sidebarToggle = document.getElementById("sidebar-toggle");
        const sidebar = document.getElementById("sidebar");
        const overlay = document.getElementById("sidebar-overlay");

        if (sidebarToggle && sidebar && overlay) {
          const toggleSidebar = () => {
            sidebar.classList.toggle("open");
            overlay.classList.toggle("active");
            document.body.classList.toggle("no-scroll");
          };

          sidebarToggle.addEventListener("click", toggleSidebar);
          overlay.addEventListener("click", toggleSidebar);

          // Cerrar si se hace click en algún link del menú (móvil)
          const navLinks = sidebar.querySelectorAll(".nav-item");
          navLinks.forEach((link) => {
            link.addEventListener("click", () => {
              if (sidebar.classList.contains("open")) {
                toggleSidebar();
              }
            });
          });
        }
      });
    </script>
  </body>
</html>

<style is:global>
  /* Reset y base */
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html,
  body {
    font-family: var(--font-body);
    color: var(--color-text-main);
    background-color: var(--color-main-bg);
    min-height: 100vh;
    overflow-x: hidden;
  }

  body.no-scroll {
    overflow: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  /* Estructura del layout */
  .app-layout {
    display: flex;
    min-height: 100vh;
    width: 100vw;
  }

  /* Header Móvil Base */
  .mobile-header {
    display: none;
  }

  /* Toggle Móvil */
  .mobile-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition-smooth);
  }

  .mobile-toggle svg {
    width: 24px;
    height: 24px;
  }

  /* Sidebar Estilos */
  .sidebar {
    width: var(--sidebar-width);
    height: 100dvh;
    background-color: var(--color-sidebar-bg);
    border-right: 1px solid var(--color-border);
    position: fixed;
    top: 0;
    left: 0;
    z-index: 90;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.25rem;
    transition: var(--transition-smooth);
    overflow: hidden;
  }

  .logo-container {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    flex-shrink: 0;
  }

  .logo-img {
    width: 120px;
    height: auto;
    max-height: 120px;
    border-radius: 50%;
    transition: var(--transition-smooth);
  }

  .logo-img:hover {
    transform: scale(1.03);
  }

  .sidebar-nav {
    flex: 1;
    overflow-y: auto;
    min-height: 0;
    padding-right: 0.5rem;
  }

  /* Personalizar scrollbar del nav */
  .sidebar-nav::-webkit-scrollbar {
    width: 4px;
  }
  .sidebar-nav::-webkit-scrollbar-thumb {
    background-color: rgba(156, 163, 175, 0.3);
    border-radius: 4px;
  }

  .sidebar-nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1.25rem;
    color: var(--color-text-muted);
    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 500;
    transition: var(--transition-smooth);
  }

  .nav-icon {
    width: 20px;
    height: 20px;
    color: var(--color-text-muted);
    transition: var(--transition-smooth);
  }

  .nav-item:hover {
    background-color: var(--color-accent);
    color: var(--color-primary);
  }

  .nav-item:hover .nav-icon {
    color: var(--color-primary);
  }

  .nav-item.active {
    background-color: var(--color-accent);
    color: var(--color-primary);
    font-weight: 600;
  }

  .nav-item.active .nav-icon {
    color: var(--color-primary);
  }

  .sidebar-footer {
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    flex-shrink: 0;
    margin-top: 0.5rem;
  }

  .btn-login {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.7rem;
    background-color: var(--color-success);
    color: white;
    border-radius: 25px; /* Súper redondeado tipo pastilla */
    font-weight: 600;
    font-size: 0.95rem;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 10px rgba(16, 185, 129, 0.2);
    transition: var(--transition-smooth);
  }

  .btn-login:hover {
    background-color: #059669;
    transform: translateY(-2px);
    box-shadow: 0 6px 14px rgba(16, 185, 129, 0.3);
  }

  .btn-icon {
    width: 18px;
    height: 18px;
  }

  /* Estilos del widget de perfil de usuario premium */
  .user-profile-widget {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 0.25rem 0;
  }

  .user-info-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .avatar-circle {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background-color: var(--color-accent);
    border: 2px solid var(--color-primary-light);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(27, 94, 32, 0.1);
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .avatar-initial {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-primary);
    font-family: var(--font-heading);
  }

  .user-details {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .user-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .user-role {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .btn-logout {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.65rem;
    background-color: var(--color-danger-bg);
    color: var(--color-danger);
    border-radius: 12px;
    font-size: 0.85rem;
    font-weight: 600;
    transition: var(--transition-smooth);
    border: 1px solid var(--color-danger);
    cursor: pointer;
  }

  .btn-logout:hover {
    background-color: var(--color-danger);
    color: white;
  }

  .logout-icon {
    width: 16px;
    height: 16px;
  }

  .user-actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .btn-profile {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.65rem;
    background-color: var(--color-success-bg);
    color: var(--color-success-dark);
    border-radius: 12px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid var(--color-success);
    transition: var(--transition-smooth);
  }

  .btn-profile:hover {
    background-color: var(--color-success);
    color: white;
  }

  .profile-icon {
    width: 16px;
    height: 16px;
  }

  /* Overlay de Sidebar para móvil */
  .sidebar-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(15, 23, 42, 0.4);
    backdrop-filter: blur(4px);
    z-index: 85;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .sidebar-overlay.active {
    display: block;
    opacity: 1;
    pointer-events: auto;
  }

  /* Main Container */
  .main-container {
    flex-grow: 1;
    margin-left: var(--sidebar-width);
    padding: 2.5rem 3rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    transition: var(--transition-smooth);
    background-color: var(--color-main-bg);
  }

  /* Responsivo para móviles y tabletas */
  @media (max-width: 1024px) {
    .mobile-header {
      display: flex;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 64px;
      background: var(--color-sidebar-bg);
      opacity: 0.95;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--color-border);
      z-index: 100;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.25rem;
      box-shadow: 0 2px 10px rgba(15, 23, 42, 0.02);
    }

    .mobile-toggle {
      display: flex;
      position: relative;
      background-color: var(--color-accent);
      color: var(--color-primary);
      border: none;
      border-radius: 10px;
      width: 42px;
      height: 42px;
      box-shadow: none;
      z-index: 101;
    }

    .mobile-toggle:hover {
      background-color: var(--color-accent-dark);
    }

    .mobile-brand {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      margin: 0 auto;
    }

    .mobile-brand-logo {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      object-fit: cover;
    }

    .mobile-brand-name {
      font-family: var(--font-heading);
      font-size: 1.1rem;
      font-weight: 800;
      color: var(--color-primary);
      letter-spacing: 0.03em;
    }

    .mobile-header-spacer {
      width: 42px; /* Equilibrate space of the toggle button */
    }

    .sidebar {
      transform: translateX(-100%);
      box-shadow: none;
      padding-top: 5rem;
    }

    .sidebar.open {
      transform: translateX(0);
      box-shadow: 10px 0 30px rgba(15, 23, 42, 0.15);
    }

    .logo-container {
      display: none;
    }

    .main-container {
      margin-left: 0;
      padding: 5.5rem 1.5rem 2rem 1.5rem;
    }
  }

  /* Animaciones micro-interacciones */
  button, a {
    outline: none;
  }

  /* Footer Global */
  .site-footer {
    margin-top: 3rem;
    padding: 2rem 1rem 1.25rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-sidebar-bg);
  }

  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-heading);
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: 0.03em;
  }

  .footer-logo {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    object-fit: cover;
  }

  .footer-contact {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    font-size: 0.9rem;
    color: var(--color-text-light);
  }

  .footer-contact a {
    color: var(--color-text-light);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-contact a:hover {
    color: var(--color-success);
  }

  .footer-copy {
    max-width: 1100px;
    margin: 1.5rem auto 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.8rem;
    color: #9ca3af;
    text-align: center;
  }
</style>
